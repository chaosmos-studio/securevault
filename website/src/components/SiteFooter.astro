---
---
<footer class="site-footer">
    <div class="footer-grid">
        <div class="col">
            <h3>SecureVault</h3>
            <p>Privacy is a human right. Protect what matters most with military-grade encryption disguised as everyday tools.</p>
        </div>
        <div class="col">
            <h4>Product</h4>
            <a href="https://play.google.com/store">Android App</a>
            <a href={`${import.meta.env.BASE_URL}/#disguises`.replace(/\/\//g, '/')}>Features</a>
            <a href={`${import.meta.env.BASE_URL}/privacy`.replace(/\/\//g, '/')}>Privacy Policy</a>
        </div>
        <div class="col">
            <h4>Support</h4>
            <a href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}>About Us</a>
            <a href={`${import.meta.env.BASE_URL}/support#contact`.replace(/\/\//g, '/')}>Contact</a>
            <a href={`${import.meta.env.BASE_URL}/support#request`.replace(/\/\//g, '/')}>Request Feature</a>
        </div>
    </div>
    <div class="footer-bottom">
         © 2026 SecureVault Inc. All rights reserved.
    </div>
</footer>

<style>
    .site-footer {
        padding: 4rem 5% 2rem;
        background: var(--bg-surface, rgba(0,0,0,0.2));
        border-top: 1px solid var(--border);
        transition: background 0.3s ease, border-color 0.3s ease;
    }
    .footer-grid { 
        display: flex; gap: 4rem; margin-bottom: 3rem; flex-wrap: wrap;
        max-width: 1400px; margin: 0 auto 3rem auto;
    }
    .col { flex: 1; min-width: 200px; }
    .col h3 { margin: 0 0 1rem 0; font-size: 1.2rem; }
    .col p { color: var(--text-muted); line-height: 1.6; font-size: 0.95rem; }
    .col h4 { 
        margin: 0 0 1.2rem 0; font-size: 0.85rem; color: var(--text-muted); 
        text-transform: uppercase; letter-spacing: 0.05em; 
    }
    .col a { 
        display: block; margin-bottom: 0.8rem; color: var(--text-main); 
        opacity: 0.7; transition: opacity 0.2s; 
        text-decoration: none; /* Removed underline */
    }
    .col a:hover { opacity: 1; }
    
    .footer-bottom { 
        text-align: center; color: var(--text-muted); font-size: 0.9rem; 
        padding-top: 2rem; border-top: 1px solid var(--border);
        max-width: 1400px; margin: 0 auto;
    }
</style>
