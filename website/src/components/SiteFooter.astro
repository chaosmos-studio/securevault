---

---

<footer class="site-footer">
  <div class="footer-grid">
    <div class="col">
      <h3>SecureVault</h3>
      <p>
        Privacy is a human right. Protect what matters most with military-grade
        encryption disguised as everyday tools.
      </p>
    </div>
    <div class="col">
      <h4>Product</h4>
      <a
        href="https://play.google.com/store/apps/details?id=com.shravangoswami.securevault"
        class="app-link"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="google-play-icon"
        >
          <path
            d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.61 3 21.09 3 20.5Z"
          ></path>
          <path d="M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12Z"></path>
          <path
            d="M20.16 10.81C20.5 11.08 20.75 11.53 20.75 12C20.75 12.47 20.5 12.92 20.16 13.19L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81Z"
          ></path>
          <path d="M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"></path>
        </svg>
        Android App
      </a>
      <a href={`${import.meta.env.BASE_URL}/#disguises`.replace(/\/\//g, '/')}
        >Features</a
      >
      <a href={`${import.meta.env.BASE_URL}/privacy`.replace(/\/\//g, '/')}
        >Privacy Policy</a
      >
      <a href={`${import.meta.env.BASE_URL}/terms`.replace(/\/\//g, '/')}
        >Terms of Service</a
      >
    </div>
    <div class="col">
      <h4>Support</h4>
      <a
        href={`${import.meta.env.BASE_URL}/about`.replace(/\/\//g, '/')}
        class="nav-link">About Us</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/developers`.replace(/\/\//g, '/')}
        class="nav-link">Meet the Developers</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}
        class="nav-link">Help Center</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/support#contact`.replace(
          /\/\//g,
          '/'
        )}>Contact</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/support#request`.replace(
          /\/\//g,
          '/'
        )}>Request Feature</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/credits`.replace(/\/\//g, '/')}
        class="nav-link">Credits</a
      >
    </div>
  </div>
  <div class="footer-bottom">© 2026 SecureVault Inc. All rights reserved.</div>
</footer>

<style>
  .site-footer {
    padding: 2rem 5% 1rem;
    background: var(--bg-surface, rgba(0, 0, 0, 0.2));
    border-top: 1px solid var(--border);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }
  @media (min-width: 768px) {
    .site-footer {
      padding: 4rem 5% 2rem;
    }
  }

  .footer-grid {
    display: flex;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    max-width: 1400px;
    margin: 0 auto 3rem auto;
  }
  @media (min-width: 768px) {
    .footer-grid {
      gap: 4rem;
    }
  }
  .col {
    flex: 1;
    min-width: 200px;
  }
  .col h3 {
    margin: 0 0 1rem 0;
    font-size: 1.2rem;
  }
  .col p {
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .col h4 {
    margin: 0 0 1.2rem 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .col a {
    display: block;
    margin-bottom: 0.8rem;
    color: var(--text-main);
    opacity: 0.7;
    transition: opacity 0.2s;
    text-decoration: none;
  }
  .col a:hover {
    opacity: 1;
  }

  .app-link {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
  }

  .google-play-icon {
    flex-shrink: 0;
  }

  .footer-bottom {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    max-width: 1400px;
    margin: 0 auto;
  }
</style>
