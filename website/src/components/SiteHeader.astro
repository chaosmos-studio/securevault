---
import { Shield, Sun, Moon, Menu, X } from "lucide-astro";
---

<nav class="nav glass-panel">
    <a href={`${import.meta.env.BASE_URL}/`.replace(/\/\//g, "/")} class="logo">
        <Shield class="logo-icon" size={24} /> SecureVault
    </a>

    <!-- Desktop Nav -->
    <div class="nav-right desktop-nav">
        <a
            href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, "/")}
            class="nav-link">Blog</a
        >
        <a
            href={`${import.meta.env.BASE_URL}/about`.replace(/\/\//g, "/")}
            class="nav-link">About Us</a
        >
        <a
            href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, "/")}
            class="nav-link">Help Center</a
        >
        <a href="https://play.google.com/store" class="download-link"
            >Get the App</a
        >
        <button
            id="theme-toggle"
            class="theme-btn"
            aria-label="Toggle Dark Mode"
        >
            <Sun class="sun-icon" size={20} />
            <Moon class="moon-icon" size={20} />
        </button>
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="menu-toggle" class="mobile-toggle" aria-label="Toggle Menu">
        <Menu class="menu-icon" size={24} />
        <X class="close-icon" size={24} />
    </button>

    <!-- Mobile Nav Overlay -->
    <div class="mobile-nav" id="mobile-nav">
        <div class="mobile-links">
            <a
                href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, "/")}
                class="mobile-link">Blog</a
            >
            <a
                href={`${import.meta.env.BASE_URL}/about`.replace(/\/\//g, "/")}
                class="mobile-link">About Us</a
            >
            <a
                href={`${import.meta.env.BASE_URL}/support`.replace(
                    /\/\//g,
                    "/",
                )}
                class="mobile-link">Help Center</a
            >
            <a
                href="https://play.google.com/store"
                class="mobile-link highlight">Get the App</a
            >
            <div class="mobile-theme-toggle-wrapper">
                <button
                    id="mobile-theme-toggle"
                    class="theme-btn mobile-theme-btn"
                    aria-label="Toggle Dark Mode"
                >
                    <Sun class="sun-icon" size={20} />
                    <Moon class="moon-icon" size={20} />
                    <span class="theme-text">Switch Theme</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<script>
    const themeBtn = document.getElementById("theme-toggle");
    const mobileThemeBtn = document.getElementById("mobile-theme-toggle");
    const root = document.documentElement;

    function applyTheme(theme: string | null) {
        if (!theme) return;
        root.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);

        // Update all sun/moon icons visibility
        const suns = document.querySelectorAll(".sun-icon");
        const moons = document.querySelectorAll(".moon-icon");

        if (theme === "light") {
            suns.forEach((el) => ((el as HTMLElement).style.display = "block"));
            moons.forEach((el) => ((el as HTMLElement).style.display = "none"));
        } else {
            suns.forEach((el) => ((el as HTMLElement).style.display = "none"));
            moons.forEach(
                (el) => ((el as HTMLElement).style.display = "block"),
            );
        }
    }

    // Init Theme
    const savedTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";
    applyTheme(savedTheme || systemTheme);

    // Event Listeners for Theme
    [themeBtn, mobileThemeBtn].forEach((btn) => {
        btn?.addEventListener("click", () => {
            const currentTheme = root.getAttribute("data-theme");
            applyTheme(currentTheme === "dark" ? "light" : "dark");
        });
    });

    // Mobile Menu Logic
    const menuToggle = document.getElementById("menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const body = document.body;

    menuToggle?.addEventListener("click", () => {
        const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", (!isExpanded).toString());
        menuToggle.classList.toggle("active");
        mobileNav?.classList.toggle("active");
        body.style.overflow = isExpanded ? "" : "hidden"; // Prevent scroll when menu open
    });

    // Close menu on link click
    document.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => {
            menuToggle?.classList.remove("active");
            mobileNav?.classList.remove("active");
            menuToggle?.setAttribute("aria-expanded", "false");
            body.style.overflow = "";
        });
    });

    // Scroll Listener
    const nav = document.querySelector(".nav");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            nav?.classList.add("scrolled");
        } else {
            nav?.classList.remove("scrolled");
        }
    });
</script>

<style>
    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 1rem 5%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: transparent;
        backdrop-filter: none;
        border-bottom: 1px solid transparent;
        z-index: 100;
        transition:
            background 0.3s ease,
            border-color 0.3s ease,
            padding 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    .nav.scrolled {
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        padding: 0.8rem 5%; /* Slight shrink for effect */
    }

    .logo {
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text-main);
        z-index: 102; /* Above mobile menu */
    }
    .logo-icon {
        color: var(--accent);
    }

    /* Desktop Navigation */
    .nav-right {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .nav-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-muted);
        transition: color 0.2s;
        text-decoration: none;
    }
    .nav-link:hover {
        color: var(--text-main);
    }

    .download-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
    }
    .download-link:hover {
        opacity: 0.8;
    }

    .theme-btn {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-main);
        padding: 0.5rem;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        width: 36px;
        height: 36px;
    }
    .theme-btn:hover {
        background: var(--bg-surface-2, rgba(255, 255, 255, 0.1));
    }

    .sun-icon {
        display: none;
    }
    .moon-icon {
        display: block;
    }

    /* Mobile Navigation */
    .mobile-toggle {
        display: none;
        background: transparent;
        border: none;
        color: var(--text-main);
        cursor: pointer;
        z-index: 102;
    }
    .close-icon {
        display: none;
    }
    .mobile-toggle.active .menu-icon {
        display: none;
    }
    .mobile-toggle.active .close-icon {
        display: block;
    }

    .mobile-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        bottom: 0;
        background: var(--bg-main); /* Ensure solid background */
        z-index: 101;
        padding: 6rem 2rem 2rem; /* Added bottom padding */
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        display: flex;
        flex-direction: column;
        overflow-y: auto; /* Allow scrolling on small landscape screens */
    }
    .mobile-nav.active {
        transform: translateX(0);
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        font-size: 1.5rem;
        text-align: center;
    }
    .mobile-link {
        color: var(--text-main);
        font-weight: 600;
        transition: color 0.2s;
    }
    .mobile-link:hover {
        color: var(--accent);
    }
    .mobile-link.highlight {
        color: var(--accent);
    }

    .mobile-theme-toggle-wrapper {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
    }

    .mobile-theme-btn {
        width: auto;
        border-radius: 50px;
        padding: 0.5rem 1.5rem;
        gap: 0.5rem;
    }
    .theme-text {
        font-size: 1rem;
    }

    /* Responsive Breakpoints */
    @media (max-width: 768px) {
        .desktop-nav {
            display: none;
        }
        .mobile-toggle {
            display: block;
        }
    }
</style>
