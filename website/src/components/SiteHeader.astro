---
import { Shield, Sun, Moon } from "lucide-astro";
---

<nav class="nav glass-panel">
    <a href={`${import.meta.env.BASE_URL}/`.replace(/\/\//g, "/")} class="logo">
        <Shield class="logo-icon" size={24} /> SecureVault
    </a>
    <div class="nav-right">
        <a
            href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, "/")}
            class="nav-link">Blog</a
        >
        <a
            href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, "/")}
            class="nav-link">About & Support</a
        >
        <a href="https://play.google.com/store" class="download-link"
            >Get the App</a
        >
        <button
            id="theme-toggle"
            class="theme-btn"
            aria-label="Toggle Dark Mode"
        >
            <Sun class="sun-icon" size={20} />
            <Moon class="moon-icon" size={20} />
        </button>
    </div>
</nav>

<script>
    const themeBtn = document.getElementById("theme-toggle");
    const root = document.documentElement;

    function applyTheme(theme: string | null) {
        if (!theme) return;
        root.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);

        const sun = document.querySelector(".sun-icon");
        const moon = document.querySelector(".moon-icon");

        // Toggle visibility
        if (theme === "light") {
            if (sun) (sun as HTMLElement).style.display = "block";
            if (moon) (moon as HTMLElement).style.display = "none";
        } else {
            if (sun) (sun as HTMLElement).style.display = "none";
            if (moon) (moon as HTMLElement).style.display = "block";
        }
    }

    // Init
    const savedTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";
    applyTheme(savedTheme || systemTheme);

    // Event Listener
    themeBtn?.addEventListener("click", () => {
        const currentTheme = root.getAttribute("data-theme");
        applyTheme(currentTheme === "dark" ? "light" : "dark");
    });

    // Scroll Listener
    const nav = document.querySelector(".nav");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            nav?.classList.add("scrolled");
        } else {
            nav?.classList.remove("scrolled");
        }
    });
</script>

<style>
    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 1rem 5%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: transparent;
        backdrop-filter: none;
        border-bottom: 1px solid transparent;
        z-index: 100;
        transition:
            background 0.3s ease,
            border-color 0.3s ease,
            padding 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    .nav.scrolled {
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        padding: 0.8rem 5%; /* Slight shrink for effect */
    }

    .logo {
        font-weight: 700;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text-main);
    }
    .logo-icon {
        color: var(--accent);
    }

    .nav-right {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .nav-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-muted);
        transition: color 0.2s;
        text-decoration: none;
    }
    .nav-link:hover {
        color: var(--text-main);
    }

    .download-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
    }
    .download-link:hover {
        opacity: 0.8;
    }

    .theme-btn {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-main);
        padding: 0.5rem;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        width: 36px;
        height: 36px;
    }
    .theme-btn:hover {
        background: var(--bg-surface-2, rgba(255, 255, 255, 0.1));
    }

    .sun-icon {
        display: none;
    }
    .moon-icon {
        display: block;
    }
</style>
