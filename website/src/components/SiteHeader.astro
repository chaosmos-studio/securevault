---
import { Shield, Sun, Moon, Menu, X } from '@lucide/astro';
---

<nav class="nav glass-panel">
  <a href={`${import.meta.env.BASE_URL}/`.replace(/\/\//g, '/')} class="logo">
    <Shield class="logo-icon" size={24} /> SecureVault
  </a>

  <div class="nav-right desktop-nav">
    <a
      href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}
      class="nav-link">Blog</a
    >
    <a
      href={`${import.meta.env.BASE_URL}/about`.replace(/\/\//g, '/')}
      class="nav-link">About Us</a
    >
    <a
      href={`${import.meta.env.BASE_URL}/developers`.replace(/\/\//g, '/')}
      class="nav-link">Developers</a
    >
    <a
      href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}
      class="nav-link">Help Center</a
    >
    <a href="https://play.google.com/store" class="download-link">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="google-play-icon"
      >
        <path
          d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.61 3 21.09 3 20.5Z"
        ></path>
        <path d="M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12Z"></path>
        <path
          d="M20.16 10.81C20.5 11.08 20.75 11.53 20.75 12C20.75 12.47 20.5 12.92 20.16 13.19L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81Z"
        ></path>
        <path d="M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"></path>
      </svg>
      Get the App
    </a>
    <button id="theme-toggle" class="theme-btn" aria-label="Toggle Dark Mode">
      <Sun class="sun-icon" size={20} />
      <Moon class="moon-icon" size={20} />
    </button>
  </div>

  <button id="menu-toggle" class="mobile-toggle" aria-label="Toggle Menu">
    <Menu class="menu-icon" size={24} />
    <X class="close-icon" size={24} />
  </button>

  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-links">
      <a
        href={`${import.meta.env.BASE_URL}/blog`.replace(/\/\//g, '/')}
        class="mobile-link">Blog</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/about`.replace(/\/\//g, '/')}
        class="mobile-link">About Us</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/developers`.replace(/\/\//g, '/')}
        class="mobile-link">Developers</a
      >
      <a
        href={`${import.meta.env.BASE_URL}/support`.replace(/\/\//g, '/')}
        class="mobile-link">Help Center</a
      >
      <a href="https://play.google.com/store" class="mobile-link highlight">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="google-play-icon"
        >
          <path
            d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.61 3 21.09 3 20.5Z"
          ></path>
          <path d="M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12Z"></path>
          <path
            d="M20.16 10.81C20.5 11.08 20.75 11.53 20.75 12C20.75 12.47 20.5 12.92 20.16 13.19L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81Z"
          ></path>
          <path d="M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"></path>
        </svg>
        Get the App
      </a>
      <div class="mobile-theme-toggle-wrapper">
        <button
          id="mobile-theme-toggle"
          class="theme-btn mobile-theme-btn"
          aria-label="Toggle Dark Mode"
        >
          <Sun class="sun-icon" size={20} />
          <Moon class="moon-icon" size={20} />
          <span class="theme-text">Switch Theme</span>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  const buttons = document.querySelectorAll('.theme-btn');
  const root = document.documentElement;

  function setTheme(theme: string) {
    root.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }

  const savedTheme = localStorage.getItem('theme');
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
    ? 'dark'
    : 'light';

  setTheme(savedTheme || systemTheme);

  buttons.forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const currentTheme = root.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      setTheme(newTheme);
    });
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const body = document.body;

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    menuToggle.classList.toggle('active');
    mobileNav?.classList.toggle('active');
    body.style.overflow = isExpanded ? '' : 'hidden';
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menuToggle?.classList.remove('active');
      mobileNav?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
      body.style.overflow = '';
    });
  });

  const nav = document.querySelector('.nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 1rem 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 1px solid transparent;
    z-index: 100;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      padding 0.3s ease,
      backdrop-filter 0.3s ease;
  }

  .nav.scrolled {
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0.8rem 5%;
  }

  .logo {
    font-weight: 700;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-main);
    z-index: 102;
  }
  .logo-icon {
    color: var(--accent);
  }

  .nav-right {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s;
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--text-main);
  }

  .download-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .download-link:hover {
    opacity: 0.8;
  }

  .google-play-icon {
    flex-shrink: 0;
  }

  .theme-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 0.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    width: 36px;
    height: 36px;
  }
  .theme-btn:hover {
    background: var(--bg-surface-2, rgba(255, 255, 255, 0.1));
  }

  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  :global(html[data-theme='light']) .sun-icon {
    display: none;
  }
  :global(html[data-theme='light']) .moon-icon {
    display: block;
  }

  :global(html[data-theme='dark']) .sun-icon {
    display: block;
  }
  :global(html[data-theme='dark']) .moon-icon {
    display: none;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text-main);
    cursor: pointer;
    z-index: 102;
  }
  .close-icon {
    display: none;
  }
  .mobile-toggle.active .menu-icon {
    display: none;
  }
  .mobile-toggle.active .close-icon {
    display: block;
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    bottom: 0;
    background: var(--bg-main);
    z-index: 101;
    padding: 6rem 2rem 2rem;
    transform: translateX(100%);
    transition: transform 0.3s ease-in-out;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .mobile-nav.active {
    transform: translateX(0);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    font-size: 1.5rem;
    text-align: center;
  }
  .mobile-link {
    color: var(--text-main);
    font-weight: 600;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .mobile-link:hover {
    color: var(--accent);
  }
  .mobile-link.highlight {
    color: var(--accent);
  }

  .mobile-theme-toggle-wrapper {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
  }

  .mobile-theme-btn {
    width: auto;
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    gap: 0.5rem;
  }
  .theme-text {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>
