---
import type { MarkdownHeading } from 'astro';
import {
  ChevronRight,
  AlignLeft,
  ChevronDown,
  ChevronLeft,
} from '@lucide/astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter(h => h.depth <= 3);
---

<div class="toc-container">
  <button class="toc-toggle" aria-label="Toggle Table of Contents">
    <ChevronLeft size={20} class="toc-icon" />
  </button>

  <nav class="toc" id="toc-nav">
    <button class="toc-header" id="desktop-toc-toggle">
      <h3>On This Page</h3>
      <ChevronDown size={18} class="header-icon" />
    </button>
    <div class="toc-content">
      <ul class="toc-list">
        {
          filteredHeadings.map(heading => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="toc-backdrop"></div>
</div>

<script>
  // Active state highlighting for TOC
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        if (entry.intersectionRatio > 0) {
          document
            .querySelector(`.toc-list li a[href="#${id}"]`)
            ?.parentElement?.classList.add('active');
        } else {
          document
            .querySelector(`.toc-list li a[href="#${id}"]`)
            ?.parentElement?.classList.remove('active');
        }
      });
    },
    { rootMargin: '-100px 0px -66%' }
  );

  document.querySelectorAll('h2, h3').forEach(section => {
    observer.observe(section);
  });

  // Mobile Drawer Logic
  const toggleBtn = document.querySelector('.toc-toggle');
  const tocContainer = document.querySelector('.toc-container');
  const tocBackdrop = document.querySelector('.toc-backdrop');
  const tocLinks = document.querySelectorAll('.toc-item a');

  function toggleToc() {
    tocContainer?.classList.toggle('open');
  }

  toggleBtn?.addEventListener('click', toggleToc);
  tocBackdrop?.addEventListener('click', toggleToc);

  // Close drawer when a link is clicked (Mobile)
  // Close collapsible when link clicked (Desktop) - Optional, maybe keep open?
  tocLinks.forEach(link => {
    link.addEventListener('click', () => {
      // Only close on mobile
      if (window.innerWidth < 1024) {
        tocContainer?.classList.remove('open');
      }
    });
  });

  // Desktop Collapsible Logic
  const desktopHeader = document.getElementById('desktop-toc-toggle');
  const tocNav = document.getElementById('toc-nav');

  desktopHeader?.addEventListener('click', () => {
    tocNav?.classList.toggle('collapsed');
  });
</script>

<style>
  .toc {
    position: sticky;
    top: 8rem;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    max-height: calc(100vh - 10rem);
    width: 100%;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  /* Collapsed state for desktop */
  .toc.collapsed .toc-content {
    display: none;
  }
  .toc.collapsed {
    padding-bottom: 0.5rem; /* Less padding when collapsed */
  }
  .toc.collapsed .header-icon {
    transform: rotate(-90deg);
  }

  .toc-toggle {
    display: none;
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-right: none;
    padding: 0.8rem 0.4rem;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    z-index: 99;
    cursor: pointer;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .toc-toggle:hover {
    color: var(--text-main);
    background: var(--bg-surface-2);
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .toc.collapsed .toc-header {
    margin-bottom: 0.5rem;
  }

  .toc-header h3 {
    font-size: 1.1rem;
    margin: 0;
    color: inherit;
    font-weight: 700;
  }

  .header-icon {
    transition: transform 0.3s ease;
  }

  .toc-content {
    overflow-y: auto;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc-item a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s;
    display: block;
    line-height: 1.4;
  }

  .toc-item a:hover {
    color: var(--accent);
  }

  .toc-item.active a {
    color: var(--accent);
    font-weight: 500;
  }

  .depth-2 {
    padding-left: 0;
  }

  .depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  /* Scrollbar styling */
  .toc::-webkit-scrollbar {
    width: 4px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  .toc-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 90;
    opacity: 0;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(2px);
  }

  @media (max-width: 1024px) {
    .toc-container {
      position: relative;
    }

    .toc-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .toc-icon {
      transition: transform 0.3s ease;
    }

    .toc-container.open .toc-icon {
      transform: rotate(180deg);
    }

    .toc {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 280px;
      max-height: 100vh;
      border-radius: 0;
      z-index: 100;
      margin: 0;
      transform: translateX(100%);
      box-shadow: -5px 0 30px rgba(0, 0, 0, 0.2);
    }

    .toc-container.open .toc {
      transform: translateX(0);
    }

    .toc-container.open .toc-backdrop {
      display: block;
      opacity: 1;
    }

    .toc-container.open .toc-toggle {
      right: 280px; /* Move chevron with drawer */
    }
  }
</style>
