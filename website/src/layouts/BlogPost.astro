---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Giscus from '../components/Giscus.astro';

import type { MarkdownHeading } from 'astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  authors,
  headings,
} = Astro.props;
---

<Layout title={`${title} - SecureVault Blog`}>
  <div class="premium-container" id="main-container">
    <SiteHeader />

    <main>
      <article class="blog-article skew-monitor-effect">
        <div class="hero-section">
          {
            heroImage && (
              <div class="hero-image-wrapper">
                <Image
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt=""
                  class="hero-image"
                />
                <div class="hero-overlay" />
              </div>
            )
          }
          <div class="hero-content">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Updated: <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1 class="headline">{title}</h1>
            {
              authors && authors.length > 0 && (
                <div class="authors-section">
                  <span class="authors-label">Written by</span>
                  <div class="authors-list">
                    {authors.map((authorId: string) => (
                      <AuthorCard authorId={authorId} />
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </div>

        <div class="content-container">
          <div class="prose">
            <slot />
            <Giscus />
          </div>

          {
            headings && headings.length > 0 && (
              <aside class="sidebar">
                <TableOfContents headings={headings} />
              </aside>
            )
          }
        </div>
      </article>
    </main>

    <BackToTop />
    <SiteFooter />
  </div>
</Layout>

<style>
  main {
    padding: 8rem 5% 4rem;
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 2;
    position: relative;
  }

  .blog-article {
    width: 100%;
    max-width: 1200px; /* Increased from 800px */
    background: transparent;
    position: relative;
    padding-bottom: 3rem;
  }

  /* ... existing styles ... */
  [data-theme='light'] .blog-article {
  }

  .hero-section {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    border-radius: 20px;
    background: var(--bg-main);
  }

  /* Content Grid Layout */
  .content-container {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 5rem;
    margin-top: 2rem;
    max-width: 1100px;
    margin: 2rem auto 0;
  }

  .prose {
    padding: 0; /* Remove internal padding as grid handles spacing */
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    min-width: 0; /* Prevent grid overflow */
  }

  .sidebar {
    height: 100%; /* Ensure it takes full height of grid track */
  }

  [data-theme='light'] .hero-section {
    box-shadow: none;
    background: transparent;
  }
  .hero-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 2/1;
    overflow: hidden;
    background: var(--bg-surface-2);
    border-radius: 20px 20px 0 0;
  }
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      var(--bg-main) 100%
    );
    pointer-events: none;
    z-index: 2;
  }
  [data-theme='light'] .hero-overlay {
    background: linear-gradient(to bottom, transparent 30%, var(--bg-main) 95%);
  }

  .hero-content {
    padding: 0 0 2rem;
    margin-top: -3rem;
    position: relative;
    z-index: 10;
    text-align: left;
  }

  h1.headline {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 0;
  }

  .authors-section {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .authors-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .authors-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .date {
    display: inline-flex;
    gap: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.85rem;
    background: var(--bg-surface);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
  }
  .last-updated-on {
    color: var(--text-muted);
    font-weight: 400;
  }

  /* Prose Styles */
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }
  .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .prose :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(strong) {
    color: var(--text-main);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    color: var(--text-muted);
    margin: 1.5rem 0;
    font-style: italic;
  }
  .prose :global(img) {
    border-radius: 12px;
    margin: 1.5rem 0;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      grid-row: 1; /* Move TOC above content on mobile */
      position: static;
      margin-bottom: 1rem;
    }

    .blog-article {
      border-radius: 0;
    }
    main {
      padding: 6rem 0 2rem;
    }
    /* Prose padding moved from .prose to main container in grid layout or global padding */
    .content-container {
      padding: 0 1.5rem;
    }
    .hero-content {
      padding: 1.5rem;
    }
    .hero-image-wrapper {
      aspect-ratio: 16/9;
    }
  }
</style>
