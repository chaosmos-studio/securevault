---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<Layout title={`${title} - SecureVault Blog`}>
    <div class="premium-container" id="main-container">
        <div class="spotlight-overlay"></div>
        
        <SiteHeader />

        <main>
            <article class="blog-article skew-monitor-effect">
                <div class="hero-section">
                    {heroImage && (
                        <div class="hero-image-wrapper">
                            <Image width={1020} height={510} src={heroImage} alt="" class="hero-image" />
                            <div class="hero-overlay"></div>
                        </div>
                    )}
                    <div class="hero-content">
                        <div class="date">
                            <FormattedDate date={pubDate} />
                            {updatedDate && <div class="last-updated-on">Updated: <FormattedDate date={updatedDate} /></div>}
                        </div>
                        <h1 class="headline">{title}</h1>
                    </div>
                </div>

                <div class="prose">
                    <slot />
                </div>
            </article>
        </main>

        <SiteFooter />
    </div>
</Layout>

<script>
    // Spotlight Logic - consistent throughout site
    const wrapper = document.getElementById('main-container');
    if(wrapper) {
        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);
        });
    }
</script>

<style>
    main { 
        padding: 8rem 5% 4rem; 
        width: 100%; 
        display: flex; 
        justify-content: center; 
        z-index: 2; 
        position: relative; 
    }

    .blog-article {
        width: 100%; 
        max-width: 800px;
        background: var(--bg-surface);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
    }

    .hero-section { position: relative; width: 100%; }
    .hero-image-wrapper { 
        position: relative; 
        width: 100%; 
        aspect-ratio: 2/1; 
        overflow: hidden; 
        background: var(--bg-surface-2);
    }
    .hero-image { width: 100%; height: 100%; object-fit: cover; }
    .hero-overlay { 
        position: absolute; 
        inset: 0; 
        background: linear-gradient(to bottom, transparent 30%, var(--bg-main) 100%); 
    }
    
    .hero-content { 
        padding: 0 2.5rem 2rem; 
        margin-top: -3rem; 
        position: relative; 
        z-index: 10; 
        text-align: center; 
    }

    h1.headline { 
        font-size: clamp(1.8rem, 4vw, 2.5rem); 
        line-height: 1.2; 
        margin: 0;
    }
    
    .date { 
        display: inline-flex; 
        gap: 0.75rem; 
        color: var(--accent); 
        font-weight: 600; 
        font-size: 0.85rem;
        background: var(--bg-surface); 
        padding: 0.4rem 1rem; 
        border-radius: 50px; 
        margin-bottom: 1rem; 
        border: 1px solid var(--border);
    }
    .last-updated-on { color: var(--text-muted); font-weight: 400; }

    .prose {
        padding: 2.5rem;
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--text-muted);
    }
    .prose :global(h2) { font-size: 1.5rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--text-main); }
    .prose :global(h3) { font-size: 1.2rem; margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--text-main); }
    .prose :global(p) { margin-bottom: 1.25rem; }
    .prose :global(ul) { margin-bottom: 1.25rem; padding-left: 1.25rem; }
    .prose :global(li) { margin-bottom: 0.4rem; }
    .prose :global(strong) { color: var(--text-main); }
    .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
    .prose :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 1.25rem; color: var(--text-muted); margin: 1.5rem 0; font-style: italic; }
    .prose :global(img) { border-radius: 12px; margin: 1.5rem 0; width: 100%; }

    @media (max-width: 768px) {
        .blog-article { border-radius: 0; }
        main { padding: 6rem 0 2rem; }
        .prose, .hero-content { padding: 1.5rem; }
        .hero-image-wrapper { aspect-ratio: 16/9; }
    }
</style>
    }
</style>

