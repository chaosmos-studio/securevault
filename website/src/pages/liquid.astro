---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Liquid Metal Security">
	<div class="liquid-container">
		<canvas id="liquidCanvas"></canvas>
		
		<div class="content">
			<div class="hero-section">
				<div class="liquid-logo">
					<div class="metal-sphere"></div>
				</div>
				
				<h1 class="liquid-title">SecureVault</h1>
				<p class="subtitle">Fluid. Adaptive. Unbreakable.</p>
				
				<a href="https://play.google.com/store" class="liquid-download" target="_blank" rel="noopener noreferrer">
					<span class="ripple"></span>
					<span class="ripple"></span>
					<span class="ripple"></span>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
					</svg>
					Download on Google Play
				</a>
				
				<div class="device-info">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z"/>
					</svg>
					Android 8.0 or higher
				</div>
			</div>

			<section class="features-section">
				<div class="feature-flow">
					<div class="flow-item">
						<div class="flow-number">01</div>
						<div class="flow-content">
							<h3>Military-Grade Encryption</h3>
							<p>AES-256-CBC encryption with PBKDF2 key derivation keeps your data impenetrable</p>
							<div class="flow-icon">🔐</div>
						</div>
					</div>
					
					<div class="flow-divider"></div>
					
					<div class="flow-item">
						<div class="flow-number">02</div>
						<div class="flow-content">
							<h3>Chameleon Technology</h3>
							<p>Transform into Calculator, Notes, Clock, or Weather app instantly</p>
							<div class="flow-icon">🎭</div>
						</div>
					</div>
					
					<div class="flow-divider"></div>
					
					<div class="flow-item">
						<div class="flow-number">03</div>
						<div class="flow-content">
							<h3>Multi-Vault Architecture</h3>
							<p>Unlimited secure vaults with individual passwords for ultimate organization</p>
							<div class="flow-icon">🗂️</div>
						</div>
					</div>
					
					<div class="flow-divider"></div>
					
					<div class="flow-item">
						<div class="flow-number">04</div>
						<div class="flow-content">
							<h3>Zero Digital Footprint</h3>
							<p>Completely offline with screenshot protection and no analytics tracking</p>
							<div class="flow-icon">✈️</div>
						</div>
					</div>
				</div>
			</section>

			<section class="morphing-disguises">
				<h2 class="morph-title">Shape-Shifting Disguises</h2>
				
				<div class="morph-grid">
					<div class="morph-card">
						<div class="card-inner">
							<div class="card-front">
								<div class="morph-icon-container">
									<span class="morph-icon">🧮</span>
								</div>
								<h3>Calculator</h3>
								<p>Fully functional calculator app</p>
							</div>
							<div class="card-back">
								<h4>Access Method</h4>
								<div class="access-method">
									Type <code>123456=</code>
								</div>
								<p class="method-desc">Works like a real calculator until you enter the secret code</p>
							</div>
						</div>
					</div>
					
					<div class="morph-card">
						<div class="card-inner">
							<div class="card-front">
								<div class="morph-icon-container">
									<span class="morph-icon">📝</span>
								</div>
								<h3>Notes</h3>
								<p>Simple note-taking interface</p>
							</div>
							<div class="card-back">
								<h4>Access Method</h4>
								<div class="access-method">
									Long press <code>+ button</code>
								</div>
								<p class="method-desc">Hidden gesture unlocks your secure vault</p>
							</div>
						</div>
					</div>
					
					<div class="morph-card">
						<div class="card-inner">
							<div class="card-front">
								<div class="morph-icon-container">
									<span class="morph-icon">⏰</span>
								</div>
								<h3>Clock</h3>
								<p>Working clock and timer</p>
							</div>
							<div class="card-back">
								<h4>Access Method</h4>
								<div class="access-method">
									Tap <code>12:34:56</code>
								</div>
								<p class="method-desc">Secret time sequence reveals vault</p>
							</div>
						</div>
					</div>
					
					<div class="morph-card">
						<div class="card-inner">
							<div class="card-front">
								<div class="morph-icon-container">
									<span class="morph-icon">🌤️</span>
								</div>
								<h3>Weather</h3>
								<p>Live weather forecasts</p>
							</div>
							<div class="card-back">
								<h4>Access Method</h4>
								<div class="access-method">
									Pull down <code>5 times</code>
								</div>
								<p class="method-desc">Refresh gesture opens secret vault</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="security-metrics">
				<h2 class="metrics-title">Uncompromising Security</h2>
				
				<div class="metrics-container">
					<div class="metric">
						<div class="metric-value" data-target="256">0</div>
						<div class="metric-unit">-bit</div>
						<div class="metric-label">AES Encryption</div>
					</div>
					
					<div class="metric-divider"></div>
					
					<div class="metric">
						<div class="metric-value" data-target="100">0</div>
						<div class="metric-unit">%</div>
						<div class="metric-label">Offline Protection</div>
					</div>
					
					<div class="metric-divider"></div>
					
					<div class="metric">
						<div class="metric-value" data-target="0">0</div>
						<div class="metric-unit"></div>
						<div class="metric-label">Data Collection</div>
					</div>
					
					<div class="metric-divider"></div>
					
					<div class="metric">
						<div class="metric-value" data-target="4">0</div>
						<div class="metric-unit"></div>
						<div class="metric-label">Perfect Disguises</div>
					</div>
				</div>
			</section>

			<div class="final-cta">
				<div class="cta-content">
					<h2>Your Privacy Deserves The Best</h2>
					<p>Join thousands protecting their digital life with SecureVault</p>
					<a href="https://play.google.com/store" class="cta-btn" target="_blank" rel="noopener noreferrer">
						Get Started Now
					</a>
				</div>
			</div>
		</div>
	</div>

	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		.liquid-container {
			min-height: 100vh;
			background: #0a0a0a;
			position: relative;
			overflow-x: hidden;
			color: #fff;
		}

		#liquidCanvas {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: 1;
		}

		.content {
			position: relative;
			z-index: 2;
			padding: 2rem;
			max-width: 1400px;
			margin: 0 auto;
		}

		.hero-section {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
			padding: 4rem 2rem;
		}

		.liquid-logo {
			width: 200px;
			height: 200px;
			margin-bottom: 3rem;
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.metal-sphere {
			width: 150px;
			height: 150px;
			border-radius: 50%;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
			position: relative;
			overflow: hidden;
		}

		.metal-sphere::before {
			content: '🛡️';
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			font-size: 5rem;
			filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.5));
		}

		.liquid-title {
			font-size: clamp(3.5rem, 12vw, 8rem);
			font-weight: 900;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
			background-size: 200% 200%;
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			margin-bottom: 1rem;
			letter-spacing: -2px;
		}

		.subtitle {
			font-size: clamp(1.2rem, 3vw, 2rem);
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 3rem;
			letter-spacing: 5px;
			text-transform: uppercase;
		}

		.liquid-download {
			position: relative;
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			padding: 1.5rem 3rem;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			text-decoration: none;
			border-radius: 50px;
			font-size: 1.1rem;
			font-weight: 700;
			overflow: hidden;
			margin-bottom: 1.5rem;
			box-shadow: 0 15px 50px rgba(102, 126, 234, 0.4);
			transition: all 0.3s ease;
		}

		.liquid-download:hover {
			transform: translateY(-3px);
			box-shadow: 0 20px 60px rgba(102, 126, 234, 0.6);
		}

		.ripple {
			position: absolute;
			width: 100%;
			height: 100%;
			border-radius: 50px;
			background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent);
			opacity: 0;
			pointer-events: none;
		}

		.device-info {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			color: rgba(255, 255, 255, 0.5);
			font-size: 0.95rem;
		}

		.features-section {
			padding: 8rem 0;
			opacity: 0;
		}

		.feature-flow {
			max-width: 900px;
			margin: 0 auto;
		}

		.flow-item {
			display: grid;
			grid-template-columns: 80px 1fr;
			gap: 2rem;
			align-items: center;
			padding: 2rem;
			background: rgba(255, 255, 255, 0.02);
			border-left: 3px solid transparent;
			transition: all 0.3s ease;
		}

		.flow-item:hover {
			background: rgba(102, 126, 234, 0.05);
			border-left-color: #667eea;
			transform: translateX(10px);
		}

		.flow-number {
			font-size: 3rem;
			font-weight: 900;
			background: linear-gradient(135deg, #667eea, #f093fb);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			opacity: 0.5;
		}

		.flow-content {
			position: relative;
		}

		.flow-content h3 {
			font-size: 1.8rem;
			color: #667eea;
			margin-bottom: 0.5rem;
		}

		.flow-content p {
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.6;
		}

		.flow-icon {
			position: absolute;
			top: 0;
			right: 0;
			font-size: 4rem;
			opacity: 0.1;
		}

		.flow-divider {
			height: 40px;
			width: 3px;
			background: linear-gradient(180deg, #667eea, transparent);
			margin-left: 40px;
		}

		.morphing-disguises {
			padding: 8rem 0;
			opacity: 0;
		}

		.morph-title {
			font-size: clamp(2.5rem, 6vw, 4rem);
			text-align: center;
			margin-bottom: 4rem;
			background: linear-gradient(135deg, #667eea, #f093fb);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.morph-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}

		.morph-card {
			height: 350px;
			perspective: 1000px;
		}

		.card-inner {
			position: relative;
			width: 100%;
			height: 100%;
			transition: transform 0.8s;
			transform-style: preserve-3d;
		}

		.morph-card:hover .card-inner {
			transform: rotateY(180deg);
		}

		.card-front,
		.card-back {
			position: absolute;
			width: 100%;
			height: 100%;
			backface-visibility: hidden;
			border-radius: 20px;
			padding: 2.5rem;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			text-align: center;
		}

		.card-front {
			background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
			border: 1px solid rgba(102, 126, 234, 0.3);
		}

		.card-back {
			background: linear-gradient(135deg, rgba(118, 75, 162, 0.2), rgba(240, 147, 251, 0.2));
			border: 1px solid rgba(240, 147, 251, 0.3);
			transform: rotateY(180deg);
		}

		.morph-icon-container {
			width: 120px;
			height: 120px;
			margin-bottom: 1.5rem;
			display: flex;
			align-items: center;
			justify-content: center;
			background: radial-gradient(circle, rgba(102, 126, 234, 0.2), transparent);
			border-radius: 50%;
		}

		.morph-icon {
			font-size: 5rem;
		}

		.card-front h3 {
			font-size: 2rem;
			color: #667eea;
			margin-bottom: 0.5rem;
		}

		.card-front p {
			color: rgba(255, 255, 255, 0.6);
		}

		.card-back h4 {
			font-size: 1.3rem;
			color: #f093fb;
			margin-bottom: 1.5rem;
		}

		.access-method {
			background: rgba(0, 0, 0, 0.3);
			padding: 1rem 1.5rem;
			border-radius: 10px;
			margin-bottom: 1rem;
			font-size: 1.1rem;
		}

		.access-method code {
			color: #667eea;
			font-family: 'Courier New', monospace;
			font-weight: 700;
		}

		.method-desc {
			color: rgba(255, 255, 255, 0.7);
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.security-metrics {
			padding: 8rem 0;
			opacity: 0;
		}

		.metrics-title {
			font-size: clamp(2.5rem, 6vw, 4rem);
			text-align: center;
			margin-bottom: 4rem;
			background: linear-gradient(135deg, #667eea, #f093fb);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.metrics-container {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 3rem;
			flex-wrap: wrap;
		}

		.metric {
			text-align: center;
		}

		.metric-value {
			font-size: 5rem;
			font-weight: 900;
			background: linear-gradient(135deg, #667eea, #f093fb);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			line-height: 1;
		}

		.metric-unit {
			font-size: 2rem;
			color: #667eea;
			margin-bottom: 0.5rem;
		}

		.metric-label {
			color: rgba(255, 255, 255, 0.6);
			font-size: 1rem;
			text-transform: uppercase;
			letter-spacing: 2px;
		}

		.metric-divider {
			width: 2px;
			height: 80px;
			background: linear-gradient(180deg, transparent, #667eea, transparent);
		}

		.final-cta {
			padding: 8rem 2rem;
			text-align: center;
		}

		.cta-content h2 {
			font-size: clamp(2.5rem, 6vw, 4.5rem);
			margin-bottom: 1rem;
			background: linear-gradient(135deg, #667eea, #f093fb);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.cta-content p {
			font-size: 1.3rem;
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 2.5rem;
		}

		.cta-btn {
			display: inline-block;
			padding: 1.5rem 4rem;
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
			text-decoration: none;
			border-radius: 50px;
			font-size: 1.3rem;
			font-weight: 700;
			box-shadow: 0 20px 60px rgba(102, 126, 234, 0.4);
			transition: all 0.3s ease;
		}

		.cta-btn:hover {
			transform: translateY(-5px);
			box-shadow: 0 25px 70px rgba(102, 126, 234, 0.6);
		}

		@media (max-width: 768px) {
			.flow-item {
				grid-template-columns: 1fr;
				gap: 1rem;
			}
			
			.flow-number {
				text-align: center;
			}
			
			.metrics-container {
				flex-direction: column;
				gap: 2rem;
			}
			
			.metric-divider {
				width: 80px;
				height: 2px;
				background: linear-gradient(90deg, transparent, #667eea, transparent);
			}
		}
	</style>

	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollTrigger);

		// Three.js Liquid Metal Setup
		const canvas = document.getElementById('liquidCanvas') as HTMLCanvasElement;
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		camera.position.z = 8;

		// Create liquid metal blob
		const blobGeometry = new THREE.SphereGeometry(2, 64, 64);
		const blobMaterial = new THREE.MeshStandardMaterial({
			color: 0x667eea,
			metalness: 0.9,
			roughness: 0.1,
			envMapIntensity: 1
		});
		const blob = new THREE.Mesh(blobGeometry, blobMaterial);
		scene.add(blob);

		// Add lights for metallic effect
		const light1 = new THREE.PointLight(0x667eea, 2, 100);
		light1.position.set(5, 5, 5);
		scene.add(light1);

		const light2 = new THREE.PointLight(0xf093fb, 2, 100);
		light2.position.set(-5, -5, 5);
		scene.add(light2);

		const ambientLight = new THREE.AmbientLight(0x404040, 0.5);
		scene.add(ambientLight);

		// Floating particles
		const particlesGeometry = new THREE.BufferGeometry();
		const particlesCount = 500;
		const positions = new Float32Array(particlesCount * 3);
		const colors = new Float32Array(particlesCount * 3);
		
		for (let i = 0; i < particlesCount * 3; i += 3) {
			positions[i] = (Math.random() - 0.5) * 20;
			positions[i + 1] = (Math.random() - 0.5) * 20;
			positions[i + 2] = (Math.random() - 0.5) * 20;
			
			const color = new THREE.Color();
			color.setHSL(Math.random() * 0.3 + 0.6, 0.7, 0.6);
			colors[i] = color.r;
			colors[i + 1] = color.g;
			colors[i + 2] = color.b;
		}
		
		particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
		particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
		
		const particlesMaterial = new THREE.PointsMaterial({
			size: 0.05,
			vertexColors: true,
			transparent: true,
			opacity: 0.6,
			blending: THREE.AdditiveBlending
		});
		
		const particles = new THREE.Points(particlesGeometry, particlesMaterial);
		scene.add(particles);

		// GSAP Animations
		// Gradient animation
		gsap.to('.liquid-title', {
			backgroundPosition: '200% center',
			duration: 5,
			ease: 'none',
			repeat: -1
		});

		// Metal sphere pulse
		gsap.to('.metal-sphere', {
			scale: 1.1,
			duration: 2,
			ease: 'power1.inOut',
			repeat: -1,
			yoyo: true
		});

		// Ripple effect
		gsap.to('.ripple', {
			scale: 1.5,
			opacity: 0,
			duration: 2,
			stagger: 0.5,
			repeat: -1,
			ease: 'power2.out'
		});

		// Scroll animations
		gsap.to('.features-section', {
			scrollTrigger: {
				trigger: '.features-section',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.flow-item', {
			scrollTrigger: {
				trigger: '.feature-flow',
				start: 'top 70%'
			},
			x: -100,
			opacity: 0,
			duration: 0.8,
			stagger: 0.2
		});

		gsap.to('.morphing-disguises', {
			scrollTrigger: {
				trigger: '.morphing-disguises',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.morph-card', {
			scrollTrigger: {
				trigger: '.morph-grid',
				start: 'top 70%'
			},
			y: 100,
			opacity: 0,
			duration: 0.8,
			stagger: 0.15,
			ease: 'back.out(1.7)'
		});

		gsap.to('.security-metrics', {
			scrollTrigger: {
				trigger: '.security-metrics',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		// Counter animation
		const counters = document.querySelectorAll('.metric-value');
		counters.forEach(counter => {
			gsap.from(counter, {
				scrollTrigger: {
					trigger: counter,
					start: 'top 80%'
				},
				textContent: 0,
				duration: 2,
				snap: { textContent: 1 },
				ease: 'power1.out'
			});
		});

		// Animation loop
		const originalPositions = blobGeometry.attributes.position.array.slice();
		let mouseX = 0;
		let mouseY = 0;
		
		document.addEventListener('mousemove', (event) => {
			mouseX = (event.clientX / window.innerWidth) * 2 - 1;
			mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
		});

		function animate() {
			requestAnimationFrame(animate);
			
			const time = Date.now() * 0.001;
			
			// Morph blob vertices for liquid effect
			const positions = blobGeometry.attributes.position;
			for (let i = 0; i < positions.count; i++) {
				const i3 = i * 3;
				const x = originalPositions[i3];
				const y = originalPositions[i3 + 1];
				const z = originalPositions[i3 + 2];
				
				const noise = Math.sin(x * 2 + time) * Math.cos(y * 2 + time) * 0.1;
				positions.array[i3] = x + noise;
				positions.array[i3 + 1] = y + noise;
				positions.array[i3 + 2] = z + noise;
			}
			positions.needsUpdate = true;
			
			// Rotate blob
			blob.rotation.x += 0.002;
			blob.rotation.y += 0.003;
			
			// Animate particles
			particles.rotation.y += 0.001;
			
			// Orbit lights
			light1.position.x = Math.sin(time * 0.5) * 5;
			light1.position.z = Math.cos(time * 0.5) * 5;
			
			light2.position.x = Math.cos(time * 0.7) * 5;
			light2.position.z = Math.sin(time * 0.7) * 5;
			
			// Mouse interaction
			camera.position.x += (mouseX * 1 - camera.position.x) * 0.05;
			camera.position.y += (mouseY * 1 - camera.position.y) * 0.05;
			camera.lookAt(scene.position);
			
			// Scroll effect
			const scrollY = window.scrollY;
			blob.position.y = scrollY * 0.0003;
			
			renderer.render(scene, camera);
		}
		
		animate();

		// Resize handler
		window.addEventListener('resize', () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		});
	</script>
</Layout>
