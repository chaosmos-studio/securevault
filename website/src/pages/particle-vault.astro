---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - 3D Particle Vault">
	<div class="back-nav">
		<a href="/SecureVault/">← Back</a>
	</div>

	<div class="particle-vault">
		<canvas id="particle-canvas"></canvas>
		
		<section class="hero-3d">
			<div class="container">
				<h1 class="title-3d">
					<span class="word">SECURE</span>
					<span class="word">VAULT</span>
				</h1>
				<p class="subtitle-3d">Your secrets, encrypted in a universe of particles</p>
				<div class="hero-cta">
					<a href="https://play.google.com/store" target="_blank" class="playstore-btn">
						<svg viewBox="0 0 24 24" width="24" height="24">
							<path fill="currentColor" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
						</svg>
						<div class="btn-content">
							<span class="btn-label">GET IT ON</span>
							<span class="btn-store">Google Play</span>
						</div>
					</a>
				</div>
			</div>
		</section>

		<section class="features-3d">
			<div class="container">
				<h2 class="section-title">Master the Art of Digital Privacy</h2>
				<div class="features-grid">
					<div class="feature-3d" data-index="1">
						<div class="feature-number">01</div>
						<div class="feature-icon">🎭</div>
						<h3>Perfect Disguises</h3>
						<p>Four fully functional apps hide your vault. Calculator, Notes, Clock, Weather - each works exactly as expected.</p>
					</div>
					<div class="feature-3d" data-index="2">
						<div class="feature-number">02</div>
						<div class="feature-icon">🔐</div>
						<h3>Military Encryption</h3>
						<p>AES-256-CBC with PBKDF2 key derivation. 100,000 iterations. The same standard used by governments worldwide.</p>
					</div>
					<div class="feature-3d" data-index="3">
						<div class="feature-number">03</div>
						<div class="feature-icon">🗂️</div>
						<h3>Multi-Vault System</h3>
						<p>Unlimited vaults with different passwords. Each unlocks completely different content. Perfect compartmentalization.</p>
					</div>
					<div class="feature-3d" data-index="4">
						<div class="feature-number">04</div>
						<div class="feature-icon">📵</div>
						<h3>Zero Network</h3>
						<p>Everything stays offline. No cloud sync, no servers, no third parties. Your data never leaves your device.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="disguises-3d">
			<div class="container">
				<h2 class="section-title">Access Protocols</h2>
				<div class="disguises-grid">
					<div class="disguise-item">
						<div class="disguise-visual">
							<div class="disguise-glow"></div>
							<div class="disguise-emoji">🧮</div>
						</div>
						<h3>Calculator</h3>
						<p class="entry-method">Entry: <code>CODE + [=]</code></p>
						<p class="description">Fully functional calculator. Type your passcode and press equals to unlock your vault.</p>
					</div>
					<div class="disguise-item">
						<div class="disguise-visual">
							<div class="disguise-glow"></div>
							<div class="disguise-emoji">📝</div>
						</div>
						<h3>Notes</h3>
						<p class="entry-method">Entry: <code>TAP TITLE × 5</code></p>
						<p class="description">Create and manage notes. Tap the title five times rapidly to access your hidden vault.</p>
					</div>
					<div class="disguise-item">
						<div class="disguise-visual">
							<div class="disguise-glow"></div>
							<div class="disguise-emoji">🕐</div>
						</div>
						<h3>Clock</h3>
						<p class="entry-method">Entry: <code>TIME = CODE</code></p>
						<p class="description">Displays current time. Set alarm to your code (1234 becomes 12:34) to unlock.</p>
					</div>
					<div class="disguise-item">
						<div class="disguise-visual">
							<div class="disguise-glow"></div>
							<div class="disguise-emoji">🌤️</div>
						</div>
						<h3>Weather</h3>
						<p class="entry-method">Entry: <code>SETTINGS × 7</code></p>
						<p class="description">Weather forecast app. Tap the settings icon seven times to reveal the vault.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="download-3d">
			<div class="container">
				<div class="download-content">
					<h2>Secure Your Digital Life Today</h2>
					<p>Download SecureVault now and take control of your privacy</p>
					<a href="https://play.google.com/store" target="_blank" class="download-button">
						<svg viewBox="0 0 24 24" width="32" height="32">
							<path fill="currentColor" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
						</svg>
						<div>
							<span class="download-label">Download on</span>
							<span class="download-store">Google Play</span>
						</div>
					</a>
					<div class="app-info">
						<span>Version 1.0.0</span>
						<span>•</span>
						<span>50.5 MB</span>
						<span>•</span>
						<span>Android 8.0+</span>
						<span>•</span>
						<span>Free</span>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>

<script type="module" lang="ts">
	import * as THREE from 'three';

	const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
	const scene = new THREE.Scene();
	const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
	const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });

	renderer.setSize(window.innerWidth, window.innerHeight);
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
	camera.position.z = 5;

	// Create particle system
	const particlesGeometry = new THREE.BufferGeometry();
	const particlesCount = 5000;
	const posArray = new Float32Array(particlesCount * 3);
	const colors = new Float32Array(particlesCount * 3);

	for (let i = 0; i < particlesCount * 3; i += 3) {
		posArray[i] = (Math.random() - 0.5) * 20;
		posArray[i + 1] = (Math.random() - 0.5) * 20;
		posArray[i + 2] = (Math.random() - 0.5) * 20;

		// Color gradient from cyan to purple
		const color = new THREE.Color();
		color.setHSL(Math.random() * 0.2 + 0.5, 1, 0.5);
		colors[i] = color.r;
		colors[i + 1] = color.g;
		colors[i + 2] = color.b;
	}

	particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
	particlesGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

	const particlesMaterial = new THREE.PointsMaterial({
		size: 0.05,
		vertexColors: true,
		transparent: true,
		opacity: 0.8,
		blending: THREE.AdditiveBlending,
	});

	const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
	scene.add(particlesMesh);

	// Create vault sphere
	const vaultGeometry = new THREE.SphereGeometry(2, 32, 32);
	const vaultMaterial = new THREE.MeshBasicMaterial({
		color: 0x667eea,
		wireframe: true,
		transparent: true,
		opacity: 0.3,
	});
	const vaultMesh = new THREE.Mesh(vaultGeometry, vaultMaterial);
	scene.add(vaultMesh);

	// Mouse interaction
	let mouseX = 0;
	let mouseY = 0;

	document.addEventListener('mousemove', (event) => {
		mouseX = (event.clientX / window.innerWidth) * 2 - 1;
		mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
	});

	// Animation
	const clock = new THREE.Clock();

	function animate() {
		requestAnimationFrame(animate);

		const elapsedTime = clock.getElapsedTime();

		// Rotate particles
		particlesMesh.rotation.y = elapsedTime * 0.05;
		particlesMesh.rotation.x = Math.sin(elapsedTime * 0.1) * 0.1;

		// Rotate vault
		vaultMesh.rotation.y = elapsedTime * 0.1;
		vaultMesh.rotation.x = elapsedTime * 0.05;

		// Mouse interaction
		particlesMesh.rotation.x += mouseY * 0.0005;
		particlesMesh.rotation.y += mouseX * 0.0005;
		vaultMesh.rotation.x += mouseY * 0.001;
		vaultMesh.rotation.y += mouseX * 0.001;

		// Pulse effect
		const scale = 1 + Math.sin(elapsedTime) * 0.05;
		vaultMesh.scale.set(scale, scale, scale);

		renderer.render(scene, camera);
	}

	animate();

	// Resize handler
	window.addEventListener('resize', () => {
		camera.aspect = window.innerWidth / window.innerHeight;
		camera.updateProjectionMatrix();
		renderer.setSize(window.innerWidth, window.innerHeight);
	});

	// GSAP animations for text
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	gsap.from('.word', {
		y: 100,
		opacity: 0,
		duration: 1,
		stagger: 0.2,
		ease: 'power4.out',
	});

	gsap.from('.subtitle-3d', {
		opacity: 0,
		y: 30,
		duration: 1,
		delay: 0.5,
	});

	gsap.from('.hero-cta', {
		opacity: 0,
		y: 30,
		duration: 1,
		delay: 0.8,
	});

	// Feature cards animation
	gsap.utils.toArray('.feature-3d').forEach((feature: any, i) => {
		gsap.from(feature, {
			scrollTrigger: {
				trigger: feature,
				start: 'top 80%',
			},
			opacity: 0,
			y: 50,
			duration: 0.8,
			delay: i * 0.1,
		});
	});

	// Disguise items animation
	gsap.utils.toArray('.disguise-item').forEach((item: any, i) => {
		gsap.from(item, {
			scrollTrigger: {
				trigger: item,
				start: 'top 80%',
			},
			opacity: 0,
			scale: 0.8,
			duration: 0.8,
			delay: i * 0.1,
		});
	});
</script>

<style is:inline>
	.back-nav {
		position: fixed;
		top: 1.5rem;
		left: 1.5rem;
		z-index: 1001;
	}

	.back-nav a {
		color: rgba(255, 255, 255, 0.9);
		text-decoration: none;
		background: rgba(0, 0, 0, 0.5);
		padding: 0.75rem 1.5rem;
		border-radius: 2rem;
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition: all 0.3s ease;
	}

	.back-nav a:hover {
		background: rgba(0, 0, 0, 0.7);
		border-color: rgba(102, 126, 234, 0.5);
	}

	.particle-vault {
		background: linear-gradient(180deg, #0a0a0f 0%, #1a0a2e 100%);
		color: white;
		position: relative;
		overflow: hidden;
	}

	#particle-canvas {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
		position: relative;
		z-index: 1;
	}

	.hero-3d {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.title-3d {
		font-size: 8rem;
		font-weight: 900;
		line-height: 1;
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.word {
		display: block;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		text-shadow: 0 0 80px rgba(102, 126, 234, 0.5);
	}

	.subtitle-3d {
		font-size: 1.75rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-cta {
		display: flex;
		justify-content: center;
	}

	.playstore-btn {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(10px);
		border: 2px solid rgba(255, 255, 255, 0.2);
		padding: 1rem 2rem;
		border-radius: 0.75rem;
		text-decoration: none;
		color: white;
		transition: all 0.3s ease;
	}

	.playstore-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: #667eea;
		transform: translateY(-2px);
		box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
	}

	.btn-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.btn-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.btn-store {
		font-size: 1.25rem;
		font-weight: 600;
	}

	.features-3d {
		padding: 8rem 0;
		position: relative;
	}

	.section-title {
		font-size: 3.5rem;
		text-align: center;
		margin-bottom: 5rem;
		font-weight: 700;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.feature-3d {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 2.5rem;
		border-radius: 1.5rem;
		position: relative;
		overflow: hidden;
		transition: all 0.3s ease;
	}

	.feature-3d::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.feature-3d:hover::before {
		opacity: 1;
	}

	.feature-3d:hover {
		border-color: rgba(102, 126, 234, 0.5);
		transform: translateY(-5px);
	}

	.feature-number {
		position: absolute;
		top: 1rem;
		right: 1rem;
		font-size: 4rem;
		font-weight: 900;
		color: rgba(255, 255, 255, 0.05);
	}

	.feature-icon {
		font-size: 3rem;
		margin-bottom: 1.5rem;
	}

	.feature-3d h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.feature-3d p {
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.6;
	}

	.disguises-3d {
		padding: 8rem 0;
	}

	.disguises-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 3rem;
	}

	.disguise-item {
		text-align: center;
	}

	.disguise-visual {
		position: relative;
		width: 150px;
		height: 150px;
		margin: 0 auto 2rem;
	}

	.disguise-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 70%);
		border-radius: 50%;
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(1.1);
			opacity: 0.5;
		}
	}

	.disguise-emoji {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 5rem;
		filter: drop-shadow(0 0 20px rgba(102, 126, 234, 0.5));
	}

	.disguise-item h3 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.entry-method {
		color: #667eea;
		margin-bottom: 1rem;
		font-size: 1.1rem;
	}

	.entry-method code {
		background: rgba(102, 126, 234, 0.2);
		padding: 0.25rem 0.75rem;
		border-radius: 0.5rem;
		font-family: 'Courier New', monospace;
		border: 1px solid rgba(102, 126, 234, 0.3);
	}

	.description {
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.6;
	}

	.download-3d {
		padding: 8rem 0;
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
	}

	.download-content {
		text-align: center;
		max-width: 800px;
		margin: 0 auto;
	}

	.download-content h2 {
		font-size: 3rem;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}

	.download-content > p {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 3rem;
	}

	.download-button {
		display: inline-flex;
		align-items: center;
		gap: 1.5rem;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		padding: 1.5rem 3rem;
		border-radius: 1rem;
		text-decoration: none;
		color: white;
		transition: all 0.3s ease;
		box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
	}

	.download-button:hover {
		transform: translateY(-5px);
		box-shadow: 0 15px 50px rgba(102, 126, 234, 0.5);
	}

	.download-button > div {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.download-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		opacity: 0.9;
	}

	.download-store {
		font-size: 1.5rem;
		font-weight: 700;
	}

	.app-info {
		margin-top: 2rem;
		color: rgba(255, 255, 255, 0.5);
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 768px) {
		.title-3d {
			font-size: 4rem;
		}
		.section-title {
			font-size: 2rem;
		}
		.features-grid,
		.disguises-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
