---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog - SecureVault">
	<div class="premium-container" id="main-container">
		
		<SiteHeader />

		<main>
			<section class="page-header">
				<h1 class="headline">Secure <span class="text-gradient">Insights</span></h1>
				<p class="subheadline">Latest updates on privacy, security, and the app.</p>
			</section>

			<div class="blog-list">
				{
					posts.map((post) => (
						<article class="blog-item glow-card">
                            <a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} class="blog-link">
                                <div class="blog-content">
                                    <div class="meta-row">
                                        <FormattedDate date={post.data.pubDate} />
                                    </div>
                                    <h2 class="title">{post.data.title}</h2>
                                    <p class="description">{post.body ? post.body.substring(0, 180) : ''}...</p>
                                    <span class="read-more">Read Story</span>
                                </div>
                                
                                {post.data.heroImage && (
                                    <div class="blog-image-container">
                                        <Image 
                                            width={400} 
                                            height={250} 
                                            src={post.data.heroImage} 
                                            alt="" 
                                            class="blog-image"
                                        />
                                    </div>
                                )}
                            </a>
						</article>
					))
				}
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
    // Spotlight Logic handled in Layout.astro
</script>

<style>
    main { 
        padding: 6rem 5% 4rem; 
        max-width: 900px;
        margin: 0 auto; 
        z-index: 2; 
        position: relative; 
    }

    .page-header { text-align: center; margin-bottom: 4rem; }
    .headline { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 0.5rem; }
    .subheadline { color: var(--text-muted); font-size: 1.2rem; }

    .blog-list {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .blog-item {
        border-bottom: 1px solid var(--border);
        padding: 2rem; /* Added padding to contain the hover glow properly */
        border-radius: 16px; /* Smooth corners for the hover effect */
        transition: transform 0.3s ease;
        background: transparent;
        margin: 0 -2rem; /* Negative margin to counteract padding and keep alignment with text */
    }
    
    /* Remove border bottom on hover so outline looks clean */
    .blog-item:hover {
        border-bottom-color: transparent;
    }

    .blog-item:last-child {
        border-bottom: none;
    }

    .blog-link {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        text-decoration: none;
        color: inherit;
        align-items: center;
    }

    @media (min-width: 768px) {
        .blog-link {
            grid-template-columns: 1.2fr 0.8fr;
        }
    }

    .blog-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        order: 2;
    }
    @media (min-width: 768px) {
        .blog-content { order: 1; }
    }

    .blog-image-container {
        border-radius: 12px;
        overflow: hidden;
        order: 1;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }
    @media (min-width: 768px) {
        .blog-image-container { order: 2; }
    }

    .blog-image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Hover Effects */
    .blog-item:hover .blog-image-container {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.3);
    }
    .blog-item:hover .blog-image {
        transform: scale(1.05);
    }
    .blog-item:hover .title {
        color: var(--accent);
    }

    .meta-row { 
        font-size: 0.85rem; 
        color: var(--text-muted); 
        letter-spacing: 0.5px;
        font-family: monospace; /* Tech feel */
    }
    
    .title { 
        font-size: 1.8rem; 
        font-weight: 700; 
        line-height: 1.2; 
        margin: 0; 
        color: var(--text-main);
        transition: color 0.2s; 
    }
    
    .description { 
        font-size: 1.05rem; 
        color: var(--text-muted); 
        line-height: 1.6; 
        margin: 0;
        display: -webkit-box; 
        -webkit-line-clamp: 3; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
    }

    .read-more { 
        font-size: 0.9rem; 
        font-weight: 600; 
        color: var(--accent);
        margin-top: 0.5rem;
        display: inline-flex;
        align-items: center;
    }
    .read-more::after {
        content: "→";
        margin-left: 5px;
        transition: transform 0.2s;
    }
    .blog-item:hover .read-more::after {
        transform: translateX(4px);
    }
</style>
