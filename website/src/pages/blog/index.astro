---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog - SecureVault">
	<div class="premium-container" id="main-container">
		<div class="spotlight-overlay"></div>
		
		<SiteHeader />

		<main>
			<section class="page-header">
				<h1 class="headline">Secure <span class="text-gradient">Insights</span></h1>
				<p class="subheadline">Latest updates on privacy, security, and the app.</p>
			</section>

			<div class="blog-grid">
				{
					posts.map((post, index) => (
						<a 
                            href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} 
                            class={`blog-card glow-card ${index === 0 ? 'featured' : ''}`}
                        >
							<div class="card-image-wrapper">
								<Image 
                                    width={720} 
                                    height={360} 
                                    src={post.data.heroImage} 
                                    alt="" 
                                    class="card-image"
                                />
                                <div class="card-overlay"></div>
							</div>
							<div class="card-content">
                                <div class="meta-row">
                                    <FormattedDate date={post.data.pubDate} />
                                </div>
								<h2 class="title">{post.data.title}</h2>
                                <p class="description">{post.body ? post.body.substring(0, 100) : ''}...</p>
                                <span class="read-more">Read Article &rarr;</span>
							</div>
						</a>
					))
				}
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
    // Spotlight Logic - consistent throughout site
    const wrapper = document.getElementById('main-container');
    if(wrapper) {
        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);

            document.querySelectorAll('.glow-card').forEach(card => {
                const cardRect = card.getBoundingClientRect();
                const cardX = e.clientX - cardRect.left;
                const cardY = e.clientY - cardRect.top;
                (card as HTMLElement).style.setProperty('--card-x', `${cardX}px`);
                (card as HTMLElement).style.setProperty('--card-y', `${cardY}px`);
            });
        });
    }
</script>

<style>
    /* Premium Styling Variables */
    :root {
        --accent: #3b82f6;
        --accent-glow: rgba(59, 130, 246, 0.5);
        --bg-card: rgba(20, 20, 20, 0.6);
        --border: rgba(255, 255, 255, 0.1);
        --text-main: #fff;
        --text-muted: #888;
    }

    [data-theme="light"] {
        --bg-card: rgba(255, 255, 255, 0.8);
        --border: rgba(0, 0, 0, 0.1);
        --text-main: #111;
        --text-muted: #555;
    }

    .premium-container { width: 100%; min-height: 100vh; position: relative; overflow: hidden; }
    
    .spotlight-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;
        background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.05), transparent 40%);
        mix-blend-mode: screen;
    }

    main { padding-top: 8rem; padding-bottom: 4rem; width: 90%; max-width: 1200px; margin: 0 auto; z-index: 2; position: relative; }

    .page-header { text-align: center; margin-bottom: 4rem; }
    .headline { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 0.5rem; color: var(--text-main); }
    .subheadline { color: var(--text-muted); font-size: 1.2rem; }
    .text-gradient { background: linear-gradient(90deg, var(--accent), #a855f7); -webkit-background-clip: text; color: transparent; }

    /* Grid Layout */
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    /* Featured Post Logic */
    @media (min-width: 768px) {
        .blog-card.featured {
            grid-column: span 2;
            display: flex;
            align-items: center;
        }
        .blog-card.featured .card-image-wrapper { flex: 1.2; height: 100%; }
        .blog-card.featured .card-content { flex: 1; padding: 3rem; }
        .blog-card.featured .title { font-size: 2rem; }
    }

    /* Card Styling */
    .blog-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        backdrop-filter: blur(10px);
        display: flex;
        flex-direction: column;
    }

    .blog-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5); }

    /* Glow Border Effect */
    .glow-card::before {
        content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: inherit; padding: 1px;
        background: radial-gradient(400px circle at var(--card-x, 50%) var(--card-y, 50%), rgba(255,255,255,0.3), transparent 40%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
        pointer-events: none; opacity: 1;
    }

    .card-image-wrapper { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .card-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .blog-card:hover .card-image { transform: scale(1.05); }
    
    .card-content { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; color: var(--text-main); }
    
    .meta-row { font-size: 0.9rem; color: var(--accent); font-weight: 500; margin-bottom: 0.5rem; display: block;}
    .title { font-size: 1.4rem; font-weight: 700; line-height: 1.2; color: var(--text-main); margin: 0; transition: color 0.2s; }
    .blog-card:hover .title { color: var(--accent); }
    
    .description { font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .read-more { font-size: 0.9rem; font-weight: 600; color: var(--text-main); margin-top: auto; display: inline-block; }
    
</style>
