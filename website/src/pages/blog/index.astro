---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog - SecureVault">
	<div class="premium-container" id="main-container">
		<div class="spotlight-overlay"></div>
		
		<SiteHeader />

		<main>
			<section class="page-header">
				<h1 class="headline">Secure <span class="text-gradient">Insights</span></h1>
				<p class="subheadline">Latest updates on privacy, security, and the app.</p>
			</section>

			<div class="blog-grid">
				{
					posts.map((post, index) => (
						<a 
                            href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} 
                            class={`blog-card glow-card ${index === 0 ? 'featured' : ''}`}
                        >
							{post.data.heroImage && (
								<div class="card-image-wrapper">
									<Image 
										width={720} 
										height={360} 
										src={post.data.heroImage} 
										alt="" 
										class="card-image"
									/>
									<div class="card-overlay"></div>
								</div>
							)}
							<div class="card-content">
                                <div class="meta-row">
                                    <FormattedDate date={post.data.pubDate} />
                                </div>
								<h2 class="title">{post.data.title}</h2>
                                <p class="description">{post.body ? post.body.substring(0, 100) : ''}...</p>
                                <span class="read-more">Read Article &rarr;</span>
							</div>
						</a>
					))
				}
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
    // Spotlight Logic - consistent throughout site
    const wrapper = document.getElementById('main-container');
    if(wrapper) {
        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);

            document.querySelectorAll('.glow-card').forEach(card => {
                const cardRect = card.getBoundingClientRect();
                const cardX = e.clientX - cardRect.left;
                const cardY = e.clientY - cardRect.top;
                (card as HTMLElement).style.setProperty('--card-x', `${cardX}px`);
                (card as HTMLElement).style.setProperty('--card-y', `${cardY}px`);
            });
        });
    }
</script>

<style>
    main { 
        padding: 10rem 5% 4rem; 
        max-width: 1200px; 
        margin: 0 auto; 
        z-index: 2; 
        position: relative; 
    }

    .page-header { text-align: center; margin-bottom: 4rem; }
    .headline { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 0.5rem; }
    .subheadline { color: var(--text-muted); font-size: 1.2rem; }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.5rem;
    }

    @media (min-width: 900px) {
        .blog-card.featured {
            grid-column: span 2;
        }
        .blog-card.featured .card-content { padding: 2rem; }
        .blog-card.featured .title { font-size: 1.8rem; }
    }

    .blog-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
    }
    .blog-card:hover { 
        transform: translateY(-4px); 
        box-shadow: 0 12px 40px -12px rgba(0,0,0,0.4); 
    }

    .card-image-wrapper { 
        position: relative; 
        overflow: hidden; 
        aspect-ratio: 16/9;
        background: var(--bg-surface-2);
    }
    .card-image { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        transition: transform 0.5s ease; 
    }
    .blog-card:hover .card-image { transform: scale(1.03); }
    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--bg-main) 0%, transparent 50%);
        opacity: 0.6;
    }

    .card-content { 
        padding: 1.5rem; 
        display: flex; 
        flex-direction: column; 
        gap: 0.5rem; 
        flex: 1;
    }
    
    .meta-row { 
        font-size: 0.85rem; 
        color: var(--accent); 
        font-weight: 600; 
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .title { 
        font-size: 1.25rem; 
        font-weight: 700; 
        line-height: 1.3; 
        margin: 0; 
        transition: color 0.2s; 
    }
    .blog-card:hover .title { color: var(--accent); }
    
    .description { 
        font-size: 0.9rem; 
        color: var(--text-muted); 
        line-height: 1.6; 
        margin: 0;
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
    }

    .read-more { 
        font-size: 0.85rem; 
        font-weight: 600; 
        color: var(--accent);
        margin-top: auto; 
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }
</style>
