---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog - SecureVault">
	<div class="premium-container" id="main-container">
		<div class="spotlight-overlay"></div>
		
		<SiteHeader />

		<main>
			<section class="page-header">
				<h1 class="headline">Secure <span class="text-gradient">Insights</span></h1>
				<p class="subheadline">Latest updates on privacy, security, and the app.</p>
			</section>

			<div class="blog-list">
				{
					posts.map((post) => (
						<a 
                            href={`${import.meta.env.BASE_URL}/blog/${post.id}/`} 
                            class="blog-card glow-card"
                        >
							{post.data.heroImage && (
								<div class="card-image-wrapper">
									<Image 
										width={720} 
										height={360} 
										src={post.data.heroImage} 
										alt="" 
										class="card-image"
									/>
								</div>
							)}
							<div class="card-content">
                                <div class="meta-row">
                                    <FormattedDate date={post.data.pubDate} />
                                </div>
								<h2 class="title">{post.data.title}</h2>
                                <p class="description">{post.body ? post.body.substring(0, 150) : ''}...</p>
                                <span class="read-more">Read Article &rarr;</span>
							</div>
						</a>
					))
				}
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
    // Spotlight Logic - consistent throughout site
    const wrapper = document.getElementById('main-container');
    if(wrapper) {
        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);

            document.querySelectorAll('.glow-card').forEach(card => {
                const cardRect = card.getBoundingClientRect();
                const cardX = e.clientX - cardRect.left;
                const cardY = e.clientY - cardRect.top;
                (card as HTMLElement).style.setProperty('--card-x', `${cardX}px`);
                (card as HTMLElement).style.setProperty('--card-y', `${cardY}px`);
            });
        });
    }
</script>

<style>
    main { 
        padding: 10rem 5% 4rem; 
        max-width: 1000px; /* Reduced width for better reading experience in list view */
        margin: 0 auto; 
        z-index: 2; 
        position: relative; 
    }

    .page-header { text-align: center; margin-bottom: 5rem; }
    .headline { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 0.5rem; }
    .subheadline { color: var(--text-muted); font-size: 1.2rem; }

    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .blog-card {
        background: rgba(var(--bg-surface-rgb), 0.5); /* Assuming rgb vars exist or falling back to simple opacity */
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        backdrop-filter: blur(12px);
        display: grid;
        grid-template-columns: 1fr;
        position: relative;
    }

    @media (min-width: 768px) {
        .blog-card {
            grid-template-columns: 280px 1fr;
            min-height: 200px;
        }
    }

    .blog-card:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 8px 30px rgba(0,0,0,0.12); /* Subtle glow */
        border-color: var(--accent);
    }
    .blog-card:active {
        transform: scale(0.99);
    }

    .card-image-wrapper { 
        position: relative; 
        overflow: hidden; 
        height: 200px;
        background: var(--bg-surface-2);
    }
    @media (min-width: 768px) {
        .card-image-wrapper {
            height: 100%;
        }
    }

    .card-image { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); 
    }
    .blog-card:hover .card-image { transform: scale(1.05); }

    /* Remove overlay for cleaner look */

    .card-content { 
        padding: 2rem; 
        display: flex; 
        flex-direction: column; 
        gap: 0.8rem; 
        justify-content: center;
    }
    
    .meta-row { 
        font-size: 0.8rem; 
        color: var(--accent); 
        font-weight: 600; 
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    
    .title { 
        font-size: 1.5rem; 
        font-weight: 700; 
        line-height: 1.2; 
        margin: 0; 
        color: var(--text-main);
        transition: color 0.2s; 
    }
    
    .description { 
        font-size: 1rem; 
        color: var(--text-muted); 
        line-height: 1.6; 
        margin: 0;
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
    }

    .read-more { 
        font-size: 0.9rem; 
        font-weight: 600; 
        color: var(--text-main);
        margin-top: 1rem; 
        display: flex;
        align-items: center;
        gap: 0.5rem;
        opacity: 0.8;
        transition: opacity 0.2s;
    }
    .blog-card:hover .read-more {
        opacity: 1;
        color: var(--accent);
    }
</style>
