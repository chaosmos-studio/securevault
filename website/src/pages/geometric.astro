---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Geometric Privacy">
	<div class="geo-container">
		<canvas id="geoCanvas"></canvas>
		
		<div class="content">
			<header class="hero">
				<div class="logo-box">
					<div class="rotating-cube"></div>
				</div>
				
				<h1 class="main-title">SECUREVAULT</h1>
				<p class="hero-desc">Privacy Hidden in Plain Sight</p>
				
				<a href="https://play.google.com/store" class="download-link" target="_blank" rel="noopener noreferrer">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
					</svg>
					Download on Google Play
				</a>
				
				<div class="platform-badge">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z"/>
					</svg>
					Android 8.0+
				</div>
			</header>

			<section class="features">
				<h2 class="section-heading">Core Security Features</h2>
				
				<div class="features-list">
					<div class="feature-item">
						<div class="feature-icon">🔒</div>
						<h3>AES-256 Encryption</h3>
						<p>Military-grade encryption standard protects all your files, photos, videos, and notes with unbreakable security</p>
					</div>
					
					<div class="feature-item">
						<div class="feature-icon">🎭</div>
						<h3>4 Perfect Disguises</h3>
						<p>Hide your vault as a fully functional Calculator, Notes, Clock, or Weather app - change anytime with one tap</p>
					</div>
					
					<div class="feature-item">
						<div class="feature-icon">🗄️</div>
						<h3>Multiple Vaults</h3>
						<p>Create unlimited separate vaults with different passwords - organize your private data by category</p>
					</div>
					
					<div class="feature-item">
						<div class="feature-icon">✈️</div>
						<h3>100% Offline</h3>
						<p>No internet connection required - your data never leaves your device, ensuring complete privacy</p>
					</div>
					
					<div class="feature-item">
						<div class="feature-icon">🚫</div>
						<h3>Screenshot Protection</h3>
						<p>Prevents screenshots of sensitive content, adding an extra layer of security against prying eyes</p>
					</div>
					
					<div class="feature-item">
						<div class="feature-icon">🔑</div>
						<h3>PBKDF2 Key Derivation</h3>
						<p>Advanced cryptographic key generation ensures your password creates an uncrackable encryption key</p>
					</div>
				</div>
			</section>

			<section class="disguises">
				<h2 class="section-heading">Smart Disguises</h2>
				<p class="section-subtitle">Each disguise works perfectly - no one will suspect your vault</p>
				
				<div class="disguise-boxes">
					<div class="disguise-box">
						<div class="box-header">
							<span class="box-icon">🧮</span>
							<h3>Calculator</h3>
						</div>
						<div class="box-body">
							<p class="disguise-desc">Fully functional scientific calculator with standard operations</p>
							<div class="entry-hint">
								<strong>Secret Entry:</strong>
								<code>123456=</code>
							</div>
						</div>
					</div>
					
					<div class="disguise-box">
						<div class="box-header">
							<span class="box-icon">📝</span>
							<h3>Notes</h3>
						</div>
						<div class="box-body">
							<p class="disguise-desc">Clean note-taking app with create, edit, and organize features</p>
							<div class="entry-hint">
								<strong>Secret Entry:</strong>
								<code>Long press + button</code>
							</div>
						</div>
					</div>
					
					<div class="disguise-box">
						<div class="box-header">
							<span class="box-icon">⏰</span>
							<h3>Clock</h3>
						</div>
						<div class="box-body">
							<p class="disguise-desc">Working clock display with timer and alarm functionality</p>
							<div class="entry-hint">
								<strong>Secret Entry:</strong>
								<code>Tap 12:34:56</code>
							</div>
						</div>
					</div>
					
					<div class="disguise-box">
						<div class="box-header">
							<span class="box-icon">🌤️</span>
							<h3>Weather</h3>
						</div>
						<div class="box-body">
							<p class="disguise-desc">Weather forecast app with current conditions and predictions</p>
							<div class="entry-hint">
								<strong>Secret Entry:</strong>
								<code>Pull down 5 times</code>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="cta-final">
				<h2>Protect Your Privacy Today</h2>
				<p>Join thousands who trust SecureVault with their sensitive data</p>
				<a href="https://play.google.com/store" class="cta-button" target="_blank" rel="noopener noreferrer">
					Get SecureVault Free
				</a>
			</section>
		</div>
	</div>

	<style is:inline>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		.geo-container {
			min-height: 100vh;
			background: #0f0f0f;
			color: #fff;
			position: relative;
			overflow-x: hidden;
		}

		#geoCanvas {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: 1;
		}

		.content {
			position: relative;
			z-index: 2;
			max-width: 1200px;
			margin: 0 auto;
			padding: 2rem;
		}

		.hero {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
		}

		.logo-box {
			width: 150px;
			height: 150px;
			margin-bottom: 2rem;
			perspective: 1000px;
		}

		.rotating-cube {
			width: 100%;
			height: 100%;
			position: relative;
			transform-style: preserve-3d;
		}

		.rotating-cube::before {
			content: '🛡️';
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			font-size: 5rem;
			z-index: 2;
		}

		.main-title {
			font-size: clamp(3rem, 10vw, 7rem);
			font-weight: 900;
			letter-spacing: 0.5rem;
			margin-bottom: 1rem;
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.hero-desc {
			font-size: clamp(1.2rem, 3vw, 1.8rem);
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 3rem;
			letter-spacing: 3px;
		}

		.download-link {
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			padding: 1.25rem 2.5rem;
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			color: #000;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.1rem;
			border-radius: 8px;
			transition: all 0.3s ease;
			box-shadow: 0 10px 40px rgba(79, 172, 254, 0.3);
			margin-bottom: 1.5rem;
		}

		.download-link:hover {
			transform: translateY(-3px);
			box-shadow: 0 15px 50px rgba(79, 172, 254, 0.5);
		}

		.platform-badge {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			color: rgba(255, 255, 255, 0.5);
			font-size: 0.9rem;
		}

		.features {
			padding: 8rem 0;
			opacity: 0;
		}

		.section-heading {
			font-size: clamp(2.5rem, 6vw, 4rem);
			text-align: center;
			margin-bottom: 1rem;
			color: #4facfe;
			font-weight: 900;
		}

		.section-subtitle {
			text-align: center;
			font-size: 1.2rem;
			color: rgba(255, 255, 255, 0.6);
			margin-bottom: 4rem;
		}

		.features-list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 2rem;
		}

		.feature-item {
			background: rgba(255, 255, 255, 0.03);
			border: 2px solid rgba(79, 172, 254, 0.2);
			padding: 2rem;
			border-radius: 10px;
			transition: all 0.3s ease;
		}

		.feature-item:hover {
			border-color: #4facfe;
			transform: translateY(-5px);
			box-shadow: 0 10px 30px rgba(79, 172, 254, 0.2);
		}

		.feature-icon {
			font-size: 3rem;
			margin-bottom: 1rem;
		}

		.feature-item h3 {
			font-size: 1.5rem;
			color: #4facfe;
			margin-bottom: 0.75rem;
		}

		.feature-item p {
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.6;
		}

		.disguises {
			padding: 8rem 0;
			opacity: 0;
		}

		.disguise-boxes {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}

		.disguise-box {
			background: rgba(255, 255, 255, 0.05);
			border: 2px solid rgba(79, 172, 254, 0.3);
			border-radius: 15px;
			overflow: hidden;
			transition: all 0.3s ease;
		}

		.disguise-box:hover {
			border-color: #00f2fe;
			transform: scale(1.05);
			box-shadow: 0 15px 40px rgba(0, 242, 254, 0.3);
		}

		.box-header {
			background: linear-gradient(135deg, rgba(79, 172, 254, 0.2), rgba(0, 242, 254, 0.2));
			padding: 1.5rem;
			text-align: center;
			border-bottom: 2px solid rgba(79, 172, 254, 0.3);
		}

		.box-icon {
			font-size: 4rem;
			display: block;
			margin-bottom: 0.5rem;
		}

		.box-header h3 {
			font-size: 1.8rem;
			color: #4facfe;
		}

		.box-body {
			padding: 1.5rem;
		}

		.disguise-desc {
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 1.5rem;
			line-height: 1.5;
		}

		.entry-hint {
			background: rgba(0, 0, 0, 0.3);
			padding: 1rem;
			border-radius: 8px;
			border-left: 3px solid #4facfe;
		}

		.entry-hint strong {
			color: #4facfe;
			display: block;
			margin-bottom: 0.5rem;
			font-size: 0.9rem;
		}

		.entry-hint code {
			color: #00f2fe;
			font-family: 'Courier New', monospace;
			font-size: 1rem;
		}

		.cta-final {
			padding: 8rem 2rem;
			text-align: center;
		}

		.cta-final h2 {
			font-size: clamp(2.5rem, 6vw, 4rem);
			color: #4facfe;
			margin-bottom: 1rem;
		}

		.cta-final p {
			font-size: 1.3rem;
			color: rgba(255, 255, 255, 0.7);
			margin-bottom: 2.5rem;
		}

		.cta-button {
			display: inline-block;
			padding: 1.5rem 3.5rem;
			background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
			color: #000;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.3rem;
			border-radius: 8px;
			box-shadow: 0 15px 50px rgba(79, 172, 254, 0.4);
			transition: all 0.3s ease;
		}

		.cta-button:hover {
			transform: translateY(-5px);
			box-shadow: 0 20px 60px rgba(79, 172, 254, 0.6);
		}

		@media (max-width: 768px) {
			.features-list {
				grid-template-columns: 1fr;
			}
			
			.disguise-boxes {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollTrigger);

		// Three.js setup
		const canvas = document.getElementById('geoCanvas') as HTMLCanvasElement;
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		camera.position.z = 10;

		// Create floating geometric shapes
		const shapes: THREE.Mesh[] = [];
		const geometries = [
			new THREE.BoxGeometry(1, 1, 1),
			new THREE.OctahedronGeometry(0.7),
			new THREE.TetrahedronGeometry(0.8),
			new THREE.IcosahedronGeometry(0.6)
		];

		for (let i = 0; i < 15; i++) {
			const geometry = geometries[Math.floor(Math.random() * geometries.length)];
			const material = new THREE.MeshBasicMaterial({
				color: new THREE.Color().setHSL(0.55, 1, 0.6),
				wireframe: true,
				transparent: true,
				opacity: 0.3
			});
			
			const mesh = new THREE.Mesh(geometry, material);
			mesh.position.set(
				(Math.random() - 0.5) * 20,
				(Math.random() - 0.5) * 20,
				(Math.random() - 0.5) * 10
			);
			
			mesh.userData.rotationSpeed = {
				x: (Math.random() - 0.5) * 0.02,
				y: (Math.random() - 0.5) * 0.02
			};
			
			shapes.push(mesh);
			scene.add(mesh);
		}

		// Central lock shape
		const lockGeometry = new THREE.TorusGeometry(1.5, 0.1, 16, 100);
		const lockMaterial = new THREE.MeshBasicMaterial({
			color: 0x4facfe,
			transparent: true,
			opacity: 0.5
		});
		const lock = new THREE.Mesh(lockGeometry, lockMaterial);
		scene.add(lock);

		// GSAP Animations
		gsap.to('.rotating-cube', {
			rotateY: 360,
			duration: 8,
			repeat: -1,
			ease: 'none'
		});

		gsap.from('.main-title', {
			opacity: 0,
			y: 100,
			duration: 1.5,
			ease: 'power3.out',
			delay: 0.3
		});

		gsap.from('.hero-desc', {
			opacity: 0,
			y: 50,
			duration: 1,
			delay: 0.8
		});

		gsap.from('.download-link', {
			opacity: 0,
			scale: 0.8,
			duration: 0.8,
			delay: 1.2,
			ease: 'back.out(1.7)'
		});

		// Scroll animations
		gsap.to('.features', {
			scrollTrigger: {
				trigger: '.features',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.feature-item', {
			scrollTrigger: {
				trigger: '.features-list',
				start: 'top 70%'
			},
			y: 80,
			opacity: 0,
			duration: 0.8,
			stagger: 0.15,
			ease: 'power2.out'
		});

		gsap.to('.disguises', {
			scrollTrigger: {
				trigger: '.disguises',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.disguise-box', {
			scrollTrigger: {
				trigger: '.disguise-boxes',
				start: 'top 70%'
			},
			scale: 0.8,
			opacity: 0,
			duration: 0.6,
			stagger: 0.1,
			ease: 'back.out(1.7)'
		});

		// Mouse interaction
		let mouseX = 0;
		let mouseY = 0;
		
		document.addEventListener('mousemove', (event) => {
			mouseX = (event.clientX / window.innerWidth) * 2 - 1;
			mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
		});

		// Animation loop
		function animate() {
			requestAnimationFrame(animate);
			
			const time = Date.now() * 0.001;
			
			// Rotate shapes
			shapes.forEach(shape => {
				shape.rotation.x += shape.userData.rotationSpeed.x;
				shape.rotation.y += shape.userData.rotationSpeed.y;
				shape.position.y += Math.sin(time + shape.position.x) * 0.003;
			});
			
			// Rotate lock
			lock.rotation.z += 0.01;
			lock.rotation.x = Math.sin(time * 0.5) * 0.3;
			
			// Mouse parallax
			camera.position.x += (mouseX * 2 - camera.position.x) * 0.05;
			camera.position.y += (mouseY * 2 - camera.position.y) * 0.05;
			camera.lookAt(scene.position);
			
			// Scroll effect
			const scrollY = window.scrollY;
			scene.rotation.y = scrollY * 0.0001;
			
			renderer.render(scene, camera);
		}
		
		animate();

		// Resize handler
		window.addEventListener('resize', () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		});
	</script>
</Layout>
