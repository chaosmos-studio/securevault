---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Neural Network Security">
	<div class="neural-container">
		<canvas id="neuralCanvas"></canvas>
		
		<div class="scan-line"></div>
		
		<div class="content">
			<div class="hero-section">
				<div class="logo-container">
					<div class="neural-logo">
						<div class="pulse-ring"></div>
						<div class="pulse-ring"></div>
						<div class="pulse-ring"></div>
					</div>
				</div>
				
				<h1 class="neural-title">
					<span class="letter">S</span><span class="letter">E</span><span class="letter">C</span><span class="letter">U</span><span class="letter">R</span><span class="letter">E</span>
					<br>
					<span class="letter">V</span><span class="letter">A</span><span class="letter">U</span><span class="letter">L</span><span class="letter">T</span>
				</h1>
				
				<p class="neural-tagline">Network-Level Privacy Protection</p>
				
				<a href="https://play.google.com/store" class="neural-download" target="_blank" rel="noopener noreferrer">
					<span class="btn-bg"></span>
					<span class="btn-content">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
						</svg>
						Download on Google Play
					</span>
				</a>
				
				<div class="stats-row">
					<div class="stat">
						<div class="stat-value">256-bit</div>
						<div class="stat-label">Encryption</div>
					</div>
					<div class="stat">
						<div class="stat-value">100%</div>
						<div class="stat-label">Offline</div>
					</div>
					<div class="stat">
						<div class="stat-value">4</div>
						<div class="stat-label">Disguises</div>
					</div>
				</div>
			</div>

			<section class="security-layer">
				<h2 class="section-title">
					<span class="title-line"></span>
					SECURITY LAYERS
					<span class="title-line"></span>
				</h2>
				
				<div class="layers-grid">
					<div class="layer-card" data-layer="1">
						<div class="layer-number">01</div>
						<h3>AES-256 Encryption</h3>
						<p>Military-grade encryption protects every file, photo, and note in your vault</p>
					</div>
					<div class="layer-card" data-layer="2">
						<div class="layer-number">02</div>
						<h3>Perfect Disguise</h3>
						<p>Transform into Calculator, Notes, Clock, or Weather app with one tap</p>
					</div>
					<div class="layer-card" data-layer="3">
						<div class="layer-number">03</div>
						<h3>Multi-Vault System</h3>
						<p>Create unlimited vaults with different passwords for organized security</p>
					</div>
					<div class="layer-card" data-layer="4">
						<div class="layer-number">04</div>
						<h3>Zero Trace</h3>
						<p>Completely offline operation with screenshot protection and no analytics</p>
					</div>
				</div>
			</section>

			<section class="disguises-showcase">
				<h2 class="section-title">
					<span class="title-line"></span>
					DISGUISE PROTOCOLS
					<span class="title-line"></span>
				</h2>
				
				<div class="showcase-grid">
					<div class="showcase-item">
						<div class="showcase-icon">
							<div class="icon-glow"></div>
							🧮
						</div>
						<h3>Calculator Mode</h3>
						<div class="access-code">
							<span class="code-label">Access:</span>
							<code>123456=</code>
						</div>
						<p>Fully functional calculator that secretly opens your vault</p>
					</div>
					
					<div class="showcase-item">
						<div class="showcase-icon">
							<div class="icon-glow"></div>
							📝
						</div>
						<h3>Notes Mode</h3>
						<div class="access-code">
							<span class="code-label">Access:</span>
							<code>Long press +</code>
						</div>
						<p>Note-taking app with hidden vault access</p>
					</div>
					
					<div class="showcase-item">
						<div class="showcase-icon">
							<div class="icon-glow"></div>
							⏰
						</div>
						<h3>Clock Mode</h3>
						<div class="access-code">
							<span class="code-label">Access:</span>
							<code>Tap 12:34:56</code>
						</div>
						<p>Working clock with secret vault entry</p>
					</div>
					
					<div class="showcase-item">
						<div class="showcase-icon">
							<div class="icon-glow"></div>
							🌤️
						</div>
						<h3>Weather Mode</h3>
						<div class="access-code">
							<span class="code-label">Access:</span>
							<code>Pull down 5x</code>
						</div>
						<p>Weather forecast with hidden protection</p>
					</div>
				</div>
			</section>

			<div class="final-cta">
				<h2>Ready to Secure Your Privacy?</h2>
				<a href="https://play.google.com/store" class="cta-button" target="_blank" rel="noopener noreferrer">
					Get SecureVault Now
				</a>
				<p class="compatibility">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z"/>
					</svg>
					Requires Android 8.0 or higher
				</p>
			</div>
		</div>
	</div>

	<style is:inline>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		.neural-container {
			min-height: 100vh;
			background: #000000;
			position: relative;
			overflow-x: hidden;
			color: #fff;
		}

		#neuralCanvas {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: 1;
		}

		.scan-line {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 2px;
			background: linear-gradient(90deg, transparent, #00ff88, transparent);
			z-index: 3;
			box-shadow: 0 0 20px #00ff88;
		}

		.content {
			position: relative;
			z-index: 2;
			padding: 2rem;
			max-width: 1400px;
			margin: 0 auto;
		}

		.hero-section {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
			padding: 4rem 2rem;
		}

		.logo-container {
			margin-bottom: 3rem;
		}

		.neural-logo {
			width: 150px;
			height: 150px;
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.neural-logo::before {
			content: '🛡️';
			font-size: 4rem;
			position: relative;
			z-index: 2;
		}

		.pulse-ring {
			position: absolute;
			width: 100%;
			height: 100%;
			border: 2px solid #00ff88;
			border-radius: 50%;
			opacity: 0;
		}

		.neural-title {
			font-size: clamp(3rem, 10vw, 7rem);
			font-weight: 900;
			margin-bottom: 1.5rem;
			letter-spacing: 0.5rem;
			line-height: 1.2;
		}

		.neural-title .letter {
			display: inline-block;
			color: #00ff88;
			text-shadow: 0 0 20px #00ff88, 0 0 40px #00ff88;
		}

		.neural-tagline {
			font-size: clamp(1.2rem, 3vw, 1.8rem);
			color: #00ccff;
			margin-bottom: 3rem;
			letter-spacing: 3px;
			text-transform: uppercase;
		}

		.neural-download {
			position: relative;
			display: inline-flex;
			padding: 1.5rem 3rem;
			text-decoration: none;
			color: #000;
			font-weight: 700;
			font-size: 1.1rem;
			overflow: hidden;
			margin-bottom: 3rem;
			border: 2px solid #00ff88;
			background: #00ff88;
		}

		.btn-bg {
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: #00ccff;
			transition: left 0.4s ease;
		}

		.neural-download:hover .btn-bg {
			left: 0;
		}

		.btn-content {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			position: relative;
			z-index: 1;
		}

		.stats-row {
			display: flex;
			gap: 4rem;
			justify-content: center;
		}

		.stat {
			text-align: center;
		}

		.stat-value {
			font-size: 3rem;
			font-weight: 900;
			color: #00ff88;
			text-shadow: 0 0 20px #00ff88;
		}

		.stat-label {
			font-size: 0.9rem;
			color: rgba(255, 255, 255, 0.6);
			text-transform: uppercase;
			letter-spacing: 2px;
			margin-top: 0.5rem;
		}

		.security-layer {
			padding: 8rem 0;
			opacity: 0;
		}

		.section-title {
			font-size: clamp(2rem, 5vw, 3rem);
			text-align: center;
			margin-bottom: 4rem;
			color: #00ff88;
			text-transform: uppercase;
			letter-spacing: 5px;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2rem;
		}

		.title-line {
			width: 100px;
			height: 2px;
			background: linear-gradient(90deg, transparent, #00ff88, transparent);
		}

		.layers-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 2rem;
		}

		.layer-card {
			background: rgba(0, 255, 136, 0.02);
			border: 1px solid rgba(0, 255, 136, 0.2);
			padding: 2.5rem;
			position: relative;
			overflow: hidden;
			transition: all 0.3s ease;
		}

		.layer-card::before {
			content: '';
			position: absolute;
			top: 0;
			left: -100%;
			width: 100%;
			height: 100%;
			background: linear-gradient(90deg, transparent, rgba(0, 255, 136, 0.1), transparent);
			transition: left 0.5s ease;
		}

		.layer-card:hover::before {
			left: 100%;
		}

		.layer-card:hover {
			border-color: #00ff88;
			box-shadow: 0 0 30px rgba(0, 255, 136, 0.3);
		}

		.layer-number {
			font-size: 4rem;
			font-weight: 900;
			color: rgba(0, 255, 136, 0.1);
			position: absolute;
			top: 1rem;
			right: 1rem;
			line-height: 1;
		}

		.layer-card h3 {
			color: #00ff88;
			font-size: 1.5rem;
			margin-bottom: 1rem;
			position: relative;
		}

		.layer-card p {
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.6;
			position: relative;
		}

		.disguises-showcase {
			padding: 8rem 0;
			opacity: 0;
		}

		.showcase-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 3rem;
		}

		.showcase-item {
			text-align: center;
			padding: 2rem;
			background: rgba(0, 204, 255, 0.02);
			border: 1px solid rgba(0, 204, 255, 0.2);
			transition: all 0.3s ease;
		}

		.showcase-item:hover {
			border-color: #00ccff;
			box-shadow: 0 0 40px rgba(0, 204, 255, 0.3);
			transform: translateY(-10px);
		}

		.showcase-icon {
			font-size: 5rem;
			margin-bottom: 1.5rem;
			position: relative;
			display: inline-block;
		}

		.icon-glow {
			position: absolute;
			inset: 0;
			background: radial-gradient(circle, rgba(0, 204, 255, 0.3), transparent);
			filter: blur(20px);
			animation: iconPulse 2s ease-in-out infinite;
		}

		@keyframes iconPulse {
			0%, 100% { opacity: 0.3; transform: scale(1); }
			50% { opacity: 0.6; transform: scale(1.1); }
		}

		.showcase-item h3 {
			color: #00ccff;
			font-size: 1.8rem;
			margin-bottom: 1rem;
		}

		.access-code {
			margin: 1rem 0;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
		}

		.code-label {
			color: rgba(255, 255, 255, 0.5);
			font-size: 0.9rem;
		}

		.access-code code {
			background: rgba(0, 255, 136, 0.1);
			padding: 0.5rem 1rem;
			border-radius: 5px;
			color: #00ff88;
			font-family: 'Courier New', monospace;
			border: 1px solid rgba(0, 255, 136, 0.3);
		}

		.showcase-item p {
			color: rgba(255, 255, 255, 0.6);
			line-height: 1.6;
		}

		.final-cta {
			text-align: center;
			padding: 8rem 2rem;
		}

		.final-cta h2 {
			font-size: clamp(2rem, 5vw, 3.5rem);
			color: #00ff88;
			margin-bottom: 2rem;
		}

		.cta-button {
			display: inline-block;
			padding: 1.5rem 3rem;
			background: linear-gradient(135deg, #00ff88 0%, #00ccff 100%);
			color: #000;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.3rem;
			margin-bottom: 2rem;
			transition: all 0.3s ease;
			box-shadow: 0 10px 40px rgba(0, 255, 136, 0.3);
		}

		.cta-button:hover {
			transform: translateY(-3px);
			box-shadow: 0 15px 50px rgba(0, 255, 136, 0.5);
		}

		.compatibility {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			color: rgba(255, 255, 255, 0.5);
			font-size: 0.9rem;
		}

		@media (max-width: 768px) {
			.stats-row {
				flex-direction: column;
				gap: 2rem;
			}
			
			.showcase-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollTrigger);

		// Three.js Neural Network Setup
		const canvas = document.getElementById('neuralCanvas') as HTMLCanvasElement;
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		camera.position.z = 15;

		// Create neural network nodes
		const nodes: THREE.Mesh[] = [];
		const nodeCount = 50;
		const nodeGeometry = new THREE.SphereGeometry(0.1, 16, 16);
		
		for (let i = 0; i < nodeCount; i++) {
			const nodeMaterial = new THREE.MeshBasicMaterial({
				color: Math.random() > 0.5 ? 0x00ff88 : 0x00ccff,
				transparent: true,
				opacity: 0.8
			});
			
			const node = new THREE.Mesh(nodeGeometry, nodeMaterial);
			node.position.set(
				(Math.random() - 0.5) * 30,
				(Math.random() - 0.5) * 30,
				(Math.random() - 0.5) * 20
			);
			
			nodes.push(node);
			scene.add(node);
		}

		// Create connections between nodes
		const connections: { line: THREE.Line; distance: number }[] = [];
		const lineMaterial = new THREE.LineBasicMaterial({
			color: 0x00ff88,
			transparent: true,
			opacity: 0.2
		});

		for (let i = 0; i < nodeCount; i++) {
			for (let j = i + 1; j < nodeCount; j++) {
				const distance = nodes[i].position.distanceTo(nodes[j].position);
				if (distance < 8) {
					const points = [nodes[i].position, nodes[j].position];
					const lineGeometry = new THREE.BufferGeometry().setFromPoints(points);
					const line = new THREE.Line(lineGeometry, lineMaterial.clone());
					connections.push({ line, distance });
					scene.add(line);
				}
			}
		}

		// Data pulse particles
		const pulseGeometry = new THREE.SphereGeometry(0.05, 8, 8);
		const pulses: THREE.Mesh[] = [];
		
		for (let i = 0; i < 20; i++) {
			const pulseMaterial = new THREE.MeshBasicMaterial({
				color: 0x00ccff,
				transparent: true,
				opacity: 0.8
			});
			const pulse = new THREE.Mesh(pulseGeometry, pulseMaterial);
			
			const randomNode = nodes[Math.floor(Math.random() * nodes.length)];
			pulse.position.copy(randomNode.position);
			pulse.userData.targetNode = nodes[Math.floor(Math.random() * nodes.length)];
			pulse.userData.speed = 0.02 + Math.random() * 0.03;
			
			pulses.push(pulse);
			scene.add(pulse);
		}

		// GSAP Animations
		// Pulse rings animation
		gsap.to('.pulse-ring', {
			scale: 2,
			opacity: 0,
			duration: 2,
			stagger: 0.3,
			repeat: -1,
			ease: 'power2.out'
		});

		// Title letters animation
		gsap.from('.neural-title .letter', {
			opacity: 0,
			y: 50,
			rotationX: -90,
			stagger: 0.05,
			duration: 1,
			ease: 'back.out(1.7)',
			delay: 0.5
		});

		// Continuous letter glow pulse
		gsap.to('.neural-title .letter', {
			textShadow: '0 0 40px #00ff88, 0 0 80px #00ff88',
			duration: 2,
			stagger: {
				each: 0.1,
				repeat: -1,
				yoyo: true
			},
			ease: 'power1.inOut'
		});

		// Scan line animation
		gsap.to('.scan-line', {
			y: window.innerHeight,
			duration: 3,
			repeat: -1,
			ease: 'none'
		});

		// Stats counter animation
		gsap.from('.stat-value', {
			scrollTrigger: {
				trigger: '.stats-row',
				start: 'top 80%'
			},
			textContent: 0,
			duration: 2,
			snap: { textContent: 1 },
			stagger: 0.2
		});

		// Security layers scroll animation
		gsap.to('.security-layer', {
			scrollTrigger: {
				trigger: '.security-layer',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.layer-card', {
			scrollTrigger: {
				trigger: '.layers-grid',
				start: 'top 70%'
			},
			x: -100,
			opacity: 0,
			duration: 0.8,
			stagger: 0.2,
			ease: 'power2.out'
		});

		// Disguises showcase animation
		gsap.to('.disguises-showcase', {
			scrollTrigger: {
				trigger: '.disguises-showcase',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			duration: 1
		});

		gsap.from('.showcase-item', {
			scrollTrigger: {
				trigger: '.showcase-grid',
				start: 'top 70%'
			},
			scale: 0,
			rotation: 180,
			opacity: 0,
			duration: 0.8,
			stagger: 0.15,
			ease: 'back.out(1.7)'
		});

		// Animation loop
		let mouseX = 0;
		let mouseY = 0;
		
		document.addEventListener('mousemove', (event) => {
			mouseX = (event.clientX / window.innerWidth) * 2 - 1;
			mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
		});

		function animate() {
			requestAnimationFrame(animate);
			
			const time = Date.now() * 0.001;
			
			// Animate nodes
			nodes.forEach((node, i) => {
				node.position.y += Math.sin(time + i) * 0.002;
				node.position.x += Math.cos(time + i * 0.5) * 0.002;
				
				// Pulse effect
				const scale = 1 + Math.sin(time * 2 + i) * 0.2;
				node.scale.set(scale, scale, scale);
			});
			
			// Update connections
			connections.forEach(({ line }) => {
				const positions = line.geometry.attributes.position;
				if (positions) {
					line.geometry.attributes.position.needsUpdate = true;
				}
			});
			
			// Animate pulses moving between nodes
			pulses.forEach(pulse => {
				const target = pulse.userData.targetNode.position;
				const direction = new THREE.Vector3()
					.subVectors(target, pulse.position)
					.normalize()
					.multiplyScalar(pulse.userData.speed);
				
				pulse.position.add(direction);
				
				// Reset if reached target
				if (pulse.position.distanceTo(target) < 0.5) {
					pulse.userData.targetNode = nodes[Math.floor(Math.random() * nodes.length)];
				}
			});
			
			// Mouse interaction
			camera.position.x += (mouseX * 2 - camera.position.x) * 0.02;
			camera.position.y += (mouseY * 2 - camera.position.y) * 0.02;
			camera.lookAt(scene.position);
			
			// Scroll effect
			const scrollY = window.scrollY;
			scene.rotation.y = scrollY * 0.0002;
			
			renderer.render(scene, camera);
		}
		
		animate();

		// Resize handler
		window.addEventListener('resize', () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		});
	</script>
</Layout>
