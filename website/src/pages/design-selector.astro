---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Choose a Design">
	<main class="design-selector">
		<div class="container">
			<h1>SecureVault Marketing Website</h1>
			<p class="subtitle">Choose your preferred design approach:</p>
			
			<div class="designs">
	<a href={`${import.meta.env.BASE_URL}/cyberpunk`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">⚡</div>
					<h2>Cyberpunk Terminal</h2>
					<p>Neon accents, glitch effects, hacker aesthetic</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/particle-vault`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">🌌</div>
					<h2>3D Particle Vault</h2>
					<p>Three.js powered 3D vault with particle effects</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/morphic`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">🔮</div>
					<h2>Morphic Flow</h2>
					<p>GSAP animated liquid morphing shapes</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/holographic`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">🛡️</div>
					<h2>Holographic Shield</h2>
					<p>3D holographic shield with orbiting rings</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/neural`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">🧠</div>
					<h2>Neural Network</h2>
					<p>Network visualization with data pulses</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/liquid`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">💧</div>
					<h2>Liquid Metal</h2>
					<p>Morphing metallic blob with fluid effects</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/geometric`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">📐</div>
					<h2>Geometric Privacy</h2>
					<p>Clean geometric shapes with simple animations</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/glass`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">💎</div>
					<h2>Glass Vault</h2>
					<p>Glassmorphism with floating glass spheres</p>
					<span class="view-btn">View Design →</span>
				</a>

		<a href={`${import.meta.env.BASE_URL}/minimal`.replace(/\/\//g, '/')} class="design-card">
					<div class="icon">⚪</div>
					<h2>Minimal Clean</h2>
					<p>Simple, focused design with subtle particles</p>
					<span class="view-btn">View Design →</span>
				</a>
			</div>
		</div>
	</main>
</Layout>

<style is:inline>
	.design-selector {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		padding: 2rem;
	}

	.container {
		max-width: 1200px;
		text-align: center;
	}

	h1 {
		font-size: 3rem;
		color: white;
		margin-bottom: 0.5rem;
		font-weight: 700;
	}

	.subtitle {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 3rem;
	}

	.designs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 3rem;
	}

	.design-card {
		background: white;
		padding: 2.5rem;
		border-radius: 1rem;
		text-decoration: none;
		color: #333;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
	}

	.design-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
	}

	.icon {
		font-size: 4rem;
		margin-bottom: 1rem;
	}

	.design-card h2 {
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
		color: #667eea;
	}

	.design-card p {
		color: #666;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.view-btn {
		display: inline-block;
		color: #667eea;
		font-weight: 600;
		transition: transform 0.2s ease;
	}

	.design-card:hover .view-btn {
		transform: translateX(4px);
	}

	@media (max-width: 768px) {
		h1 {
			font-size: 2rem;
		}
		.designs {
			grid-template-columns: 1fr;
		}
	}
</style>
