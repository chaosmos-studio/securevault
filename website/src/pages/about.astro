---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
---

<Layout title="About Us - SecureVault">
  <div class="premium-container" id="main-container">
    <SiteHeader />

    <main>
      <section class="page-header">
        <h1 class="headline">
          About <span class="text-gradient">SecureVault</span>
        </h1>
        <p class="subheadline">Our mission to reclaim privacy.</p>
      </section>

      <section class="about-section glow-card">
        <h2>Why We Exist</h2>
        <p>
          SecureVault was born from a simple belief: <strong
            >privacy is a right, not a privilege.</strong
          >
        </p>
        <p>
          In an age where digital footprints are permanent and data is the new
          currency, we wanted to build a sanctuary. A place where your personal
          moments remain truly personal.
        </p>

        <h2>Hidden in Plain Sight</h2>
        <p>
          SecureVault looks like an everyday app on your phone: a calculator,
          notes, a clock or a mood journal, and each one really works. Inside,
          your photos, videos and notes are encrypted with AES-256 under a key
          made from your PIN. A second vault with its own PIN can hold
          harmless things to show if someone insists.
        </p>

        <h2>Our Promise</h2>
        <p>
          We don't collect your data and we don't track you. There are no
          accounts and no servers. Your vault lives only on your phone, and
          only your PIN opens it.
        </p>
      </section>
    </main>

    <BackToTop />
    <SiteFooter />
  </div>
</Layout>

<script>
  const wrapper = document.getElementById('main-container');
  if (wrapper) {
    wrapper.addEventListener('mousemove', e => {
      const rect = wrapper.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      wrapper.style.setProperty('--mouse-x', `${x}px`);
      wrapper.style.setProperty('--mouse-y', `${y}px`);

      document.querySelectorAll('.glow-card').forEach(card => {
        const cardRect = card.getBoundingClientRect();
        const cardX = e.clientX - cardRect.left;
        const cardY = e.clientY - cardRect.top;
        (card as HTMLElement).style.setProperty('--card-x', `${cardX}px`);
        (card as HTMLElement).style.setProperty('--card-y', `${cardY}px`);
      });
    });
  }
</script>

<style>
  main {
    padding: 6rem 5% 2rem;
    max-width: 1000px;
    margin: 0 auto;
    z-index: 2;
    position: relative;
    min-height: 80vh;
  }
  @media (min-width: 768px) {
    main {
      padding: 8rem 5% 4rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.5rem;
  }
  .text-gradient {
    background: linear-gradient(90deg, var(--accent), var(--accent-soft));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .about-section {
    padding: 4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    backdrop-filter: blur(12px);
  }

  .about-section h2 {
    font-size: 1.8rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }
  .about-section h2:first-child {
    margin-top: 0;
  }

  .about-section p {
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }
  .about-section strong {
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .about-section {
      padding: 2rem;
    }
  }
</style>
