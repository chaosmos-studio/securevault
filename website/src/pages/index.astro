---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import {
  Calculator,
  Clock,
  Smile,
  FileText,
  Lock,
  Layers,
  DoorOpen,
  MoreVertical,
} from '@lucide/astro';
---

<Layout title="SecureVault - Invisible Privacy">
  <div class="premium-container" id="main-container">
    <SiteHeader />

    <main>
      <section class="hero full-width">
        <div class="content-wrapper grid-2">
          <div class="hero-content">
            <h1 class="headline">
              Hidden in <br /><span class="reveal-text">Plain Sight.</span>
            </h1>
            <p class="subheadline">
              The privacy vault that lives a double life. Choose from 4
              innocent-looking disguises to keep your photos, videos, and
              secrets truly invisible.
            </p>

            <div class="cta-row">
              <a href="https://play.google.com/store" class="btn-primary">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="google-play-icon"
                >
                  <path
                    d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.61 3 21.09 3 20.5Z"
                  ></path>
                  <path d="M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12Z"
                  ></path>
                  <path
                    d="M20.16 10.81C20.5 11.08 20.75 11.53 20.75 12C20.75 12.47 20.5 12.92 20.16 13.19L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81Z"
                  ></path>
                  <path d="M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z"></path>
                </svg>
                <span>Download on Google Play</span>
              </a>
              <a href="#disguises" class="btn-text">See Disguises ↓</a>
            </div>
          </div>

          <div class="hero-visual">
            <div class="phone-frame glow-card">
              <div class="phone-notch"></div>
              <div class="phone-screen">
                <img
                  src={`${import.meta.env.BASE_URL}/screenshots/calculator_dark.jpeg`.replace(
                    /\/\//g,
                    '/'
                  )}
                  alt="SecureVault Calculator"
                  class="screen-img main-shot"
                />
              </div>
            </div>
            <div class="glow-backdrop"></div>
          </div>
        </div>
      </section>

      <section id="disguises" class="disguise-section full-width">
        <div class="content-wrapper">
          <div class="section-header">
            <h2>Choose Your Mask</h2>
            <p>Four distinct disguises. Four unique ways to unlock.</p>
          </div>

          <div class="disguise-container grid-2">
            <div class="disguise-controls">
              <button class="disguise-btn active" data-target="calc">
                <div class="d-icon">
                  <Calculator size={32} />
                </div>
                <div class="d-info">
                  <h3>Calculator</h3>
                  <p>Type your PIN to unlock.</p>
                </div>
              </button>

              <button class="disguise-btn" data-target="clock">
                <div class="d-icon"><Clock size={32} /></div>
                <div class="d-info">
                  <h3>Clock</h3>
                  <p>Set time as password or use alarm title.</p>
                </div>
              </button>

              <button class="disguise-btn" data-target="mood">
                <div class="d-icon"><Smile size={32} /></div>
                <div class="d-info">
                  <h3>MoodSpace</h3>
                  <p>Log your specific "mood" to enter.</p>
                </div>
              </button>

              <button class="disguise-btn" data-target="notes">
                <div class="d-icon"><FileText size={32} /></div>
                <div class="d-info">
                  <h3>Notes</h3>
                  <p>Type the secret title to open the vault.</p>
                </div>
              </button>
            </div>

            <div class="disguise-visual">
              <div class="phone-frame glow-card small">
                <div class="phone-screen bg-black">
                  <img
                    src={`${import.meta.env.BASE_URL}/screenshots/calculator_dark.jpeg`.replace(
                      /\/\//g,
                      '/'
                    )}
                    id="preview-img"
                    class="screen-img fade-in"
                    alt="Disguise Preview"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="feature-section full-width">
        <div class="content-wrapper grid-2-imbalanced-left">
          <div class="feature-visual">
            <div class="vault-stack hover-trigger">
              <div class="vault-card v3">Family Vault</div>
              <div class="vault-card v2">Work Vault</div>
              <div class="vault-card v1 glow-card">
                <div class="lock-icon"><Lock size={32} /></div>
                <span>Admin Vault</span>
              </div>
            </div>
          </div>
          <div class="feature-text">
            <div class="feature-icon"><Layers size={48} /></div>
            <h2>Multiple Vaults</h2>
            <p>
              Create unlimited vaults. If forced to unlock, open a <strong
                >separate vault</strong
              > to show empty or fake content while keeping your real data safe.
            </p>
            <p class="hint-text">Hover over the stack to see all vaults.</p>
          </div>
        </div>
      </section>

      <section class="feature-section full-width">
        <div class="content-wrapper grid-2-imbalanced-right">
          <div class="feature-text">
            <div class="feature-icon"><DoorOpen size={48} /></div>
            <h2>The Secret Backdoor</h2>
            <p>
              Every disguise has a hidden entry. Tap the <strong
                >three dots</strong
              > menu, select "Request a Feature", and type your password there. You're
              in.
            </p>
          </div>
          <div class="feature-visual">
            <div class="menu-mockup glow-card">
              <div class="menu-header">
                <span>Settings</span>
                <span class="dots"><MoreVertical size={20} /></span>
              </div>
              <div class="menu-dropdown">
                <a
                  href={`${import.meta.env.BASE_URL}/about`.replace(
                    /\/\//g,
                    '/'
                  )}
                  class="menu-item clickable">About Us</a
                >
                <a
                  href={`${import.meta.env.BASE_URL}/support#contact`.replace(
                    /\/\//g,
                    '/'
                  )}
                  class="menu-item clickable">Contact Us</a
                >
                <a
                  href={`${import.meta.env.BASE_URL}/support#request`.replace(
                    /\/\//g,
                    '/'
                  )}
                  class="menu-item highlight clickable">Request a Feature</a
                >
              </div>
            </div>
            <p class="hint-text center-hint">
              Try clicking the menu items above.
            </p>
          </div>
        </div>
      </section>
    </main>

    <BackToTop />
    <SiteFooter />
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll('.disguise-btn');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const heroImg = document.querySelector('.hero-visual .screen-img') as HTMLImageElement;

  const images: Record<string, { light: string; dark: string }> = {
    calc: {
      light: `${import.meta.env.BASE_URL}/screenshots/calculator_light.jpeg`.replace(/\/\//g, '/'),
      dark: `${import.meta.env.BASE_URL}/screenshots/calculator_dark.jpeg`.replace(/\/\//g, '/'),
    },
    clock: {
      light: `${import.meta.env.BASE_URL}/screenshots/clock_light.jpeg`.replace(/\/\//g, '/'),
      dark: `${import.meta.env.BASE_URL}/screenshots/clock_dark.jpeg`.replace(/\/\//g, '/'),
    },
    mood: {
      light: `${import.meta.env.BASE_URL}/screenshots/moodspace_light.jpeg`.replace(/\/\//g, '/'),
      dark: `${import.meta.env.BASE_URL}/screenshots/moodspace_dark.jpeg`.replace(/\/\//g, '/'),
    },
    notes: {
      light: `${import.meta.env.BASE_URL}/screenshots/notes_light.jpeg`.replace(/\/\//g, '/'),
      dark: `${import.meta.env.BASE_URL}/screenshots/notes_dark.jpeg`.replace(/\/\//g, '/'),
    },
  };

  let currentTarget = 'calc';

  function getTheme(): 'light' | 'dark' {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function updateImages() {
    const theme = getTheme();
    const targetImages = images[currentTarget];
    
    if (!targetImages) return;

    const newSrc = targetImages[theme];

    // Update preview section image
    if (previewImg && previewImg.src !== newSrc && !previewImg.src.endsWith(newSrc)) {
      previewImg.style.opacity = '0.5';
      setTimeout(() => {
        previewImg.src = newSrc;
        previewImg.style.opacity = '1';
      }, 100);
    }

    // Update hero image (always calculator)
    if (heroImg) {
      const heroSrc = images['calc'][theme];
      if (heroImg.src !== heroSrc && !heroImg.src.endsWith(heroSrc)) {
        heroImg.src = heroSrc;
      }
    }
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const target = btn.getAttribute('data-target');
      if (target) {
        currentTarget = target;
        updateImages();
      }
    });

    btn.addEventListener('mouseenter', () => {
      const target = btn.getAttribute('data-target');
      if (target) {
        currentTarget = target;
        updateImages();
      }
    });
  });

  // Observe theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        updateImages();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  // Initial update
  updateImages();

  const vaultStack = document.querySelector('.vault-stack');
  vaultStack?.addEventListener('click', () => {
    vaultStack.classList.toggle('expanded');
  });
</script>

<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg-main);
    color: var(--text-main);
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-x: hidden;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  img {
    max-width: 100%;
    display: block;
  }
  a {
    text-decoration: none;
    color: inherit;
  }

  .premium-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .full-width {
    width: 100%;
    padding: 2rem 1.5rem;
    position: relative;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .full-width {
      padding: 4rem 5%;
    }
  }

  .content-wrapper {
    max-width: 1150px;
    margin: 0 auto;
  }

  .grid-2 {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .grid-2-imbalanced-left {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .grid-2-imbalanced-left {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
    }
  }

  .grid-2-imbalanced-right {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .grid-2-imbalanced-right {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
    }
  }

  .glow-card {
    position: relative;
  }
  .glow-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      600px circle at var(--card-x, 50%) var(--card-y, 50%),
      rgba(255, 255, 255, 0.3),
      transparent 40%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 10;
    opacity: 0.7;
  }

  .hero {
    padding-top: 6rem !important;
    min-height: auto;
    padding-bottom: 4rem;
    display: flex;
    align-items: center;
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: 10rem;
      min-height: 90vh;
    }
  }

  .headline {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .reveal-text {
    background: linear-gradient(90deg, var(--accent), #a855f7);
    -webkit-background-clip: text;
    color: transparent;
  }
  .subheadline {
    font-size: 1.2rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .badge-pill {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent);
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .btn-primary {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-main);
    padding: 0.9rem 1.8rem;
    border-radius: 50px;
    font-weight: 600;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    transition: all 0.3s ease;
    z-index: 2;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }
  .btn-primary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }
  .btn-text {
    font-weight: 600;
    text-decoration: none;
    border-bottom: none;
  }
  .btn-text:hover {
    opacity: 0.8;
  }

  .google-play-icon {
    flex-shrink: 0;
  }

  .phone-frame {
    width: 300px;
    height: 600px;
    background: #000;
    border-radius: 40px;
    border: 8px solid #222;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    z-index: 2;
    overflow: hidden;
  }
  [data-theme='light'] .phone-frame {
    border-color: #ddd;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  }

  .phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 25px;
    background: #000;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    z-index: 5;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #111;
  }
  .screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }
  .bg-black {
    background: #000;
  }

  .glow-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 80%;
    background: var(--accent);
    opacity: 0.15;
    filter: blur(100px);
    z-index: 0;
    pointer-events: none;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-header h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .section-header p {
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  .disguise-section .disguise-container.grid-2 {
    gap: 2.5rem;
    grid-template-columns: 1fr;
    justify-items: center;
  }

  @media (min-width: 768px) {
    .disguise-section .disguise-container.grid-2 {
      gap: 3rem;
      grid-template-columns: minmax(300px, 450px) minmax(300px, 450px);
      justify-content: center;
      justify-items: start;
    }
  }

  .disguise-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 400px;
  }

  .disguise-btn {
    background: transparent;
    border: 1px solid transparent;
    padding: 1.5rem;
    border-radius: 1rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    text-align: left;
    cursor: pointer;
    color: var(--text-main);
    transition: all 0.3s ease;
  }
  .disguise-btn:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  [data-theme='light'] .disguise-btn:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  .disguise-btn.active {
    background: linear-gradient(
      145deg,
      var(--card-bg),
      rgba(59, 130, 246, 0.1)
    );
    border: 1px solid var(--accent);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
  }

  .d-icon {
    font-size: 2rem;
  }
  .d-info h3 {
    margin: 0 0 0.2rem 0;
    font-size: 1.1rem;
  }
  .d-info p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .feature-text h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .feature-text p {
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  .hint-text {
    font-size: 0.9rem;
    opacity: 0.6;
    font-style: italic;
  }
  .center-hint {
    text-align: center;
    margin-top: 1rem;
  }

  .vault-stack {
    position: relative;
    height: 300px;
    width: 300px;
    margin: 0 auto;
    cursor: pointer;
    perspective: 1000px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .vault-card {
    width: 100%;
    height: 200px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition:
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.27),
      opacity 0.4s ease;
    transform-origin: center bottom;
  }

  .v3 {
    transform: scale(0.9) translateY(-10px);
    opacity: 0.6;
    z-index: 1;
  }
  .v2 {
    transform: scale(0.95) translateY(-5px);
    opacity: 0.8;
    z-index: 2;
  }
  .v1 {
    transform: scale(1) translateY(0);
    z-index: 3;
    border-color: var(--accent);
    color: var(--accent);
    font-weight: bold;
  }

  .vault-stack:hover .v3,
  .vault-stack.expanded .v3 {
    transform: translateX(110px) rotate(5deg) scale(0.95);
    opacity: 1;
    border-color: rgba(255, 100, 100, 0.5);
    z-index: 4;
  }
  .vault-stack:hover .v2,
  .vault-stack.expanded .v2 {
    transform: translateX(-110px) rotate(-5deg) scale(0.95);
    opacity: 1;
    border-color: rgba(255, 255, 100, 0.5);
    z-index: 4;
  }
  .vault-stack:hover .v1,
  .vault-stack.expanded .v1 {
    transform: scale(1);
    box-shadow: 0 20px 50px rgba(59, 130, 246, 0.2);
  }

  .lock-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .menu-mockup {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 15px;
    width: 280px;
    margin: 0 auto;
    overflow: hidden;
  }
  .menu-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    font-weight: bold;
  }
  .menu-item {
    display: block;
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    transition: background 0.2s;
  }
  .menu-item.clickable:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
  }
  [data-theme='light'] .menu-item.clickable:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .menu-item.highlight {
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent);
    font-weight: 500;
  }
  .menu-item.highlight:hover {
    background: rgba(59, 130, 246, 0.2);
  }
</style>
