---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SecureVault - Invisible Privacy">
    <div class="premium-container" id="main-container">
        <!-- Spotlight Overlay -->
        <div class="spotlight-overlay"></div>

        <!-- Navigation & Theme Toggle -->
        <nav class="nav glass-panel">
            <div class="logo">
                <span class="logo-icon">🛡️</span> SecureVault
            </div>
            <div class="nav-right">
                <a href="https://play.google.com/store" class="download-link">Get the App</a>
                <button id="theme-toggle" class="theme-btn" aria-label="Toggle Dark Mode">
                    <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
            </div>
        </nav>

        <main>
            <!-- Hero Section -->
            <section class="hero">
                <div class="hero-content">
                    <div class="badge-pill">V2.0 Available Now</div>
                    <h1 class="headline">Hidden in <br/><span class="reveal-text">Plain Sight.</span></h1>
                    <p class="subheadline">The privacy vault that lives a double life. Choose from 4 innocent-looking disguises to keep your photos, videos, and secrets truly invisible.</p>
                    
                    <div class="cta-row">
                        <a href="https://play.google.com/store" class="btn-primary">
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path></svg>
                             <span>Download on Google Play</span>
                        </a>
                        <a href="#disguises" class="btn-text">See Disguises ↓</a>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="phone-frame glow-card">
                        <div class="phone-notch"></div>
                        <div class="phone-screen">
                            <img src={`${import.meta.env.BASE_URL}/screenshots/calculator-disguise.png`.replace(/\/\//g, '/')} alt="SecureVault Calculator" class="screen-img main-shot"/>
                        </div>
                    </div>
                    <div class="glow-backdrop"></div>
                </div>
            </section>

            <!-- Disguise Selector Section -->
            <section id="disguises" class="disguise-section">
                <div class="section-header">
                    <h2>Choose Your Mask</h2>
                    <p>Four distinct disguises. Four unique ways to unlock.</p>
                </div>

                <div class="disguise-container">
                    <!-- Text / Triggers Side -->
                    <div class="disguise-controls">
                        <button class="disguise-btn active" data-target="calc">
                            <div class="d-icon">🔢</div>
                            <div class="d-info">
                                <h3>Calculator</h3>
                                <p>Type your PIN to unlock.</p>
                            </div>
                        </button>

                        <button class="disguise-btn" data-target="clock">
                            <div class="d-icon">⏰</div>
                            <div class="d-info">
                                <h3>Clock</h3>
                                <p>Set time as password or use alarm title.</p>
                            </div>
                        </button>

                        <button class="disguise-btn" data-target="mood">
                            <div class="d-icon">😊</div>
                            <div class="d-info">
                                <h3>Moodspace</h3>
                                <p>Log your specific "mood" to enter.</p>
                            </div>
                        </button>
                        
                        <button class="disguise-btn" data-target="notes">
                            <div class="d-icon">📝</div>
                            <div class="d-info">
                                <h3>Notes</h3>
                                <p>Type the secret title to open the vault.</p>
                            </div>
                        </button>
                    </div>

                    <!-- Visual Side -->
                    <div class="disguise-visual">
                         <div class="phone-frame glow-card small">
                            <div class="phone-screen bg-black">
                                <img src={`${import.meta.env.BASE_URL}/screenshots/calculator-disguise.png`.replace(/\/\//g, '/')} id="preview-img" class="screen-img fade-in" alt="Disguise Preview"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Multiple Vaults Feature -->
            <section class="feature-section left-aligned">
                <div class="feature-visual">
                    <div class="vault-stack">
                        <div class="vault-card v3">Isolatated Vault</div>
                        <div class="vault-card v2">Decoy Vault</div>
                        <div class="vault-card v1 glow-card">
                            <div class="lock-icon">🔒</div>
                            <span>Primary Vault</span>
                        </div>
                    </div>
                </div>
                <div class="feature-text">
                    <div class="feature-icon">⛓️</div>
                    <h2>Multiple Vaults</h2>
                    <p>Create unlimited vaults. If forced to unlock, open a <strong>Decoy Vault</strong> to show empty or fake content while keeping your real data safe.</p>
                </div>
            </section>

            <!-- Backdoor / Special Feature -->
            <section class="feature-section right-aligned">
                <div class="feature-text">
                    <div class="feature-icon">🚪</div>
                    <h2>The Secret Backdoor</h2>
                    <p>Every disguise has a hidden entry. Tap the <strong>three dots</strong> menu, select "Request a Feature", and type your password there. You're in.</p>
                </div>
                <div class="feature-visual">
                    <div class="menu-mockup glow-card">
                        <div class="menu-header">
                            <span>Settings</span>
                            <span class="dots">⋮</span>
                        </div>
                        <div class="menu-dropdown">
                            <div class="menu-item">About Us</div>
                            <div class="menu-item">Contact Us</div>
                            <div class="menu-item highlight">Request a Feature</div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <div class="footer-grid">
                <div class="col">
                    <h3>SecureVault</h3>
                    <p>Privacy is a human right.</p>
                </div>
                <div class="col">
                    <h4>Download</h4>
                    <a href="https://play.google.com/store">Android App</a>
                </div>
            </div>
            <div class="footer-bottom">
                 © 2026 SecureVault Inc. All rights reserved.
            </div>
        </footer>
    </div>
</Layout>

<script>
    // 1. THEME LOGIC
    const themeBtn = document.getElementById('theme-toggle');
    const root = document.documentElement;

    // Function to apply theme
    function applyTheme(theme) {
        root.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        
        // Update Icons
        const sun = document.querySelector('.sun-icon');
        const moon = document.querySelector('.moon-icon');
        if(theme === 'light') {
            if(sun) (sun as HTMLElement).style.display = 'block';
            if(moon) (moon as HTMLElement).style.display = 'none';
        } else {
            if(sun) (sun as HTMLElement).style.display = 'none';
            if(moon) (moon as HTMLElement).style.display = 'block';
        }
    }

    // Initialize
    const savedTheme = localStorage.getItem('theme');
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    applyTheme(savedTheme || systemTheme);

    // Toggle
    themeBtn?.addEventListener('click', () => {
        const currentTheme = root.getAttribute('data-theme');
        applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
    });

    // 2. DISGUISE TAB SWITCHER
    const buttons = document.querySelectorAll('.disguise-btn');
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    
    // Map IDs to Filenames (Adjust paths if needed)
    const images: Record<string, string> = {
        'calc': `${import.meta.env.BASE_URL}/screenshots/calculator-disguise.png`.replace(/\/\//g, '/'),
        'clock': `${import.meta.env.BASE_URL}/screenshots/clock.png`.replace(/\/\//g, '/'),
        'mood': `${import.meta.env.BASE_URL}/screenshots/moodspace.png`.replace(/\/\//g, '/'),
        'notes': `${import.meta.env.BASE_URL}/screenshots/notes.png`.replace(/\/\//g, '/')
    };

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            // Remove active class from all
            buttons.forEach(b => b.classList.remove('active'));
            // Add to clicked
            btn.classList.add('active');
            
            // Change Image
            const target = btn.getAttribute('data-target');
            if(target && images[target]) {
                previewImg.style.opacity = '0';
                setTimeout(() => {
                    previewImg.src = images[target];
                    previewImg.style.opacity = '1';
                }, 200);
            }
        });
    });

    // 3. MOUSE SPOTLIGHT GLOW
    const wrapper = document.getElementById('main-container');
    if(wrapper) {
        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            // Update global spotlight position
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);

            // Optional: Individual card glow logic
            const cards = document.querySelectorAll('.glow-card, .btn-primary, .disguise-btn, .vault-card');
            cards.forEach(card => {
                const cardRect = card.getBoundingClientRect();
                const cardX = e.clientX - cardRect.left;
                const cardY = e.clientY - cardRect.top;
                (card as HTMLElement).style.setProperty('--card-x', `${cardX}px`);
                (card as HTMLElement).style.setProperty('--card-y', `${cardY}px`);
            });
        });
    }
</script>

<style>
    /* ==================== VARIABLES ==================== */
    :root {
        /* Default Dark */
        --bg-main: #050505;
        --bg-glass: rgba(20, 20, 20, 0.6);
        --text-main: #ffffff;
        --text-muted: #888888;
        --accent: #3b82f6;
        --border: rgba(255, 255, 255, 0.1);
        --glow: rgba(255, 255, 255, 0.1);
        --card-bg: #0a0a0a;
    }

    [data-theme="light"] {
        --bg-main: #f0f2f5;
        --bg-glass: rgba(255, 255, 255, 0.8);
        --text-main: #111111;
        --text-muted: #555555;
        --accent: #0066cc;
        --border: rgba(0, 0, 0, 0.1);
        --glow: rgba(0, 0, 0, 0.05); /* Softer glow for light mode */
        --card-bg: #ffffff;
    }

    /* ==================== GLOBAL ==================== */
    * { box-sizing: border-box; }
    
    html, body {
        margin: 0; padding: 0;
        background: var(--bg-main);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        overflow-x: hidden;
        transition: background 0.3s ease, color 0.3s ease;
    }
    
    img { max-width: 100%; display: block; }
    a { text-decoration: none; color: inherit; }

    .premium-container {
        position: relative;
        max-width: 1400px;
        margin: 0 auto;
        min-height: 100vh;
        overflow: hidden; /* For spotlight containment */
    }

    /* ==================== SPOTLIGHT ==================== */
    .spotlight-overlay {
        position: absolute;
        top: 0; left: 0; 
        width: 100%; height: 100%;
        pointer-events: none;
        background: radial-gradient(
            800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
            var(--glow),
            transparent 40%
        );
        z-index: 1;
        mix-blend-mode: screen; /* Nice blending */
    }
    [data-theme="light"] .spotlight-overlay {
        mix-blend-mode: plus-lighter;
    }

    /* Glow Cards (Inner Shine) */
    .glow-card {
        position: relative;
    }
    .glow-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: inherit;
        padding: 1px;
        background: radial-gradient(
            600px circle at var(--card-x, 50%) var(--card-y, 50%),
            rgba(255, 255, 255, 0.3),
            transparent 40%
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        z-index: 10;
        opacity: 0.7;
    }

    /* ==================== NAV ==================== */
    .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        padding: 1rem 5%;
        display: flex; justify-content: space-between; align-items: center;
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        z-index: 100;
    }
    .logo { font-weight: 700; font-size: 1.2rem; display: flex; align-items: center; gap: 0.5rem; }
    .nav-right { display: flex; gap: 1rem; align-items: center; }
    
    .theme-btn {
        background: transparent; border: 1px solid var(--border);
        color: var(--text-main);
        padding: 0.5rem; border-radius: 50%;
        cursor: pointer; display: flex; align-items: center;
        transition: all 0.2s;
    }
    .theme-btn:hover { background: var(--border); }

    /* ==================== HERO ==================== */
    .hero {
        padding: 8rem 5% 4rem 5%;
        display: grid;
        gap: 4rem;
        align-items: center;
        min-height: 90vh;
    }
    @media (min-width: 1024px) { .hero { grid-template-columns: 1fr 1fr; } }

    .headline { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.1; margin-bottom: 1.5rem; }
    .reveal-text { 
        background: linear-gradient(90deg, var(--accent), #a855f7); 
        -webkit-background-clip: text; color: transparent; 
    }
    .subheadline { font-size: 1.2rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 2rem; max-width: 500px; }
    
    .badge-pill {
        display: inline-block; padding: 0.4rem 1rem;
        background: rgba(59, 130, 246, 0.1); color: var(--accent);
        border-radius: 50px; font-weight: 600; font-size: 0.8rem;
        margin-bottom: 1.5rem; border: 1px solid var(--border);
    }

    .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
    .btn-primary {
        background: var(--text-main); color: var(--bg-main);
        padding: 0.9rem 1.8rem; border-radius: 50px;
        font-weight: 600; display: flex; gap: 0.5rem; align-items: center;
        transition: transform 0.2s;
        z-index: 2; /* Clickable above spotlight */
    }
    .btn-primary:hover { transform: translateY(-2px); }
    .btn-text { font-weight: 600; border-bottom: 1px solid transparent; }
    .btn-text:hover { border-bottom-color: var(--text-main); }

    /* Phone Device */
    .phone-frame {
        width: 300px; height: 600px;
        background: #000;
        border-radius: 40px;
        border: 8px solid #222;
        margin: 0 auto;
        position: relative;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
        z-index: 2; overflow: hidden;
    }
    [data-theme="light"] .phone-frame { border-color: #ddd; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.2); }
    
    .phone-notch {
        position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 120px; height: 25px; background: #000;
        border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
        z-index: 5;
    }
    .phone-screen { width: 100%; height: 100%; object-fit: cover; background: #111; }
    .screen-img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.3s ease; }
    .bg-black { background: #000; }

    .glow-backdrop {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 120%; height: 80%;
        background: var(--accent); opacity: 0.15; filter: blur(100px);
        z-index: 0; pointer-events: none;
    }

    /* ==================== DISGUISE SECTION ==================== */
    .disguise-section {
        padding: 6rem 5%;
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }
    
    .section-header { text-align: center; margin-bottom: 4rem; }
    .section-header h2 { font-size: 2.5rem; margin-bottom: 1rem; }
    .section-header p { color: var(--text-muted); font-size: 1.2rem; }

    .disguise-container {
        display: grid; gap: 4rem;
        max-width: 1000px; margin: 0 auto;
    }
    @media (min-width: 900px) { .disguise-container { grid-template-columns: 1fr 1fr; align-items: center; } }

    /* Controls */
    .disguise-controls { display: flex; flex-direction: column; gap: 1rem; }
    
    .disguise-btn {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 1.5rem; border-radius: 1rem;
        display: flex; gap: 1.5rem; align-items: center;
        text-align: left; cursor: pointer;
        transition: all 0.3s ease;
    }
    .disguise-btn:hover { transform: translateX(10px); border-color: var(--accent); }
    .disguise-btn.active {
        background: linear-gradient(145deg, var(--card-bg), rgba(59, 130, 246, 0.1));
        border-color: var(--accent);
        box-shadow: 0 0 20px rgba(59, 130, 246, 0.15);
    }
    
    .d-icon { font-size: 2rem; }
    .d-info h3 { margin: 0 0 0.2rem 0; font-size: 1.1rem; }
    .d-info p { margin: 0; color: var(--text-muted); font-size: 0.9rem; }

    /* ==================== FEATURES ==================== */
    .feature-section {
        padding: 8rem 5%;
        display: grid; gap: 4rem; align-items: center;
        max-width: 1100px; margin: 0 auto;
    }
    @media (min-width: 900px) {
        .feature-section { grid-template-columns: 1fr 1fr; }
    }

    .feature-text h2 { font-size: 2.5rem; margin-bottom: 1rem; }
    .feature-text p { color: var(--text-muted); font-size: 1.1rem; line-height: 1.6; }
    .feature-icon { font-size: 3rem; margin-bottom: 1.5rem; }

    /* Vault Stack Visual */
    .vault-stack { position: relative; height: 300px; width: 300px; margin: 0 auto; }
    .vault-card {
        width: 100%; height: 200px;
        background: var(--card-bg); border: 1px solid var(--border);
        border-radius: 20px;
        position: absolute; left: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .v3 { top: 0; transform: scale(0.9) translateY(-40px); opacity: 0.5; z-index: 1; }
    .v2 { top: 20px; transform: scale(0.95) translateY(-20px); opacity: 0.8; z-index: 2; }
    .v1 { top: 40px; z-index: 3; border-color: var(--accent); color: var(--accent); font-weight: bold; }
    .lock-icon { font-size: 2rem; margin-bottom: 0.5rem; }

    /* Menu Mockup */
    .menu-mockup {
        background: var(--card-bg); border: 1px solid var(--border);
        border-radius: 15px; width: 280px; margin: 0 auto;
        overflow: hidden;
    }
    .menu-header {
        padding: 1rem; border-bottom: 1px solid var(--border);
        display: flex; justify-content: space-between; font-weight: bold;
    }
    .menu-item { padding: 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); }
    .menu-item.highlight { background: rgba(59, 130, 246, 0.1); color: var(--accent); font-weight: 500; }

    /* Footer */
    .site-footer {
        margin-top: 8rem; padding: 4rem 5% 2rem;
        background: rgba(0,0,0,0.2); border-top: 1px solid var(--border);
    }
    .footer-grid { display: flex; gap: 4rem; margin-bottom: 3rem; }
    .footer-bottom { text-align: center; color: var(--text-muted); font-size: 0.9rem; padding-top: 2rem; border-top: 1px solid var(--border); }
</style>
