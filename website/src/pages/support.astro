---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Giscus from '../components/Giscus.astro';
import BackToTop from '../components/BackToTop.astro';
import { Mail, MessageCircle } from '@lucide/astro';
---

<Layout title="Support - SecureVault">
  <div class="premium-container" id="main-container">
    <SiteHeader />

    <main>
      <section class="page-header">
        <h1 class="headline">
          Help & <span class="text-gradient">Support</span>
        </h1>
        <p class="subheadline">Got questions? We've got answers.</p>
      </section>

      <div class="support-grid">
        <div class="support-card glow-card contact-card" id="contact">
          <div class="card-icon"><Mail size={48} /></div>
          <h3>Contact Us</h3>
          <p>
            Need personal assistance? Have questions or feedback? We're here to
            help! Reach out and we'll get back to you within 24 hours.
          </p>
          <a href="mailto:hello@chaosmos.studio" class="contact-btn"
            >hello@chaosmos.studio</a
          >
        </div>
      </div>

      <section id="faqs" class="faq-section">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="faq-list">
          <details class="faq-item glow-card">
            <summary>Is my data really secure?</summary>
            <p>
              Absolutely. SecureVault uses military-grade AES-256 encryption to
              protect your files. Your data is stored locally on your device and
              is never uploaded to any server, ensuring complete privacy.
            </p>
          </details>

          <details class="faq-item glow-card">
            <summary>What happens if I forget my password?</summary>
            <p>
              <strong>Important:</strong> SecureVault uses a zero-knowledge architecture,
              which means your password is never stored on our servers or anywhere
              else. We cannot recover or reset your password.
            </p>
            <p>
              If you forget your password, you will lose access to your
              encrypted data permanently. We strongly recommend:
            </p>
            <ul>
              <li>
                Writing down your password and storing it in a secure physical
                location
              </li>
              <li>Using a trusted password manager</li>
              <li>Creating a memorable but strong password you won't forget</li>
            </ul>
            <p>
              This trade-off ensures maximum security - even we cannot access
              your data, which is the foundation of true privacy.
            </p>
          </details>

          <details class="faq-item glow-card">
            <summary>What is Disguise Mode?</summary>
            <p>
              Disguise Mode allows you to change the app's icon and name (e.g.,
              to a Calculator) to hide it from prying eyes.
            </p>
          </details>

          <details class="faq-item glow-card">
            <summary>Does SecureVault support FaceID/TouchID?</summary>
            <p>
              No, our app does not support this. We believe in providing the
              highest level of security through master password authentication
              only.
            </p>
          </details>

          <details class="faq-item glow-card">
            <summary>Can I hide photos and videos?</summary>
            <p>
              Yes. You can import photos and videos directly from your gallery
              into SecureVault. Once imported, they are encrypted and hidden
              from your main gallery.
            </p>
          </details>
        </div>
      </section>

      <section id="community" class="community-section">
        <div class="community-header">
          <div class="community-icon"><MessageCircle size={40} /></div>
          <h2 class="section-title">Community Discussion</h2>
          <p class="community-subtitle">
            Ask questions, share ideas, or request features. Join the
            conversation!
          </p>
        </div>
        <div class="giscus-container">
          <Giscus mapping="pathname" />
        </div>
      </section>
    </main>

    <BackToTop />
    <SiteFooter />
  </div>
</Layout>

<script></script>

<style>
  html {
    scroll-behavior: smooth;
  }

  main {
    padding: 6rem 5% 2rem;
    max-width: 1200px;
    margin: 0 auto;
    z-index: 2;
    position: relative;
  }
  @media (min-width: 768px) {
    main {
      padding: 8rem 5% 4rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 0.5rem;
  }
  .subheadline {
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  .support-grid {
    display: flex;
    justify-content: center;
    margin-bottom: 5rem;
  }

  .support-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
    max-width: 600px;
    width: 100%;
  }
  .support-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px -12px rgba(59, 130, 246, 0.3);
    border-color: var(--accent);
  }

  .contact-card {
    text-align: center;
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    color: var(--accent);
  }
  .support-card h3 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    color: var(--text-main);
  }
  .support-card p {
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 1.5rem;
    font-size: 1rem;
  }
  .contact-btn {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }
  .contact-btn:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
  }

  .no-decoration {
    text-decoration: none;
    display: block;
    color: inherit;
  }

  .faq-section {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    padding-top: 4rem;
  }

  .section-title {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 3rem;
    color: var(--text-main);
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    background: rgba(var(--bg-surface-rgb), 0.3);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item[open] {
    background: transparent;
    border-bottom-color: var(--accent);
  }

  .faq-item summary {
    padding: 1.5rem 1rem;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-main);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    position: relative;
    z-index: 20;
    transition: color 0.2s;
  }

  .faq-item:hover summary {
    color: var(--accent);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    transition:
      transform 0.2s,
      color 0.2s;
    color: var(--text-muted);
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .faq-item p {
    margin: 0 0 0.75rem 0;
    padding: 0 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    width: 100%;
    animation: fadeIn 0.3s ease-out;
  }

  .faq-item p:last-child {
    padding-bottom: 1.5rem;
  }

  .faq-item ul {
    margin: 0.75rem 0;
    padding-left: 2.5rem;
    color: var(--text-muted);
  }

  .faq-item li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .faq-item strong {
    color: var(--accent);
    font-weight: 600;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .community-section {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    padding-top: 4rem;
  }

  .community-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .community-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--accent);
  }

  .community-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .giscus-container {
    max-width: 800px;
    margin: 0 auto;
  }
</style>
