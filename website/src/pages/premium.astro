---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SecureVault - Premium">
    <div class="premium-container">
        <!-- Navigation & Theme Toggle -->
        <nav class="nav glass-panel">
            <div class="logo">SecureVault</div>
            <div class="nav-right">
                <a href="https://play.google.com/store" class="download-link">Get the App</a>
                <button id="theme-toggle" class="theme-btn" aria-label="Toggle Dark Mode">
                    <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                </button>
            </div>
        </nav>

        <main>
            <!-- Hero Section -->
            <section class="hero">
                <div class="hero-content">
                    <div class="badge-pill">V2.0 Available Now</div>
                    <h1 class="headline">Hidden in <br/><span class="reveal-text">Plain Sight.</span></h1>
                    <p class="subheadline">The privacy vault that lives a double life. A fully functional calculator on the surface, a fortress underneath.</p>
                    
                    <div class="cta-row">
                        <a href="#" class="btn-primary">
                             <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path></svg>
                             <span>Download on Google Play</span>
                        </a>
                        <a href="#features" class="btn-text">Learn more ↓</a>
                    </div>
                </div>

                <div class="hero-visual">
                    <!-- CSS Phone Mockup -->
                    <div class="phone-frame">
                        <div class="phone-notch"></div>
                        <div class="phone-screen">
                            <!-- TODO: User to insert "Lock Screen" or "Home Screen" screenshot here -->
                            <!-- Placeholder Content -->
                            <div class="placeholder-ui">
                                <div class="lock-glyph">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                </div>
                                <div class="time">12:45</div>
                                <div class="date">Tuesday, January 20</div>
                            </div>
                        </div>
                    </div>
                    <div class="glow-backdrop"></div>
                </div>
            </section>

            <!-- Feature 1: The Disguise (Left Text, Right Image) -->
            <section id="features" class="feature-section right-aligned">
                <div class="feature-text">
                    <div class="feature-icon">🔢</div>
                    <h2>The Perfect Disguise</h2>
                    <p>To the outside world, it's just a calculator. It performs real math. It has no suspicious settings. It blends seamlessly into your app drawer.</p>
                </div>
                <div class="feature-visual">
                    <div class="phone-frame small">
                        <div class="phone-screen calculator-theme">
                            <!-- TODO: User to insert "Calculator UI" screenshot here -->
                            <div class="calc-grid-mockup">
                                <span>7</span><span>8</span><span>9</span><span class="op">×</span>
                                <span>4</span><span>5</span><span>6</span><span class="op">-</span>
                                <span>1</span><span>2</span><span>3</span><span class="op">+</span>
                                <span class="zero">0</span><span>.</span><span class="accent">=</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Feature 2: The Unlock (Right Text, Left Image) -->
            <section class="feature-section left-aligned">
                <div class="feature-visual">
                    <div class="biometric-visual">
                        <div class="fingerprint-scan"></div>
                        <div class="shield-layer"></div>
                    </div>
                </div>
                <div class="feature-text">
                    <div class="feature-icon">🔓</div>
                    <h2>The Magic Number</h2>
                    <p>Enter your secret PIN followed by <span class="code-snippet">%</span>, and the interface transforms instantly. Your private vault is revealed.</p>
                </div>
            </section>

            <!-- Feature 3: Intruder Selfie -->
            <section class="feature-section centered">
                <div class="feature-content-stacked">
                    <div class="feature-icon">📸</div>
                    <h2>Caught in the Act</h2>
                    <p>If someone tries to snoop, SecureVault silently captures their photo using the front camera. You'll know exactly who tried to access your data.</p>
                    
                    <div class="polaroid-stack">
                        <div class="polaroid p1"></div>
                        <div class="polaroid p2"></div>
                        <div class="polaroid p3">
                            <div class="lens-icon"></div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer class="site-footer">
            <div class="footer-grid">
                <div class="col">
                    <h3>SecureVault</h3>
                    <p>Privacy is a human right.</p>
                </div>
                <div class="col">
                    <h4>Legals</h4>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>
                <div class="col">
                    <h4>Connect</h4>
                    <a href="#">Twitter/X</a>
                    <a href="#">Support</a>
                </div>
            </div>
            <div class="footer-bottom">
                 © 2026 SecureVault Inc.
            </div>
        </footer>
    </div>
</Layout>

<script>
    // Theme Toggling Logic
    const themeBtn = document.getElementById('theme-toggle');
    const root = document.documentElement; // <html> element

    // Check local storage or system preference
    const savedTheme = localStorage.getItem('theme');
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    
    // Set initial theme
    if (savedTheme) {
        root.setAttribute('data-theme', savedTheme);
    } else {
        root.setAttribute('data-theme', systemTheme);
    }

    themeBtn?.addEventListener('click', () => {
        const currentTheme = root.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        
        root.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
    });
</script>

<style>
    /* 
     * ==========================================
     *  THEME VARIABLES
     * ==========================================
     */
    :root {
        /* Dark Theme Default */
        --bg-main: #0a0a0a;
        --bg-surface: #121212;
        --bg-surface-2: #1c1c1c;
        --text-primary: #ffffff;
        --text-secondary: #a1a1aa;
        --accent: #3b82f6;
        --accent-glow: rgba(59, 130, 246, 0.4);
        --border: rgba(255, 255, 255, 0.1);
        --nav-glass: rgba(10, 10, 10, 0.8);
        --shadow-soft: 0 20px 40px rgba(0,0,0,0.5);
    }

    [data-theme="light"] {
        --bg-main: #ffffff;
        --bg-surface: #f5f5f7;
        --bg-surface-2: #e5e5ea;
        --text-primary: #1d1d1f;
        --text-secondary: #86868b;
        --accent: #0071e3;
        --accent-glow: rgba(0, 113, 227, 0.2);
        --border: rgba(0, 0, 0, 0.1);
        --nav-glass: rgba(255, 255, 255, 0.8);
        --shadow-soft: 0 20px 40px rgba(0,0,0,0.1);
    }

    /* Base Reset */
    * { box-sizing: border-box; }
    body {
        margin: 0;
        background: var(--bg-main);
        color: var(--text-primary);
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
        transition: background 0.3s ease, color 0.3s ease;
        line-height: 1.5;
        overflow-x: hidden;
    }

    a { text-decoration: none; color: inherit; }

    /* Layout Container */
    .premium-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 5%;
    }

    /* Navigation */
    .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 5%;
        z-index: 1000;
        backdrop-filter: blur(12px);
        background: var(--nav-glass);
        border-bottom: 1px solid var(--border);
    }
    
    .logo {
        font-weight: 700;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
    }

    .nav-right {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .download-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-primary);
        opacity: 0.8;
        transition: opacity 0.2s;
    }
    .download-link:hover { opacity: 1; text-decoration: underline; }

    /* Theme Toggle Button */
    .theme-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        border-radius: 50%;
        transition: background 0.2s;
    }
    .theme-btn:hover { background: var(--bg-surface-2); }
    
    /* Logic to show correct icon */
    .sun-icon { display: none; }
    .moon-icon { display: block; }
    
    [data-theme="light"] .sun-icon { display: block; }
    [data-theme="light"] .moon-icon { display: none; }

    /* Hero Section */
    .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding-top: 5rem;
        position: relative;
        overflow: hidden;
    }

    @media (min-width: 1024px) {
        .hero {
            flex-direction: row;
            text-align: left;
            justify-content: space-between;
            gap: 4rem;
        }
    }

    /* Typography */
    .badge-pill {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent);
        margin-bottom: 1.5rem;
        padding: 0.4rem 0.8rem;
        background: var(--bg-surface);
        border-radius: 100px;
        border: 1px solid var(--border);
    }

    .headline {
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0 0 1.5rem 0;
    }
    
    .reveal-text {
        background: linear-gradient(120deg, var(--text-primary), var(--text-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .subheadline {
        font-size: 1.25rem;
        color: var(--text-secondary);
        max-width: 500px;
        margin: 0 auto 2.5rem auto;
    }
    @media (min-width: 1024px) { .subheadline { margin-left: 0; } }

    /* Hero Buttons */
    .cta-row {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        justify-content: center;
    }
    @media (min-width: 1024px) { .cta-row { justify-content: flex-start; } }

    .btn-primary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--text-primary);
        color: var(--bg-main);
        padding: 0.8rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(125,125,125,0.3);
    }

    .btn-text {
        color: var(--text-primary);
        font-weight: 500;
        border-bottom: 1px solid transparent;
        transition: border 0.2s;
    }
    .btn-text:hover { border-bottom-color: var(--text-primary); }

    /* Phone Visuals */
    .hero-visual {
        position: relative;
        perspective: 1000px;
    }

    .phone-frame {
        width: 320px;
        height: 650px;
        background: var(--bg-surface-2);
        border-radius: 48px;
        border: 8px solid #2a2a2a; /* Dark bezel always looks better */
        box-shadow: var(--shadow-soft);
        position: relative;
        overflow: hidden;
        z-index: 1;
        transition: transform 0.5s ease;
    }
    
    [data-theme="light"] .phone-frame {
        border-color: #f1f1f1;
    }

    .phone-screen {
        width: 100%;
        height: 100%;
        background: #000;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }
    
    .phone-notch {
        position: absolute;
        top: 0; left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 25px;
        background: #000;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 16px;
        z-index: 2;
    }

    .glow-backdrop {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 150%; height: 80%;
        background: var(--accent);
        filter: blur(100px);
        opacity: 0.2;
        border-radius: 50%;
        z-index: 0;
        pointer-events: none;
    }

    /* Placeholder UI inside phone */
    .placeholder-ui {
        text-align: center;
        color: white;
    }
    .lock-glyph svg { width: 48px; height: 48px; }
    .time { font-size: 4rem; font-weight: 200; line-height: 1; margin: 1rem 0; }
    .date { font-size: 1rem; color: rgba(255,255,255,0.6); }

    /* Feature Sections */
    .feature-section {
        padding: 8rem 0;
        display: grid;
        gap: 4rem;
        align-items: center;
    }
    
    @media (min-width: 768px) {
        .feature-section { grid-template-columns: 1fr 1fr; }
        .feature-section.centered { grid-template-columns: 1fr; text-align: center; }
    }

    .feature-text h2 {
        font-size: 2.5rem;
        margin: 0 0 1rem 0;
        letter-spacing: -0.02em;
    }
    .feature-text p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        max-width: 45ch;
    }
    .centered .feature-text p { margin: 0 auto; }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
    }

    /* Calculator Grid Mockup */
    .calculator-theme {
        background: #1c1c1c;
        display: flex;
        align-items: flex-end;
        padding-bottom: 2rem;
    }
    .calc-grid-mockup {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        width: 90%;
        margin: 0 auto;
    }
    .calc-grid-mockup span {
        width: 60px; height: 60px;
        background: #333;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }
    .calc-grid-mockup .op { background: #ff9f0a; }
    .calc-grid-mockup .zero { width: auto; grid-column: span 2; border-radius: 30px; }
    
    /* Biometric/Abstract Visual */
    .biometric-visual {
        width: 300px;
        height: 300px;
        margin: 0 auto;
        position: relative;
        background: var(--bg-surface);
        border-radius: 50%;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .fingerprint-scan {
        width: 150px; height: 150px;
        border: 2px solid var(--accent);
        border-radius: 20px;
        position: relative;
    }
    .fingerprint-scan::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 2px;
        background: var(--accent);
        box-shadow: 0 0 10px var(--accent);
        animation: scan 2s infinite ease-in-out;
    }

    @keyframes scan {
        0% { top: 10%; opacity: 0; }
        50% { opacity: 1; }
        100% { top: 90%; opacity: 0; }
    }

    /* Polaroid Stack */
    .feature-content-stacked {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .polaroid-stack {
        position: relative;
        width: 200px;
        height: 240px;
        margin-top: 4rem;
    }
    .polaroid {
        width: 100%; height: 100%;
        background: #fff;
        padding: 10px 10px 40px 10px; /* Polaroid bottom border */
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        position: absolute;
        top: 0; left: 0;
        transition: transform 0.3s;
        border-radius: 2px;
    }
    .polaroid::before {
        content: '';
        display: block;
        width: 100%; height: 100%;
        background: #333;
    }
    
    .p1 { transform: rotate(-10deg) translateX(-20px); z-index: 1; }
    .p2 { transform: rotate(5deg) translateX(20px); z-index: 2; }
    .p3 { transform: rotate(-2deg); z-index: 3; display: flex; align-items: center; justify-content: center; }
    
    .lens-icon {
        width: 50px; height: 50px;
        border-radius: 50%;
        border: 4px solid #555;
        background: #222;
        position: absolute;
    }

    /* Footer */
    .site-footer {
        border-top: 1px solid var(--border);
        padding: 4rem 0 2rem 0;
        margin-top: 4rem;
    }
    .footer-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 3rem;
        margin-bottom: 3rem;
    }
    .col { flex: 1; min-width: 150px; }
    .col h3 { margin: 0 0 1rem 0; font-size: 1.1rem; }
    .col h4 { margin: 0 0 1rem 0; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; }
    .col a { display: block; margin-bottom: 0.5rem; color: var(--text-secondary); transition: color 0.2s; }
    .col a:hover { color: var(--text-primary); }
    
    .footer-bottom {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-secondary);
        padding-top: 2rem;
        border-top: 1px solid var(--border);
    }
</style>
