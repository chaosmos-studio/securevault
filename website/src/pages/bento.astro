---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SecureVault - Premium">
    <main class="bento-wrapper">
        <div class="spotlight-overlay"></div>
        
        <nav class="nav">
            <div class="logo">SecureVault</div>
            <a href="https://play.google.com/store" class="nav-cta">Download App</a>
        </nav>

        <section class="hero">
            <div class="hero-content">
                <span class="badge">v2.0 Now Available</span>
                <h1>Privacy, <br/><span class="text-gradient">reimagined.</span></h1>
                <p class="hero-sub">The world's most advanced secure vault, disguised as a simple calculator. Military-grade encryption meets invisible design.</p>
                <div class="cta-group">
                    <a href="#" class="primary-btn">Get Early Access</a>
                    <a href="#" class="secondary-btn">Watch the film</a>
                </div>
            </div>
            <!-- Placeholder for a high-quality App Screenshot/Mockup -->
            <div class="hero-visual">
                <div class="phone-mockup">
                    <div class="screen">
                        <div class="app-ui">
                            <div class="lock-icon">🔒</div>
                            <div class="code-dots">
                                <span></span><span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bento-grid">
            <div class="card card-wide feature-1">
                <div class="card-content">
                    <h3>Disguise Mode</h3>
                    <p>It looks like a calculator. It works like a calculator. But type your secret PIN, and it reveals your digital fortress.</p>
                </div>
                <div class="card-visual visual-calc">
                    <div class="calc-grid">
                        <div>7</div><div>8</div><div>9</div><div>÷</div>
                        <div>4</div><div>5</div><div>6</div><div>×</div>
                        <div>1</div><div>2</div><div>3</div><div>-</div>
                        <div>0</div><div>.</div><div>=</div><div>+</div>
                    </div>
                </div>
            </div>

            <div class="card feature-2">
                <div class="card-content">
                    <h3>AES-256</h3>
                    <p>Mathematically unbreakable encryption.</p>
                </div>
                <div class="card-visual visual-shield">
                    <div class="shield-icon">🛡️</div>
                </div>
            </div>

            <div class="card feature-3">
                <div class="card-content">
                    <h3>Zero Cloud</h3>
                    <p>Your data never leaves your device.</p>
                </div>
                 <div class="card-visual visual-network">
                    <div class="network-node"></div>
                </div>
            </div>

            <div class="card card-tall feature-4">
                <div class="card-content">
                    <h3>Panic Face</h3>
                    <p>Flip your phone to instantly lock everything and switch to a decoy app.</p>
                </div>
                <div class="card-visual visual-gesture">
                    <div class="phone-rotate">📱</div>
                </div>
            </div>

            <div class="card card-wide feature-5">
                <div class="card-content">
                    <h3>Intruder Selfie</h3>
                    <p>Captures a photo of anyone trying to break into your vault.</p>
                </div>
                <div class="card-visual visual-cam">
                    <div class="camera-lens"></div>
                </div>
            </div>
        </section>

        <footer class="footer">
            <p>© 2026 SecureVault. Crafted for privacy.</p>
        </footer>
    </main>

    <script>
        // Mouse spotlight effect
        const wrapper = document.querySelector('.bento-wrapper') as HTMLElement;
        wrapper.addEventListener('mousemove', (e) => {
            const boxes = document.querySelectorAll('.card, .primary-btn');
            const rect = wrapper.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            wrapper.style.setProperty('--mouse-x', `${x}px`);
            wrapper.style.setProperty('--mouse-y', `${y}px`);

            boxes.forEach((box) => {
                const boxRect = box.getBoundingClientRect();
                const boxX = e.clientX - boxRect.left;
                const boxY = e.clientY - boxRect.top;
                (box as HTMLElement).style.setProperty('--card-mouse-x', `${boxX}px`);
                (box as HTMLElement).style.setProperty('--card-mouse-y', `${boxY}px`);
            });
        });
    </script>
</Layout>

<style>
    /* Reset & Base */
    :root {
        --bg: #050505;
        --card-bg: rgba(255, 255, 255, 0.03);
        --card-border: rgba(255, 255, 255, 0.08);
        --text-main: #ffffff;
        --text-muted: #888888;
        --accent: #3b82f6;
        --glow-color: rgba(59, 130, 246, 0.15);
    }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        overflow-x: hidden;
    }

    .bento-wrapper {
        min-height: 100vh;
        position: relative;
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* Ambient Background Glow */
    .bento-wrapper::before {
        content: '';
        position: fixed;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 50% 50%, rgba(50, 50, 100, 0.1) 0%, transparent 50%);
        pointer-events: none;
        z-index: -1;
    }

    /* Spotlight Overlay (Global mouse tracking) */
    .spotlight-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.04), transparent 40%);
        z-index: 1;
    }

    /* Navigation */
    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        margin-bottom: 4rem;
    }

    .logo {
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
    }

    .nav-cta {
        background: var(--text-main);
        color: var(--bg);
        text-decoration: none;
        padding: 0.6rem 1.2rem;
        border-radius: 2rem;
        font-size: 0.9rem;
        font-weight: 600;
        transition: transform 0.2s;
    }
    .nav-cta:hover { transform: scale(1.05); }

    /* Hero Section */
    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        margin-bottom: 6rem;
    }

    .badge {
        display: inline-block;
        font-size: 0.8rem;
        padding: 0.4rem 0.8rem;
        background: rgba(59, 130, 246, 0.1);
        color: #60a5fa;
        border-radius: 2rem;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(59, 130, 246, 0.2);
    }

    h1 {
        font-size: clamp(3rem, 5vw, 5rem);
        line-height: 1.1;
        margin: 0 0 1.5rem 0;
        letter-spacing: -0.04em;
    }

    .text-gradient {
        background: linear-gradient(to right, #fff, #888);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-sub {
        font-size: 1.2rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 2.5rem;
        max-width: 50ch;
    }

    .cta-group {
        display: flex;
        gap: 1rem;
    }

    .primary-btn {
        background: white;
        color: black;
        padding: 1rem 2rem;
        border-radius: 0.75rem;
        text-decoration: none;
        font-weight: 600;
        position: relative;
        overflow: hidden;
    }

    .secondary-btn {
        padding: 1rem 2rem;
        border-radius: 0.75rem;
        text-decoration: none;
        font-weight: 600;
        color: white;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        transition: background 0.2s;
    }
    .secondary-btn:hover { background: rgba(255,255,255,0.1); }

    /* Phone Mockup */
    .phone-mockup {
        width: 300px;
        height: 600px;
        background: #111;
        border-radius: 40px;
        border: 8px solid #333;
        margin: 0 auto;
        position: relative;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        overflow: hidden;
    }
    .screen {
        width: 100%;
        height: 100%;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .app-ui {
        text-align: center;
        color: #333;
    }
    .lock-icon { font-size: 3rem; margin-bottom: 1rem; color: #444; }
    .code-dots span {
        display: inline-block;
        width: 12px;
        height: 12px;
        background: #333;
        border-radius: 50%;
        margin: 0 4px;
    }

    /* Bento Grid */
    .bento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        grid-auto-rows: 240px;
    }

    /* Card Styles */
    .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 1.5rem;
        padding: 2rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .card:hover {
        border-color: rgba(255,255,255,0.2);
        transform: translateY(-2px);
    }

    /* Inner Card Glow effect on mousemove */
    .card::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 1.5rem;
        padding: 1px; /* Border width */
        background: radial-gradient(
            800px circle at var(--card-mouse-x) var(--card-mouse-y),
            rgba(255, 255, 255, 0.15),
            transparent 40%
        );
        -webkit-mask: 
            linear-gradient(#fff 0 0) content-box, 
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .card-wide { grid-column: span 2; }
    .card-tall { grid-row: span 2; }

    .card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.4rem;
        letter-spacing: -0.02em;
    }
    .card p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.5;
        font-size: 0.95rem;
    }

    /* Visuals inside cards */
    .card-visual {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.8;
        margin-top: 1rem;
    }
    
    .calc-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        width: 100%;
        max-width: 200px;
    }
    .calc-grid div {
        background: rgba(255,255,255,0.1);
        border-radius: 4px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: #555;
    }

    .shield-icon { font-size: 4rem; filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.5)); }

    /* Responsive */
    @media (max-width: 1024px) {
        .hero { grid-template-columns: 1fr; text-align: center; }
        .hero-visual { display: none; } /* Hide phone on smaller screens for simplicity */
        .bento-grid { grid-template-columns: repeat(2, 1fr); }
    }
    
    @media (max-width: 768px) {
        .bento-grid { display: flex; flex-direction: column; }
        .card-wide, .card-tall { grid-column: span 1; grid-row: span 1; }
        h1 { font-size: 2.5rem; }
    }
</style>
