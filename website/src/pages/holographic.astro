---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Ultimate Privacy Protection">
	<div class="holographic-container">
		<canvas id="holoCanvas"></canvas>
		
		<div class="content">
			<div class="hero-section">
				<h1 class="holo-title">
					<span class="word">SECURE</span>
					<span class="word">VAULT</span>
				</h1>
				<p class="tagline">Your Privacy, Perfectly Disguised</p>
				
				<a href="https://play.google.com/store" class="download-btn" target="_blank" rel="noopener noreferrer">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
					</svg>
					Download on Google Play
				</a>
				
				<div class="compatibility">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M17,19H7V5H17M17,1H7C5.89,1 5,1.89 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3C19,1.89 18.1,1 17,1Z"/>
					</svg>
					Android 8.0+
				</div>
			</div>

			<section class="features-grid">
				<h2 class="section-title">Military-Grade Security</h2>
				<div class="grid">
					<div class="feature-card">
						<div class="icon">🔐</div>
						<h3>AES-256 Encryption</h3>
						<p>Bank-level encryption protects your sensitive data</p>
					</div>
					<div class="feature-card">
						<div class="icon">🎭</div>
						<h3>4 Disguises</h3>
						<p>Hide as Calculator, Notes, Clock, or Weather app</p>
					</div>
					<div class="feature-card">
						<div class="icon">🗂️</div>
						<h3>Multi-Vault System</h3>
						<p>Organize secrets in separate encrypted vaults</p>
					</div>
					<div class="feature-card">
						<div class="icon">✈️</div>
						<h3>100% Offline</h3>
						<p>No internet required, no data collection</p>
					</div>
				</div>
			</section>

			<section class="disguises-section">
				<h2 class="section-title">Master of Disguise</h2>
				<div class="disguises-grid">
					<div class="disguise-card">
						<div class="disguise-icon">🧮</div>
						<h3>Calculator</h3>
						<p class="entry-method">Enter: <code>123456=</code></p>
					</div>
					<div class="disguise-card">
						<div class="disguise-icon">📝</div>
						<h3>Notes</h3>
						<p class="entry-method">Long press: <code>+ button</code></p>
					</div>
					<div class="disguise-card">
						<div class="disguise-icon">⏰</div>
						<h3>Clock</h3>
						<p class="entry-method">Tap: <code>12:34:56</code></p>
					</div>
					<div class="disguise-card">
						<div class="disguise-icon">🌤️</div>
						<h3>Weather</h3>
						<p class="entry-method">Pull down 5 times</p>
					</div>
				</div>
			</section>
		</div>
	</div>

	<style is:inline>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		.holographic-container {
			min-height: 100vh;
			background: linear-gradient(135deg, #0a0a0f 0%, #1a0f2e 100%);
			position: relative;
			overflow-x: hidden;
		}

		#holoCanvas {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			z-index: 1;
		}

		.content {
			position: relative;
			z-index: 2;
			padding: 2rem;
			max-width: 1400px;
			margin: 0 auto;
		}

		.hero-section {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			text-align: center;
			padding: 4rem 2rem;
		}

		.holo-title {
			font-size: clamp(3rem, 10vw, 8rem);
			font-weight: 900;
			margin-bottom: 1rem;
			display: flex;
			gap: 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.holo-title .word {
			background: linear-gradient(45deg, #00f5ff, #a445ff, #00f5ff);
			background-size: 200% 200%;
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
			filter: drop-shadow(0 0 20px rgba(0, 245, 255, 0.5));
		}

		.tagline {
			font-size: clamp(1.2rem, 3vw, 2rem);
			color: rgba(255, 255, 255, 0.8);
			margin-bottom: 3rem;
			letter-spacing: 2px;
		}

		.download-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.75rem;
			padding: 1.25rem 2.5rem;
			background: linear-gradient(135deg, #00f5ff 0%, #a445ff 100%);
			color: white;
			text-decoration: none;
			border-radius: 50px;
			font-size: 1.1rem;
			font-weight: 700;
			transition: all 0.3s ease;
			box-shadow: 0 10px 40px rgba(0, 245, 255, 0.3);
			margin-bottom: 1.5rem;
		}

		.download-btn:hover {
			transform: translateY(-2px);
			box-shadow: 0 15px 50px rgba(0, 245, 255, 0.5);
		}

		.compatibility {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			color: rgba(255, 255, 255, 0.6);
			font-size: 0.9rem;
		}

		.section-title {
			font-size: clamp(2rem, 5vw, 3.5rem);
			text-align: center;
			margin-bottom: 3rem;
			background: linear-gradient(45deg, #00f5ff, #ffffff);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.features-grid {
			padding: 6rem 0;
			opacity: 0;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}

		.feature-card {
			background: rgba(255, 255, 255, 0.03);
			backdrop-filter: blur(10px);
			border: 1px solid rgba(0, 245, 255, 0.2);
			border-radius: 20px;
			padding: 2.5rem;
			text-align: center;
			transition: all 0.3s ease;
		}

		.feature-card:hover {
			transform: translateY(-5px);
			border-color: rgba(0, 245, 255, 0.5);
			box-shadow: 0 15px 40px rgba(0, 245, 255, 0.2);
		}

		.feature-card .icon {
			font-size: 3rem;
			margin-bottom: 1rem;
		}

		.feature-card h3 {
			color: #00f5ff;
			font-size: 1.5rem;
			margin-bottom: 1rem;
		}

		.feature-card p {
			color: rgba(255, 255, 255, 0.7);
			line-height: 1.6;
		}

		.disguises-section {
			padding: 6rem 0;
			opacity: 0;
		}

		.disguises-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 2rem;
		}

		.disguise-card {
			background: rgba(164, 69, 255, 0.05);
			backdrop-filter: blur(10px);
			border: 1px solid rgba(164, 69, 255, 0.3);
			border-radius: 15px;
			padding: 2rem;
			text-align: center;
			transition: all 0.3s ease;
		}

		.disguise-card:hover {
			transform: translateY(-5px);
			border-color: rgba(164, 69, 255, 0.6);
			box-shadow: 0 15px 40px rgba(164, 69, 255, 0.2);
		}

		.disguise-icon {
			font-size: 4rem;
			margin-bottom: 1rem;
		}

		.disguise-card h3 {
			color: #a445ff;
			font-size: 1.8rem;
			margin-bottom: 1rem;
		}

		.entry-method {
			color: rgba(255, 255, 255, 0.6);
			font-size: 0.9rem;
		}

		.entry-method code {
			background: rgba(0, 245, 255, 0.1);
			padding: 0.3rem 0.6rem;
			border-radius: 5px;
			color: #00f5ff;
			font-family: 'Courier New', monospace;
		}

		@media (max-width: 768px) {
			.holo-title {
				flex-direction: column;
				gap: 0.5rem;
			}
		}
	</style>

	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';
		import { ScrollTrigger } from 'gsap/ScrollTrigger';

		gsap.registerPlugin(ScrollTrigger);

		// Three.js Holographic Shield Setup
		const canvas = document.getElementById('holoCanvas') as HTMLCanvasElement;
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		
		renderer.setSize(window.innerWidth, window.innerHeight);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		camera.position.z = 5;

		// Create holographic shield
		const shieldGeometry = new THREE.IcosahedronGeometry(2, 1);
		const shieldMaterial = new THREE.MeshBasicMaterial({
			color: 0x00f5ff,
			wireframe: true,
			transparent: true,
			opacity: 0.3
		});
		const shield = new THREE.Mesh(shieldGeometry, shieldMaterial);
		scene.add(shield);

		// Inner glow sphere
		const glowGeometry = new THREE.SphereGeometry(1.8, 32, 32);
		const glowMaterial = new THREE.MeshBasicMaterial({
			color: 0xa445ff,
			transparent: true,
			opacity: 0.15,
			side: THREE.BackSide
		});
		const glow = new THREE.Mesh(glowGeometry, glowMaterial);
		scene.add(glow);

		// Particles
		const particlesGeometry = new THREE.BufferGeometry();
		const particlesCount = 1000;
		const positions = new Float32Array(particlesCount * 3);
		
		for (let i = 0; i < particlesCount * 3; i++) {
			positions[i] = (Math.random() - 0.5) * 15;
		}
		
		particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
		const particlesMaterial = new THREE.PointsMaterial({
			color: 0x00f5ff,
			size: 0.02,
			transparent: true,
			opacity: 0.6,
			blending: THREE.AdditiveBlending
		});
		const particles = new THREE.Points(particlesGeometry, particlesMaterial);
		scene.add(particles);

		// Orbiting rings
		const rings: THREE.Mesh[] = [];
		for (let i = 0; i < 3; i++) {
			const ringGeometry = new THREE.TorusGeometry(2.5 + i * 0.3, 0.02, 16, 100);
			const ringMaterial = new THREE.MeshBasicMaterial({
				color: i % 2 === 0 ? 0x00f5ff : 0xa445ff,
				transparent: true,
				opacity: 0.4
			});
			const ring = new THREE.Mesh(ringGeometry, ringMaterial);
			ring.rotation.x = Math.random() * Math.PI;
			ring.rotation.y = Math.random() * Math.PI;
			rings.push(ring);
			scene.add(ring);
		}

		// Mouse interaction
		let mouseX = 0;
		let mouseY = 0;
		
		document.addEventListener('mousemove', (event) => {
			mouseX = (event.clientX / window.innerWidth) * 2 - 1;
			mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
		});

		// GSAP Animations
		gsap.to('.holo-title .word', {
			backgroundPosition: '200% center',
			duration: 3,
			ease: 'none',
			repeat: -1
		});

		gsap.to('.download-btn', {
			scale: 1.05,
			duration: 1.5,
			ease: 'power1.inOut',
			repeat: -1,
			yoyo: true
		});

		// Scroll-triggered animations
		gsap.to('.features-grid', {
			scrollTrigger: {
				trigger: '.features-grid',
				start: 'top 80%',
				end: 'bottom 20%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			y: 0,
			duration: 1
		});

		gsap.to('.disguises-section', {
			scrollTrigger: {
				trigger: '.disguises-section',
				start: 'top 80%',
				toggleActions: 'play none none reverse'
			},
			opacity: 1,
			y: 0,
			duration: 1
		});

		// Animate cards
		gsap.utils.toArray('.feature-card').forEach((card, i) => {
			gsap.from(card as HTMLElement, {
				scrollTrigger: {
					trigger: card as HTMLElement,
					start: 'top 90%'
				},
				y: 50,
				opacity: 0,
				duration: 0.8,
				delay: i * 0.1
			});
		});

		gsap.utils.toArray('.disguise-card').forEach((card, i) => {
			gsap.from(card as HTMLElement, {
				scrollTrigger: {
					trigger: card as HTMLElement,
					start: 'top 90%'
				},
				scale: 0.8,
				opacity: 0,
				duration: 0.6,
				delay: i * 0.1
			});
		});

		// Animation loop
		let scrollY = 0;
		
		function animate() {
			requestAnimationFrame(animate);
			
			scrollY = window.scrollY;
			
			// Rotate shield
			shield.rotation.x += 0.002;
			shield.rotation.y += 0.003;
			
			// Pulse glow
			glow.scale.x = glow.scale.y = glow.scale.z = 1 + Math.sin(Date.now() * 0.001) * 0.1;
			
			// Rotate particles
			particles.rotation.y += 0.0005;
			
			// Rotate rings
			rings.forEach((ring, i) => {
				ring.rotation.x += 0.001 * (i + 1);
				ring.rotation.y += 0.002 * (i + 1);
			});
			
			// Mouse interaction
			camera.position.x += (mouseX * 0.5 - camera.position.x) * 0.05;
			camera.position.y += (mouseY * 0.5 - camera.position.y) * 0.05;
			camera.lookAt(scene.position);
			
			// Scroll effect
			shield.position.y = scrollY * 0.0005;
			
			renderer.render(scene, camera);
		}
		
		animate();

		// Resize handler
		window.addEventListener('resize', () => {
			camera.aspect = window.innerWidth / window.innerHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(window.innerWidth, window.innerHeight);
		});
	</script>
</Layout>
