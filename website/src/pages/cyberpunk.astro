---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Cyberpunk Edition">
	<div class="back-nav">
		<a href="/SecureVault/">← Back</a>
	</div>

	<div class="cyberpunk">
		<div class="scan-line"></div>
		<div class="grid-bg"></div>
		
		<section class="hero-cyber">
			<div class="container">
				<div class="glitch-wrapper">
					<h1 class="glitch" data-text="SECUREVAULT">SECUREVAULT</h1>
				</div>
				<p class="cyber-tagline">
					<span class="bracket">[</span>
					PRIVACY.EXE : ACTIVATED
					<span class="bracket">]</span>
				</p>
				<div class="terminal-box">
					<div class="terminal-header">
						<span class="dot red"></span>
						<span class="dot yellow"></span>
						<span class="dot green"></span>
					</div>
					<div class="terminal-content">
						<p><span class="prompt">$</span> initializing encryption...</p>
						<p><span class="prompt">$</span> AES-256 active</p>
						<p><span class="prompt">$</span> disguise mode: READY</p>
						<p class="cursor-line"><span class="prompt">$</span> status: <span class="success">PROTECTED</span>_</p>
					</div>
				</div>
			</div>
		</section>

		<section class="disguises-cyber">
			<div class="container">
				<h2 class="section-title">
					<span class="bracket">&lt;</span>
					DISGUISE PROTOCOLS
					<span class="bracket">/&gt;</span>
				</h2>
				
				<div class="cyber-grid">
					<div class="cyber-card">
						<div class="card-header">
							<span class="status-dot"></span>
							<span class="protocol">PROTOCOL_01</span>
						</div>
						<div class="card-icon">🧮</div>
						<h3>CALCULATOR</h3>
						<div class="card-detail">
							<span class="label">ENTRY:</span> CODE + [=]
						</div>
						<div class="card-detail">
							<span class="label">STATUS:</span> <span class="active">ACTIVE</span>
						</div>
						<div class="neon-border"></div>
					</div>

					<div class="cyber-card">
						<div class="card-header">
							<span class="status-dot"></span>
							<span class="protocol">PROTOCOL_02</span>
						</div>
						<div class="card-icon">📝</div>
						<h3>NOTES</h3>
						<div class="card-detail">
							<span class="label">ENTRY:</span> TAP_TITLE × 5
						</div>
						<div class="card-detail">
							<span class="label">STATUS:</span> <span class="active">ACTIVE</span>
						</div>
						<div class="neon-border"></div>
					</div>

					<div class="cyber-card">
						<div class="card-header">
							<span class="status-dot"></span>
							<span class="protocol">PROTOCOL_03</span>
						</div>
						<div class="card-icon">🕐</div>
						<h3>CLOCK</h3>
						<div class="card-detail">
							<span class="label">ENTRY:</span> TIME_AS_CODE
						</div>
						<div class="card-detail">
							<span class="label">STATUS:</span> <span class="active">ACTIVE</span>
						</div>
						<div class="neon-border"></div>
					</div>

					<div class="cyber-card">
						<div class="card-header">
							<span class="status-dot"></span>
							<span class="protocol">PROTOCOL_04</span>
						</div>
						<div class="card-icon">🌤️</div>
						<h3>WEATHER</h3>
						<div class="card-detail">
							<span class="label">ENTRY:</span> SETTINGS × 7
						</div>
						<div class="card-detail">
							<span class="label">STATUS:</span> <span class="active">ACTIVE</span>
						</div>
						<div class="neon-border"></div>
					</div>
				</div>
			</div>
		</section>

		<section class="specs-cyber">
			<div class="container">
				<h2 class="section-title">
					<span class="bracket">&lt;</span>
					SECURITY SPECS
					<span class="bracket">/&gt;</span>
				</h2>
				
				<div class="specs-grid">
					<div class="spec-item">
						<div class="spec-icon">⚡</div>
						<div class="spec-info">
							<h3>ENCRYPTION</h3>
							<p class="spec-value">AES-256-CBC</p>
							<p class="spec-desc">Military-grade cipher</p>
						</div>
					</div>
					<div class="spec-item">
						<div class="spec-icon">🗂️</div>
						<div class="spec-info">
							<h3>MULTI-VAULT</h3>
							<p class="spec-value">Unlimited</p>
							<p class="spec-desc">Separate encrypted containers</p>
						</div>
					</div>
					<div class="spec-item">
						<div class="spec-icon">🔐</div>
						<div class="spec-info">
							<h3>KEY DERIVATION</h3>
							<p class="spec-value">PBKDF2</p>
							<p class="spec-desc">100,000 iterations</p>
						</div>
					</div>
					<div class="spec-item">
						<div class="spec-icon">📵</div>
						<div class="spec-info">
							<h3>NETWORK</h3>
							<p class="spec-value">OFFLINE</p>
							<p class="spec-desc">Zero cloud dependency</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="download-cyber">
			<div class="container">
				<div class="download-box">
					<h2>INITIALIZE DOWNLOAD</h2>
					<div class="download-info">
						<div class="info-row">
							<span class="label">PLATFORM:</span>
							<span class="value">ANDROID</span>
						</div>
						<div class="info-row">
							<span class="label">VERSION:</span>
							<span class="value">1.0.0</span>
						</div>
						<div class="info-row">
							<span class="label">SIZE:</span>
							<span class="value">50.5 MB</span>
						</div>
						<div class="info-row">
							<span class="label">COMPATIBILITY:</span>
							<span class="value">ANDROID 8.0+</span>
						</div>
					</div>
					<a href="https://play.google.com/store" target="_blank" class="cyber-btn">
						<svg viewBox="0 0 24 24" width="24" height="24" style="margin-right: 1rem;">
							<path fill="currentColor" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
						</svg>
						<span class="btn-text">GOOGLE.PLAY</span>
						<span class="btn-arrow">→→→</span>
					</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.back-nav {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 1000;
	}

	.back-nav a {
		color: #0ff;
		text-decoration: none;
		background: rgba(0, 0, 0, 0.8);
		padding: 0.75rem 1.25rem;
		border-radius: 0.25rem;
		border: 1px solid #0ff;
		font-family: 'Courier New', monospace;
		transition: all 0.3s ease;
	}

	.back-nav a:hover {
		background: rgba(0, 255, 255, 0.1);
		box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
	}

	.cyberpunk {
		background: #0a0a0f;
		color: #0ff;
		font-family: 'Courier New', monospace;
		position: relative;
		overflow: hidden;
	}

	.scan-line {
		position: fixed;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, transparent, #0ff, transparent);
		animation: scan 8s linear infinite;
		z-index: 1;
		opacity: 0.3;
	}

	@keyframes scan {
		0% { top: 0; }
		100% { top: 100%; }
	}

	.grid-bg {
		position: fixed;
		width: 100%;
		height: 100%;
		background-image: 
			linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 50px 50px;
		z-index: 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
		position: relative;
		z-index: 2;
	}

	.hero-cyber {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.glitch-wrapper {
		margin-bottom: 2rem;
	}

	.glitch {
		font-size: 5rem;
		font-weight: 900;
		text-align: center;
		position: relative;
		letter-spacing: 0.5rem;
		animation: glitch 1s infinite;
	}

	@keyframes glitch {
		0%, 100% { text-shadow: 0.05em 0 0 #f0f, -0.05em -0.025em 0 #0ff; }
		14% { text-shadow: 0.05em 0 0 #f0f, -0.05em -0.025em 0 #0ff; }
		15% { text-shadow: -0.05em -0.025em 0 #f0f, 0.05em 0.025em 0 #0ff; }
		49% { text-shadow: -0.05em -0.025em 0 #f0f, 0.05em 0.025em 0 #0ff; }
		50% { text-shadow: 0.025em 0.05em 0 #f0f, 0.05em 0 0 #0ff; }
		99% { text-shadow: 0.025em 0.05em 0 #f0f, 0.05em 0 0 #0ff; }
	}

	.cyber-tagline {
		font-size: 1.5rem;
		text-align: center;
		margin-bottom: 3rem;
		color: #f0f;
	}

	.bracket {
		color: #0ff;
		font-weight: bold;
	}

	.terminal-box {
		max-width: 600px;
		margin: 0 auto;
		background: rgba(0, 0, 0, 0.8);
		border: 2px solid #0ff;
		border-radius: 0.5rem;
		box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
	}

	.terminal-header {
		background: #1a1a1f;
		padding: 0.75rem;
		border-bottom: 1px solid #0ff;
		display: flex;
		gap: 0.5rem;
	}

	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.dot.red { background: #ff5f56; }
	.dot.yellow { background: #ffbd2e; }
	.dot.green { background: #27c93f; }

	.terminal-content {
		padding: 1.5rem;
		font-size: 1rem;
		line-height: 1.8;
	}

	.prompt {
		color: #0ff;
		margin-right: 0.5rem;
	}

	.success {
		color: #0f0;
	}

	.cursor-line {
		animation: blink 1s infinite;
	}

	@keyframes blink {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}

	.disguises-cyber {
		padding: 6rem 0;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 4rem;
		letter-spacing: 0.2rem;
	}

	.cyber-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.cyber-card {
		background: rgba(0, 0, 0, 0.6);
		border: 1px solid #0ff;
		padding: 2rem;
		position: relative;
		transition: all 0.3s ease;
	}

	.cyber-card:hover {
		background: rgba(0, 255, 255, 0.05);
		box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
	}

	.neon-border {
		position: absolute;
		inset: 0;
		border: 2px solid transparent;
		pointer-events: none;
	}

	.cyber-card:hover .neon-border {
		border-color: #f0f;
		animation: neon-pulse 1.5s infinite;
	}

	@keyframes neon-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 1rem;
		font-size: 0.75rem;
		color: #666;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		background: #0f0;
		border-radius: 50%;
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.3; }
	}

	.card-icon {
		font-size: 3rem;
		text-align: center;
		margin-bottom: 1rem;
		filter: drop-shadow(0 0 10px #0ff);
	}

	.cyber-card h3 {
		font-size: 1.5rem;
		text-align: center;
		margin-bottom: 1.5rem;
		color: #0ff;
	}

	.card-detail {
		margin-bottom: 0.75rem;
		font-size: 0.9rem;
	}

	.label {
		color: #666;
		margin-right: 0.5rem;
	}

	.active {
		color: #0f0;
	}

	.specs-cyber {
		padding: 6rem 0;
		background: rgba(0, 0, 0, 0.3);
	}

	.specs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}

	.spec-item {
		display: flex;
		gap: 1.5rem;
		padding: 2rem;
		background: rgba(0, 0, 0, 0.6);
		border-left: 3px solid #0ff;
		transition: all 0.3s ease;
	}

	.spec-item:hover {
		border-left-color: #f0f;
		background: rgba(255, 0, 255, 0.05);
	}

	.spec-icon {
		font-size: 2.5rem;
	}

	.spec-info h3 {
		font-size: 1rem;
		color: #0ff;
		margin-bottom: 0.5rem;
	}

	.spec-value {
		font-size: 1.25rem;
		color: #f0f;
		margin-bottom: 0.25rem;
	}

	.spec-desc {
		font-size: 0.85rem;
		color: #666;
	}

	.download-cyber {
		padding: 6rem 0;
	}

	.download-box {
		max-width: 600px;
		margin: 0 auto;
		background: rgba(0, 0, 0, 0.8);
		border: 2px solid #0ff;
		padding: 3rem;
		text-align: center;
		box-shadow: 0 0 40px rgba(0, 255, 255, 0.3);
	}

	.download-box h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		letter-spacing: 0.2rem;
	}

	.download-info {
		margin-bottom: 2rem;
	}

	.info-row {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 0;
		border-bottom: 1px solid rgba(0, 255, 255, 0.2);
	}

	.info-row .label {
		color: #666;
	}

	.info-row .value {
		color: #0ff;
		font-weight: bold;
	}

	.cyber-btn {
		width: 100%;
		background: transparent;
		border: 2px solid #0ff;
		color: #0ff;
		padding: 1.25rem 2rem;
		font-size: 1.25rem;
		font-family: 'Courier New', monospace;
		cursor: pointer;
		position: relative;
		overflow: hidden;
		transition: all 0.3s ease;
		text-decoration: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cyber-btn::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: rgba(0, 255, 255, 0.1);
		transition: left 0.3s ease;
	}

	.cyber-btn:hover::before {
		left: 0;
	}

	.cyber-btn:hover {
		box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
		color: #fff;
	}

	.btn-text, .btn-arrow {
		position: relative;
		z-index: 1;
	}

	.btn-arrow {
		margin-left: 1rem;
		display: inline-block;
		transition: transform 0.3s ease;
	}

	.cyber-btn:hover .btn-arrow {
		transform: translateX(5px);
	}

	@media (max-width: 768px) {
		.glitch {
			font-size: 2.5rem;
		}
		.cyber-grid, .specs-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
