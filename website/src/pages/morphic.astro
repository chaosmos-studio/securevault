---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SecureVault - Morphic Flow">
	<div class="back-nav">
		<a href="/SecureVault/">← Back</a>
	</div>

	<div class="morphic">
		<div class="blob blob-1"></div>
		<div class="blob blob-2"></div>
		<div class="blob blob-3"></div>

		<section class="hero-morphic">
			<div class="container">
				<div class="hero-content">
					<h1 class="morphic-title">
						<span class="char" data-char="S">S</span>
						<span class="char" data-char="E">E</span>
						<span class="char" data-char="C">C</span>
						<span class="char" data-char="U">U</span>
						<span class="char" data-char="R">R</span>
						<span class="char" data-char="E">E</span>
						<span class="space"></span>
						<span class="char" data-char="V">V</span>
						<span class="char" data-char="A">A</span>
						<span class="char" data-char="U">U</span>
						<span class="char" data-char="L">L</span>
						<span class="char" data-char="T">T</span>
					</h1>
					<p class="morphic-subtitle">
						Privacy that adapts to your life.<br/>
						Like water, impossible to grasp.
					</p>
					<div class="cta-buttons">
						<a href="https://play.google.com/store" target="_blank" class="primary-btn">
							<svg viewBox="0 0 24 24" width="28" height="28">
								<path fill="currentColor" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
							</svg>
							Download Now
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="disguises-morphic">
			<div class="container">
				<h2 class="section-title">Four Faces, One Secret</h2>
				<div class="disguises-container">
					<div class="disguise-morph" data-disguise="calculator">
						<div class="morph-bg"></div>
						<div class="morph-content">
							<div class="morph-icon">🧮</div>
							<h3>Calculator</h3>
							<div class="morph-divider"></div>
							<p class="unlock-method">Enter code + [=]</p>
							<p class="description">A real calculator that actually works. Your vault unlocks when you type the right equation.</p>
						</div>
					</div>

					<div class="disguise-morph" data-disguise="notes">
						<div class="morph-bg"></div>
						<div class="morph-content">
							<div class="morph-icon">📝</div>
							<h3>Notes</h3>
							<div class="morph-divider"></div>
							<p class="unlock-method">Tap title 5 times</p>
							<p class="description">Take notes like normal. Five rapid taps on the title reveals your hidden world.</p>
						</div>
					</div>

					<div class="disguise-morph" data-disguise="clock">
						<div class="morph-bg"></div>
						<div class="morph-content">
							<div class="morph-icon">🕐</div>
							<h3>Clock</h3>
							<div class="morph-divider"></div>
							<p class="unlock-method">Set time as code</p>
							<p class="description">Shows the time. Set an alarm with your passcode as the time to unlock (1234 = 12:34).</p>
						</div>
					</div>

					<div class="disguise-morph" data-disguise="weather">
						<div class="morph-bg"></div>
						<div class="morph-content">
							<div class="morph-icon">🌤️</div>
							<h3>Weather</h3>
							<div class="morph-divider"></div>
							<p class="unlock-method">Tap settings 7x</p>
							<p class="description">Check the forecast. Seven taps on settings icon opens the vault portal.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="security-morphic">
			<div class="container">
				<div class="security-layout">
					<div class="security-visual">
						<div class="shield-container">
							<div class="shield-layer layer-1"></div>
							<div class="shield-layer layer-2"></div>
							<div class="shield-layer layer-3"></div>
							<div class="shield-core">🔒</div>
						</div>
					</div>
					<div class="security-content">
						<h2>Unbreakable Security</h2>
						<div class="security-features">
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>AES-256 Encryption</h4>
									<p>Military-grade cipher with PBKDF2 key derivation</p>
								</div>
							</div>
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>Infinite Vaults</h4>
									<p>Create unlimited vaults, each with unique passwords</p>
								</div>
							</div>
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>Offline First</h4>
									<p>Zero network access, all data stays on your device</p>
								</div>
							</div>
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>Auto-Lock</h4>
									<p>Instant lock when you switch apps or lock screen</p>
								</div>
							</div>
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>Screenshot Protection</h4>
									<p>Blocks screen recording and screenshots in vault</p>
								</div>
							</div>
							<div class="security-item">
								<div class="security-bullet"></div>
								<div>
									<h4>Zero Knowledge</h4>
									<p>We never see your password or access your files</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="features-flow">
			<div class="container">
				<h2 class="section-title">Seamless Privacy</h2>
				<div class="flow-cards">
					<div class="flow-card">
						<div class="flow-number">01</div>
						<div class="flow-icon">📷</div>
						<h3>Photos & Videos</h3>
						<p>Import from gallery or capture directly. All encrypted automatically with AES-256.</p>
					</div>
					<div class="flow-card">
						<div class="flow-number">02</div>
						<div class="flow-icon">📱</div>
						<h3>Dynamic Disguise</h3>
						<p>App icon and name change to match your selected disguise. Completely invisible.</p>
					</div>
					<div class="flow-card">
						<div class="flow-number">03</div>
						<div class="flow-icon">🔐</div>
						<h3>Decoy Passwords</h3>
						<p>Set different passwords to show different content. Perfect for forced unlock scenarios.</p>
					</div>
					<div class="flow-card">
						<div class="flow-number">04</div>
						<div class="flow-icon">⚡</div>
						<h3>Instant Access</h3>
						<p>No lag, no delays. Your vault opens instantly with the correct authentication.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="download-morphic">
			<div class="container">
				<div class="download-box">
					<h2>Join the Privacy Revolution</h2>
					<p>Take back control of your digital life. Download SecureVault today.</p>
					<a href="https://play.google.com/store" target="_blank" class="morphic-download-btn">
						<div class="btn-glow"></div>
						<svg viewBox="0 0 24 24" width="32" height="32">
							<path fill="currentColor" d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
						</svg>
						<div class="btn-text">
							<span class="btn-label">GET IT ON</span>
							<span class="btn-store">Google Play</span>
						</div>
					</a>
					<div class="app-specs">
						<span class="spec">v1.0.0</span>
						<span class="dot">•</span>
						<span class="spec">50.5 MB</span>
						<span class="dot">•</span>
						<span class="spec">Android 8.0+</span>
						<span class="dot">•</span>
						<span class="spec">Free Forever</span>
					</div>
				</div>
			</div>
		</section>

		<footer class="morphic-footer">
			<div class="container">
				<p>© 2026 SecureVault • Your privacy, your rules</p>
			</div>
		</footer>
	</div>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Animate blobs
	gsap.to('.blob-1', {
		x: '100vw',
		y: '-50vh',
		duration: 20,
		repeat: -1,
		yoyo: true,
		ease: 'sine.inOut',
	});

	gsap.to('.blob-2', {
		x: '-50vw',
		y: '100vh',
		duration: 25,
		repeat: -1,
		yoyo: true,
		ease: 'sine.inOut',
	});

	gsap.to('.blob-3', {
		x: '80vw',
		y: '80vh',
		duration: 30,
		repeat: -1,
		yoyo: true,
		ease: 'sine.inOut',
	});

	// Character animation
	gsap.from('.char', {
		opacity: 0,
		y: 100,
		rotationX: -90,
		stagger: 0.05,
		duration: 1,
		ease: 'back.out(1.7)',
	});

	gsap.from('.morphic-subtitle', {
		opacity: 0,
		y: 30,
		duration: 1,
		delay: 0.6,
	});

	gsap.from('.cta-buttons', {
		opacity: 0,
		y: 30,
		duration: 1,
		delay: 0.9,
	});

	// Disguise cards
	gsap.utils.toArray('.disguise-morph').forEach((card: any, i) => {
		gsap.from(card, {
			scrollTrigger: {
				trigger: card,
				start: 'top 80%',
			},
			opacity: 0,
			scale: 0.8,
			rotationY: 45,
			duration: 1,
			delay: i * 0.15,
		});

		// Hover animation
		card.addEventListener('mouseenter', () => {
			gsap.to(card.querySelector('.morph-bg'), {
				scale: 1.1,
				duration: 0.3,
			});
		});

		card.addEventListener('mouseleave', () => {
			gsap.to(card.querySelector('.morph-bg'), {
				scale: 1,
				duration: 0.3,
			});
		});
	});

	// Shield layers rotation
	gsap.to('.layer-1', {
		rotation: 360,
		duration: 20,
		repeat: -1,
		ease: 'none',
	});

	gsap.to('.layer-2', {
		rotation: -360,
		duration: 15,
		repeat: -1,
		ease: 'none',
	});

	gsap.to('.layer-3', {
		rotation: 360,
		duration: 25,
		repeat: -1,
		ease: 'none',
	});

	// Security items
	gsap.utils.toArray('.security-item').forEach((item: any, i) => {
		gsap.from(item, {
			scrollTrigger: {
				trigger: item,
				start: 'top 85%',
			},
			opacity: 0,
			x: -50,
			duration: 0.8,
			delay: i * 0.1,
		});
	});

	// Flow cards
	gsap.utils.toArray('.flow-card').forEach((card: any, i) => {
		gsap.from(card, {
			scrollTrigger: {
				trigger: card,
				start: 'top 80%',
			},
			opacity: 0,
			y: 50,
			duration: 0.8,
			delay: i * 0.1,
		});
	});

	// Download box
	gsap.from('.download-box', {
		scrollTrigger: {
			trigger: '.download-box',
			start: 'top 80%',
		},
		opacity: 0,
		scale: 0.9,
		duration: 1,
	});

	// Button glow animation
	gsap.to('.btn-glow', {
		scale: 1.2,
		opacity: 0,
		duration: 2,
		repeat: -1,
		ease: 'power1.out',
	});
</script>

<style>
	.back-nav {
		position: fixed;
		top: 1.5rem;
		left: 1.5rem;
		z-index: 1001;
	}

	.back-nav a {
		color: white;
		text-decoration: none;
		background: rgba(0, 0, 0, 0.3);
		padding: 0.75rem 1.5rem;
		border-radius: 2rem;
		backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition: all 0.3s ease;
	}

	.back-nav a:hover {
		background: rgba(0, 0, 0, 0.5);
		border-color: rgba(102, 126, 234, 0.5);
	}

	.morphic {
		background: #0f0f1e;
		color: white;
		position: relative;
		overflow: hidden;
	}

	.blob {
		position: fixed;
		width: 600px;
		height: 600px;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.3;
		z-index: 0;
	}

	.blob-1 {
		background: radial-gradient(circle, #667eea 0%, transparent 70%);
		top: -200px;
		left: -200px;
	}

	.blob-2 {
		background: radial-gradient(circle, #764ba2 0%, transparent 70%);
		bottom: -200px;
		right: -200px;
	}

	.blob-3 {
		background: radial-gradient(circle, #f093fb 0%, transparent 70%);
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
		position: relative;
		z-index: 1;
	}

	.hero-morphic {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-content {
		text-align: center;
	}

	.morphic-title {
		font-size: 7rem;
		font-weight: 900;
		margin-bottom: 2rem;
		line-height: 1;
		perspective: 1000px;
	}

	.char {
		display: inline-block;
		background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.space {
		display: inline-block;
		width: 2rem;
	}

	.morphic-subtitle {
		font-size: 1.75rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 3rem;
		line-height: 1.6;
	}

	.cta-buttons {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}

	.primary-btn {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		background: linear-gradient(135deg, #667eea, #764ba2);
		color: white;
		padding: 1.25rem 2.5rem;
		border-radius: 3rem;
		text-decoration: none;
		font-size: 1.25rem;
		font-weight: 600;
		transition: all 0.3s ease;
		box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
	}

	.primary-btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 15px 50px rgba(102, 126, 234, 0.6);
	}

	.disguises-morphic {
		padding: 8rem 0;
	}

	.section-title {
		font-size: 3.5rem;
		text-align: center;
		margin-bottom: 5rem;
		font-weight: 700;
		background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.disguises-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.disguise-morph {
		position: relative;
		padding: 2.5rem;
		border-radius: 2rem;
		overflow: hidden;
		backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		transition: all 0.3s ease;
	}

	.disguise-morph:hover {
		border-color: rgba(102, 126, 234, 0.5);
		transform: translateY(-5px);
	}

	.morph-bg {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
		transition: all 0.3s ease;
	}

	.morph-content {
		position: relative;
		z-index: 1;
	}

	.morph-icon {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		filter: drop-shadow(0 0 20px rgba(102, 126, 234, 0.5));
	}

	.disguise-morph h3 {
		font-size: 1.75rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.morph-divider {
		width: 60px;
		height: 3px;
		background: linear-gradient(90deg, #667eea, #764ba2);
		margin: 1.5rem 0;
		border-radius: 2px;
	}

	.unlock-method {
		color: #667eea;
		font-weight: 600;
		margin-bottom: 1rem;
		font-size: 1.1rem;
	}

	.description {
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.6;
	}

	.security-morphic {
		padding: 8rem 0;
		background: rgba(0, 0, 0, 0.3);
	}

	.security-layout {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		gap: 4rem;
		align-items: center;
	}

	.shield-container {
		position: relative;
		width: 300px;
		height: 300px;
		margin: 0 auto;
	}

	.shield-layer {
		position: absolute;
		inset: 0;
		border: 2px solid;
		border-radius: 50%;
		opacity: 0.3;
	}

	.layer-1 {
		border-color: #667eea;
	}

	.layer-2 {
		border-color: #764ba2;
		inset: 20px;
	}

	.layer-3 {
		border-color: #f093fb;
		inset: 40px;
	}

	.shield-core {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 6rem;
		filter: drop-shadow(0 0 30px rgba(102, 126, 234, 0.5));
	}

	.security-content h2 {
		font-size: 3rem;
		margin-bottom: 3rem;
		font-weight: 700;
	}

	.security-features {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.security-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.security-bullet {
		width: 12px;
		height: 12px;
		background: linear-gradient(135deg, #667eea, #764ba2);
		border-radius: 50%;
		margin-top: 0.5rem;
		flex-shrink: 0;
	}

	.security-item h4 {
		font-size: 1.25rem;
		margin-bottom: 0.5rem;
		font-weight: 600;
	}

	.security-item p {
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.5;
	}

	.features-flow {
		padding: 8rem 0;
	}

	.flow-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
	}

	.flow-card {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 2.5rem;
		border-radius: 1.5rem;
		position: relative;
		transition: all 0.3s ease;
	}

	.flow-card:hover {
		border-color: rgba(102, 126, 234, 0.5);
		transform: translateY(-5px);
	}

	.flow-number {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		font-size: 3rem;
		font-weight: 900;
		color: rgba(255, 255, 255, 0.05);
	}

	.flow-icon {
		font-size: 3rem;
		margin-bottom: 1.5rem;
	}

	.flow-card h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.flow-card p {
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.6;
	}

	.download-morphic {
		padding: 8rem 0;
	}

	.download-box {
		max-width: 700px;
		margin: 0 auto;
		text-align: center;
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: 4rem;
		border-radius: 2rem;
	}

	.download-box h2 {
		font-size: 3rem;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}

	.download-box > p {
		font-size: 1.25rem;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 3rem;
	}

	.morphic-download-btn {
		display: inline-flex;
		align-items: center;
		gap: 1.5rem;
		background: linear-gradient(135deg, #667eea, #764ba2);
		padding: 1.5rem 3rem;
		border-radius: 1.5rem;
		text-decoration: none;
		color: white;
		position: relative;
		overflow: hidden;
		transition: all 0.3s ease;
		box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
	}

